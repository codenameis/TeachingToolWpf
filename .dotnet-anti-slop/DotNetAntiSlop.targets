<Project>
  <ItemGroup Condition="'$(IsDotNetAntiSlopAnalyzerProject)' != 'true'">
    <ProjectReference
      Include="$(MSBuildThisFileDirectory)analyzer/DotNetAntiSlop.Analyzers.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      PrivateAssets="all" />
  </ItemGroup>
</Project>
