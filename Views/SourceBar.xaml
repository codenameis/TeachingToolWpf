<UserControl x:Class="TeachingToolWpf.Views.SourceBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="White" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="16,10">
        <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="이미지 열기" Tag="{StaticResource OpenIcon}" Command="{Binding OpenImage}" Style="{StaticResource SecondaryButton}" ToolTip="이미지 열기 / 교체 · Ctrl+O" Margin="0,0,12,0"/>
                <Button Content="8K 샘플" Command="{Binding Sample8K}" ToolTip="8,192 × 8,192 검사 이미지"/>
                <Button Content="24K 샘플" Command="{Binding Sample24K}" ToolTip="24,576 × 32,768 대용량 이미지"/>
                <Border Width="1" Background="{StaticResource Stroke}" Margin="12,6"/>
                <ComboBox ItemsSource="{Binding LiveFormats}" SelectedItem="{Binding LiveFormat}" Width="94" ToolTip="라이브 픽셀 형식" AutomationProperties.Name="라이브 픽셀 형식" Margin="0,0,8,0"/>
                <Button Content="라이브 시작" Tag="{StaticResource PlayIcon}" Command="{Binding StartLive}" ToolTip="7680 × 4320 합성 영상 시작">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsLiveRunning}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
                <Button Content="라이브 정지" Tag="{StaticResource StopIcon}" Command="{Binding StopLive}" Foreground="#14825D" Visibility="{Binding IsLiveRunning, Converter={StaticResource BoolVisibility}}" ToolTip="마지막 프레임을 유지하고 공급을 정지"/>
                <Button Content="읽기 취소" Command="{Binding CancelImport}" Visibility="{Binding Images.IsBusy, Converter={StaticResource BoolVisibility}}"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Command="{Binding Undo}" Tag="{StaticResource UndoIcon}" Style="{StaticResource IconButton}" ToolTip="{Binding UndoHint}" AutomationProperties.Name="실행 취소"/>
                <Button Command="{Binding Redo}" Tag="{StaticResource RedoIcon}" Style="{StaticResource IconButton}" ToolTip="{Binding RedoHint}" AutomationProperties.Name="다시 실행"/>
                <Border Width="1" Background="{StaticResource Stroke}" Margin="12,6"/>
                <Button Content="ROI 추가" Tag="{StaticResource AddIcon}" Style="{StaticResource PrimaryButton}" Command="{Binding AddRoi}" ToolTip="보이는 이미지 중앙에 ROI를 바로 만듭니다." Padding="14,0"/>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
