<Window x:Class="VisionCanvas.WgpuSample.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:canvas="clr-namespace:VisionCanvas.Controls;assembly=VisionCanvas.Host"
        xmlns:wgpu="clr-namespace:VisionCanvas.Wgpu.Controls;assembly=VisionCanvas.Wgpu"
        Title="VisionCanvas · Wgpu" Width="1280" Height="900" MinWidth="900" MinHeight="600"
        Background="#F4F5F7" FontFamily="Malgun Gothic" FontSize="13"
        PreviewKeyDown="OnPreviewKeyDown" Closed="OnClosed">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="VisionCanvas / Wgpu" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Text="대용량 이미지와 회전 ROI 편집" Foreground="#4B5563" Margin="0,0,0,12" />
            <WrapPanel>
                <Button Content="파일 열기" Command="{Binding OpenCommand}" ToolTip="Ctrl+O" />
                <Button Content="8K 예제" Command="{Binding SampleCommand}" />
                <Button Content="화면 맞춤" Command="{Binding FitCommand}" />
                <Button Content="1:1" Command="{Binding ActualSizeCommand}" />
                <Button Content="확대 +" Command="{Binding ZoomInCommand}" />
                <Button Content="축소 −" Command="{Binding ZoomOutCommand}" />
                <Button Content="선택" Command="{Binding SelectCommand}" />
                <Button Content="화면 이동" Command="{Binding PanCommand}" />
                <Button Content="Undo" Command="{Binding UndoCommand}" />
                <Button Content="Redo" Command="{Binding RedoCommand}" />
            </WrapPanel>
            <WrapPanel>
                <ComboBox ItemsSource="{Binding Shapes}" SelectedItem="{Binding Shape}" IsEnabled="{Binding IsInputEnabled}"
                          Width="120" Height="34" Margin="0,0,8,6" VerticalContentAlignment="Center" />
                <Button Content="ROI 추가" Command="{Binding AddCommand}" />
                <Button Content="1억 ROI" Command="{Binding HundredMillionCommand}" ToolTip="현재 이미지에 반복 ROI 100,020,001개를 추가합니다." />
                <Button Content="ROI 그리기" Command="{Binding DrawCommand}" />
                <Button Content="부모 추가" Command="{Binding AddParentCommand}" />
                <Button Content="부모 그리기" Command="{Binding DrawParentCommand}" />
                <Button Content="그리기 완료" Command="{Binding CompleteCommand}" />
                <Button Content="취소" Command="{Binding CancelCommand}" />
            </WrapPanel>
            <WrapPanel>
                <Button Content="전체 선택" Command="{Binding SelectAllCommand}" />
                <Button Content="그룹화" Command="{Binding GroupCommand}" />
                <Button Content="그룹 해제" Command="{Binding UngroupCommand}" />
                <Button Content="복사" Command="{Binding CopyCommand}" />
                <Button Content="붙여넣기" Command="{Binding PasteCommand}" />
                <Button Content="삭제" Command="{Binding DeleteCommand}" />
                <Button Content="0° 초기화" Command="{Binding ResetAngleCommand}" />
            </WrapPanel>
            <canvas:ViewportNavigationBar DataContext="{Binding Navigation}" />
            <TextBlock Text="{Binding Tool}" FontWeight="SemiBold" Margin="0,2,0,8" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock Text="방향키: 1px · Shift: 10px  ·  휠: 확대·축소  ·  가운데 버튼: 이동  ·  Ctrl+클릭: 복수 선택  ·  더블클릭: 중첩 선택  ·  Esc: 취소"
                       Foreground="#4B5563" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Summary}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding Status}" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding RendererStatus}" Margin="0,4,0,0" Foreground="#4B5563" TextWrapping="Wrap" />
        </StackPanel>
        <Border BorderBrush="#CBD0D8" BorderThickness="1">
            <wgpu:WgpuViewport x:Name="Canvas" Scene="{Binding Scene}" PointerInput="{Binding Input}"
                               LayoutState="{Binding Layout}" KeyAction="{Binding KeyAction}" IsInputEnabled="{Binding IsNavigationEnabled}" />
        </Border>
    </DockPanel>
</Window>

