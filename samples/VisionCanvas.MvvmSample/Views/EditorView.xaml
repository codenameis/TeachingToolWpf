<!-- 화면 배치 파일이다. canvas 접두사는 VisionCanvas 라이브러리의 컨트롤을 가리킨다.
     버튼의 실제 동작은 DataContext로 연결된 EditorViewModel에 있다. -->
<UserControl x:Class="VisionCanvas.MvvmSample.Views.EditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:canvas="clr-namespace:VisionCanvas.Controls;assembly=VisionCanvas"

        Background="#F4F5F7" FontFamily="Malgun Gothic" FontSize="13"
        PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>
        <!-- 여러 버튼에 같은 여백·높이를 적용하는 공통 스타일이다. -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
    </UserControl.Resources>
    <!-- 도구는 위, 상태는 아래에 배치한다. 마지막 자식인 Canvas 영역은 남은 공간을 채운다. -->
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding CameraName}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Text="이미지를 열고 ROI를 그려 보세요. 그룹 하나를 선택하면 그 안에 자식 ROI를 그립니다."
                       Foreground="#4B5563" TextWrapping="Wrap" Margin="0,0,0,12" />
            <WrapPanel>
                <!-- Binding은 VM 속성과 UI를 연결한다. 클릭하면 OpenCommand.Execute가 호출된다.
                     버튼 활성 여부도 OpenCommand.CanExecute가 정하므로 여기서 따로 계산하지 않는다. -->
                <Button Content="파일 열기" Command="{Binding OpenCommand}" ToolTip="Ctrl+O" />
                <Button Content="8K 예제" Command="{Binding SampleCommand}" />
                <Button Content="화면 맞춤" Command="{Binding FitCommand}" />
                <Button Content="확대 +" Command="{Binding ZoomInCommand}" />
                <Button Content="축소 −" Command="{Binding ZoomOutCommand}" />
                <Button Content="선택" Command="{Binding SelectCommand}" />
                <Button Content="화면 이동" Command="{Binding PanCommand}" />
                <Button Content="Undo" Command="{Binding UndoCommand}" ToolTip="Ctrl+Z" />
                <Button Content="Redo" Command="{Binding RedoCommand}" ToolTip="Ctrl+Y / Ctrl+Shift+Z" />
            </WrapPanel>
            <WrapPanel>
                <Button Content="사각형 그리기" Command="{Binding DrawRectangleCommand}" />
                <Button Content="원 그리기" Command="{Binding DrawCircleCommand}" />
                <Button Content="다각형 그리기" Command="{Binding DrawPolygonCommand}" />
                <Button Content="부모 그리기" Command="{Binding DrawParentCommand}" />
                <Button Content="그리기 완료" Command="{Binding CompletePolygonCommand}" ToolTip="Enter" />
                <Button Content="취소" Command="{Binding CancelCommand}" ToolTip="Esc" />
            </WrapPanel>
            <WrapPanel>
                <Button Content="전체 선택" Command="{Binding SelectAllCommand}" ToolTip="Ctrl+A" />
                <Button Content="그룹화" Command="{Binding GroupCommand}" />
                <Button Content="그룹 해제" Command="{Binding UngroupCommand}" />
                <Button Content="복사" Command="{Binding CopyCommand}" ToolTip="Ctrl+C" />
                <Button Content="붙여넣기" Command="{Binding PasteCommand}" ToolTip="Ctrl+V" />
                <Button Content="삭제" Command="{Binding DeleteCommand}" ToolTip="Delete" />
            </WrapPanel>
            <TextBlock Text="{Binding ToolDescription}" FontWeight="SemiBold" Margin="0,2,0,8" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <!-- 목록과 Canvas는 같은 ROI ID를 사용한다. 선택한 행의 알고리즘 설정을 아래에서 읽는다. -->
            <TextBlock Text="ROI / 그룹 · 예제 알고리즘 설정 (검사 실행 없음)" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ListBox ItemsSource="{Binding RoiItems}" SelectedItem="{Binding SelectedRoi, Mode=TwoWay}"
                     IsEnabled="{Binding IsInputEnabled}" Height="120" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Shape}" Foreground="#4B5563" />
                            <TextBlock Grid.Column="2" Text="{Binding AlgorithmName}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{Binding SelectedRoi.Parameters}" TextWrapping="Wrap" MinHeight="20" Margin="0,4,0,4" />
            <!-- VM이 PropertyChanged 알림을 보내면 Binding이 바뀐 문자열을 다시 읽어 표시한다. -->
            <TextBlock Text="휠: 확대·축소  ·  가운데 버튼: 화면 이동  ·  Ctrl+클릭: 복수 선택  ·  Esc: 취소"
                       Foreground="#4B5563" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Summary}" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Status}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <Border BorderBrush="#CBD0D8" BorderThickness="1">
            <!-- Scene: 무엇을 그릴지 / PointerInput: 마우스 입력을 처리할 객체.
                 LayoutState: 컨트롤이 실제 화면 크기·DPI를 기록하고 VM이 그 값을 읽는다.
                 KeyAction: 네이티브 Canvas의 키 입력도 같은 VM 명령으로 전달한다.
                 이미지 원본의 소유권 전달은 App이 연결한 ImageCoordinator가 담당한다. -->
            <canvas:Dx12Viewport x:Name="Canvas" Scene="{Binding Scene}" PointerInput="{Binding Input}"
                                 LayoutState="{Binding Layout}" KeyAction="{Binding KeyAction}"
                                 IsInputEnabled="{Binding IsInputEnabled}" />
        </Border>
    </DockPanel>
</UserControl>
