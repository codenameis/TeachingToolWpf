<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultItemExcludes>$(DefaultItemExcludes);src/**;tests/**;benchmarks/**;.packages/**;artifacts/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="src\TeachingToolWpf.Core\TeachingToolWpf.Core.csproj" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="NetVips" Version="3.2.0" />
    <PackageReference Include="NetVips.Native.win-x64" Version="8.18.6" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win.slim" Version="4.13.0.20260627" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Shaders\*.hlsl" CopyToOutputDirectory="PreserveNewest" />
    <None Update="README.md;AGENTS.md;Agent.MD;THIRD-PARTY-NOTICES.md;licenses\**\*;docs\**\*.md;tasks\*.md;scripts\Summarize-Benchmark.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="docs\data\*.json;docs\data\*.csv;docs\data\*.zip;scripts\Summarize-RoiPerformance.ps1;scripts\Summarize-ResponsiveEditing.ps1;scripts\Summarize-RoiRotation.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
