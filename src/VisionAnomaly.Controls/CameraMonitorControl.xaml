<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:canvas="clr-namespace:VisionCanvas.Controls;assembly=VisionCanvas" x:Class="VisionAnomaly.Controls.CameraMonitorControl" x:Name="Root" MinWidth="220" MinHeight="110" Focusable="False">
    <Border CornerRadius="6" BorderThickness="1" Background="#192022">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="#344044"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, ElementName=Root}" Value="True">
                        <Setter Property="BorderBrush" Value="#91DFC0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid Margin="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="46"/>
            </Grid.RowDefinitions>
            <Button Content="{Binding Title, ElementName=Root}" Command="{Binding SelectCommand, ElementName=Root}" AutomationProperties.Name="{Binding Title, ElementName=Root}" Background="Transparent" BorderThickness="0" Foreground="#E8F2EF" HorizontalContentAlignment="Left" Padding="12,4" FontWeight="SemiBold"/>
            <Grid Grid.Row="1" Background="#101617">
                <TextBlock x:Name="EmptyMessage" Text="연결할 영상을 선택하세요" Foreground="#A3B4B4" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="8,0"/>
                <canvas:Dx12Viewport x:Name="Surface" Visibility="Collapsed" IsInputEnabled="False"/>
            </Grid>
            <StackPanel Grid.Row="2" Margin="10,4">
                <TextBlock Text="{Binding StatusText, ElementName=Root}" Foreground="#C9E8DA" FontSize="11" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding DetailText, ElementName=Root}" Foreground="#9DAEAE" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
