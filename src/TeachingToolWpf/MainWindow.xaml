<Window x:Class="TeachingToolWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TeachingToolWpf.Controls;assembly=VisionCanvas"
        xmlns:views="clr-namespace:TeachingToolWpf.Views"
        Title="Vision Teaching Studio" Width="1440" Height="880" MinWidth="1180" MinHeight="680"
        Background="{StaticResource Shell}" Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI Variable, Segoe UI, Malgun Gothic" UseLayoutRounding="True" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="20,0">
            <DockPanel VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="#16A379" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Teaching workspace" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="26" Height="26" Background="{StaticResource Accent}" CornerRadius="7" Margin="0,0,10,0"><Path Data="M5,12 L10,17 20,7" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Border>
                    <TextBlock Text="Vision" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="/" Foreground="#BBC3CF" FontSize="18" Margin="14,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Teaching Studio" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <views:SourceBar Grid.Row="1"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="212"/><ColumnDefinition Width="*"/><ColumnDefinition Width="264"/></Grid.ColumnDefinitions>
            <Border BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0"><views:RoiPanel x:Name="Regions"/></Border>
            <Grid Grid.Column="1" Margin="12">
                <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="38"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Background="White" CornerRadius="9,9,0,0" Padding="16,10">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Background="{StaticResource Shell}" CornerRadius="5" Padding="8,4" VerticalAlignment="Center"><TextBlock Text="{Binding ToolName}" Foreground="{StaticResource TextSecondary}" FontSize="10"/></Border>
                        <StackPanel><TextBlock Text="{Binding ImageTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ImageDetails}" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,4,0,0"/></StackPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Row="1" Padding="14,0" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Stroke}">
                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#FAFBFD"/><Style.Triggers><DataTrigger Binding="{Binding IsDraw}" Value="True"><Setter Property="Background" Value="{StaticResource AccentSoft}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                    <TextBlock Text="{Binding ToolHint}" FontSize="10" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Border>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="White" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
                        <StackPanel Margin="0,8,0,0">
                            <Button Tag="{StaticResource CursorIcon}" Command="{Binding SelectTool}" Style="{StaticResource SelectToolStyle}" ToolTip="선택 · V" AutomationProperties.Name="선택 도구" Margin="0,0,0,6"/>
                            <Button Tag="{StaticResource PanIcon}" Command="{Binding PanTool}" Style="{StaticResource PanToolStyle}" ToolTip="화면 이동 · H · Space+드래그" AutomationProperties.Name="화면 이동 도구" Margin="0,0,0,6"/>
                            <Border Height="1" Background="{StaticResource Stroke}" Margin="10,4,10,10"/>
                            <Button Tag="{StaticResource DrawIcon}" Command="{Binding DrawTool}" Style="{StaticResource DrawToolStyle}" ToolTip="부모 ROI 드래그 그리기 · R" AutomationProperties.Name="ROI 그리기 도구" Margin="0,0,0,6"/>
                            <Button Tag="{StaticResource AddIcon}" Command="{Binding AddRoi}" Style="{StaticResource IconButton}" ToolTip="독립 부모 ROI 즉시 추가" AutomationProperties.Name="부모 ROI 즉시 추가"/>
                        </StackPanel>
                    </Border>
                    <controls:Dx12Viewport x:Name="Viewport" Grid.Column="1" AutomationProperties.Name="이미지 ROI 편집 캔버스"/>
                </Grid>
                <views:ViewportToolbar Grid.Row="3"/>
            </Grid>
            <Border Grid.Column="2" BorderBrush="{StaticResource Stroke}" BorderThickness="1,0,0,0"><views:InspectorPanel/></Border>
        </Grid>
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="16,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Performance}" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="12,0" ToolTip="{Binding GpuStatus}"/>
                    <Button Content="GPU" Command="{Binding RestartRenderer}" Height="24" FontSize="10" ToolTip="{Binding GpuStatus}" AutomationProperties.Name="GPU 재연결"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding SelectionSummary}" Foreground="{StaticResource TextSecondary}" FontSize="10" VerticalAlignment="Center" Margin="12,0"/>
                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondary}" FontSize="10" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
