<UserControl x:Class="TeachingToolWpf.Views.PrimitiveShapeDetectionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TeachingToolWpf.Controls"
             Validation.Error="OnValidationError">
    <Expander Header="일반 도형 검출 · 학습 불필요" IsExpanded="True" Margin="0,0,0,20">
        <StackPanel Margin="0,10,0,0">
            <TextBlock Text="채워진 삼각형·직각 사각형·원·대칭 십자가의 실제 외곽 윤곽을 찾습니다. 서로 붙은 도형, 테두리만 있는 도형과 부분 가림은 지원하지 않습니다."
                       FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
            <StackPanel IsEnabled="{Binding IsIdle}">
                <WrapPanel Margin="0,0,0,8">
                    <CheckBox Content="삼각형" IsChecked="{Binding FindTriangles}" Margin="0,0,10,8"/>
                    <CheckBox Content="사각형" IsChecked="{Binding FindRectangles}" Margin="0,0,10,8"/>
                    <CheckBox Content="원" IsChecked="{Binding FindCircles}" Margin="0,0,10,8"/>
                    <CheckBox Content="십자가" IsChecked="{Binding FindCrosses}" Margin="0,0,10,8"/>
                </WrapPanel>
                <CheckBox Content="선택 ROI 안의 도형만 검출" IsChecked="{Binding UseSelection}" Margin="0,0,0,10"
                          ToolTip="도형의 전체 윤곽이 선택한 ROI 안에 있어야 합니다."/>
                <ComboBox ItemsSource="{Binding Polarities}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Polarity}"
                          AutomationProperties.Name="도형 명암 방향" Margin="0,0,0,10"/>
                <TextBlock Text="최소 / 최대 크기 (원본 px · 6~512)" Style="{StaticResource Caption}"/>
                <UniformGrid Columns="2" Margin="0,5,0,10">
                    <TextBox Text="{Binding MinimumSize, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                             AutomationProperties.Name="최소 도형 크기" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding MaximumSize, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                             AutomationProperties.Name="최대 도형 크기"/>
                </UniformGrid>
                <TextBlock Text="크기는 이미지 축 기준 바깥 폭·높이입니다. 최대 크기를 높이면 원본 검색 창의 겹침과 검사 시간이 늘어납니다."
                           FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
                <Expander Header="도형 검출 고급 설정" IsExpanded="False" Margin="0,0,0,10">
                    <StackPanel Margin="0,10,0,0">
                        <CheckBox Content="자동 이진화 (창별 Otsu)" IsChecked="{Binding AutomaticThreshold}" Margin="0,0,0,8"/>
                        <TextBlock Text="수동 이진화 기준 (0~255)" Style="{StaticResource Caption}"/>
                        <TextBox Text="{Binding Threshold, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                                 AutomationProperties.Name="도형 이진화 기준" Margin="0,5,0,10"/>
                        <TextBlock Text="윤곽 근사 허용비율 (.005~.04)" Style="{StaticResource Caption}"/>
                        <TextBox Text="{Binding ApproximationTolerance, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                                 AutomationProperties.Name="도형 윤곽 근사 허용비율" Margin="0,5,0,10"/>
                        <TextBlock Text="최소 형상 점수 (0~1)" Style="{StaticResource Caption}"/>
                        <TextBox Text="{Binding MinimumScore, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                                 AutomationProperties.Name="최소 도형 점수" Margin="0,5,0,10"/>
                        <TextBlock Text="최대 결과 수 (1~1000개)" Style="{StaticResource Caption}"/>
                        <TextBox Text="{Binding MaximumResults, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                                 AutomationProperties.Name="최대 도형 결과 수" Margin="0,5,0,10"/>
                        <TextBlock Text="검사 시간 한도 (0~600초 · 0 무제한)" Style="{StaticResource Caption}"/>
                        <TextBox Text="{Binding SearchTimeoutSeconds, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                                 AutomationProperties.Name="도형 검사 시간 한도" Margin="0,5,0,10"/>
                        <TextBlock Text="시간 한도에 도달하면 현재 네이티브 창 처리가 끝난 뒤 취소하며, 불완전 검색 경고를 표시합니다."
                                   FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Text="원은 반경의 일관성, 다각형은 근사 윤곽의 면적 일치를 점수로 표시합니다. 서로 다른 종류의 점수는 검출 확률이 아닙니다. 영상 경계에서 잘린 윤곽과 결과 한도 초과는 경고합니다."
                                   FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
            <TextBlock Text="{Binding OptionsError}" Foreground="#9A3412" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"/>
            <UniformGrid Columns="2">
                <Button Content="도형 검출" Command="{Binding Detect}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0"/>
                <Button Content="검출 취소" Command="{Binding Cancel}" Style="{StaticResource SecondaryButton}"/>
            </UniformGrid>
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,8"/>
            <CheckBox Content="도형 위치 표시" IsChecked="{Binding ShowOverlay}" Margin="0,0,0,8"/>
            <Button Content="도형 위치로 화면 맞춤" Command="{Binding Locate}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,10"/>
            <TextBlock Text="{Binding Results}" TextWrapping="Wrap" FontSize="11"/>
        </StackPanel>
    </Expander>
</UserControl>
