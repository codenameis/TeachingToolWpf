<UserControl x:Class="TeachingToolWpf.Views.InspectorPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:TeachingToolWpf.Views" xmlns:controls="clr-namespace:TeachingToolWpf.Controls">
    <Border Background="White" Padding="20,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="검사 영역" FontSize="13" FontWeight="SemiBold" Height="56" Padding="0,18,0,0"/>
                <views:ShapeMatchingPanel DataContext="{Binding Matching}"/>
                <views:FilterPanel DataContext="{Binding Filters}"/>
                <StackPanel Visibility="{Binding Properties.HasSingleSelection, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="{Binding Properties.ShapeDescription}" FontWeight="SemiBold" Margin="0,12,0,6"/>
                    <TextBlock Text="이름" Style="{StaticResource Caption}"/>
                    <controls:ValueTextBox Style="{StaticResource ValueTextBoxStyle}" Value="{Binding Properties.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="256" AutomationProperties.Name="ROI 이름"/>
                    <Border Height="1" Background="{StaticResource Stroke}" Margin="0,24"/>
                    <TextBlock Text="위치와 크기" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="중심 X" Style="{StaticResource Caption}"/><controls:ValueTextBox Style="{StaticResource ValueTextBoxStyle}" Value="{Binding Properties.X, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="중심 X"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="중심 Y" Style="{StaticResource Caption}"/><controls:ValueTextBox Style="{StaticResource ValueTextBoxStyle}" Value="{Binding Properties.Y, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="중심 Y"/></StackPanel>
                    </Grid>
                    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="너비" Style="{StaticResource Caption}"/><controls:ValueTextBox Style="{StaticResource ValueTextBoxStyle}" Value="{Binding Properties.Width, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="ROI 너비"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="높이" Style="{StaticResource Caption}"/><controls:ValueTextBox Style="{StaticResource ValueTextBoxStyle}" Value="{Binding Properties.Height, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="ROI 높이"/></StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Properties.SizeHint}" TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,9,0,0"/>
                    <Border Height="1" Background="{StaticResource Stroke}" Margin="0,24"/>
                    <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Tag="{StaticResource ResetIcon}" Command="{Binding ResetAngle}" Style="{StaticResource IconButton}" ToolTip="절대 각도 0°로 초기화" AutomationProperties.Name="0도 초기화"/><TextBlock Text="회전" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="°" VerticalAlignment="Center" Margin="8,0,0,0"/><controls:ValueTextBox Style="{StaticResource ValueTextBoxStyle}" Value="{Binding Properties.Angle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="이미지 기준 회전 각도"/></DockPanel>
                    <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="−15°" Command="{Binding RotateLeft}" Style="{StaticResource SecondaryButton}"/><Button Grid.Column="2" Content="＋15°" Command="{Binding RotateRight}" Style="{StaticResource SecondaryButton}"/></Grid>
                    <TextBlock Text="{Binding Properties.RelativeAngle, StringFormat=부모 기준 · {0}}" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,12,0,0"/>
                    <Button Content="변경 적용" Command="{Binding ApplyProperties}" Style="{StaticResource PrimaryButton}" Margin="0,24,0,0"/>
                </StackPanel>
                <StackPanel Margin="0,36,0,0">
                    <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Properties.HasSingleSelection}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <Path Data="{StaticResource CursorIcon}" Width="24" Height="24" Stretch="Uniform" Stroke="#9DA9BA" StrokeThickness="1.5" HorizontalAlignment="Left" Margin="0,0,0,20"/>
                    <TextBlock Text="{Binding SelectionTitle}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="영역 하나를 선택하면 위치, 크기와 회전을 정밀하게 편집할 수 있습니다." TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                    <Button Content="선택 각도 0°로 초기화" Command="{Binding ResetAngle}" Style="{StaticResource SecondaryButton}" Margin="0,20,0,0"/>
                </StackPanel>
                <views:RoiStylePanel DataContext="{Binding StyleSettings}"/>
                <Border BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Margin="0,28,0,0" Padding="0,18,0,20">
                    <StackPanel><TextBlock Text="편집 가이드" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/><TextBlock Text="모서리 핸들  ·  크기 조절&#x0a;원형 핸들  ·  회전&#x0a;방향키  ·  1 px 이동&#x0a;Shift + 방향키  ·  10 px 이동" Foreground="{StaticResource TextSecondary}" FontSize="10" LineHeight="21"/></StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
