<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:TeachingToolWpf.Views" xmlns:filters="clr-namespace:VisionCanvas.Filters.Wpf.Controls;assembly=VisionCanvas.Filters.Wpf" xmlns:controls="clr-namespace:TeachingToolWpf.Controls" x:Class="TeachingToolWpf.Views.InspectorPanel">
    <Grid Background="{StaticResource Surface}" Margin="16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="작업 패널" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <TabControl x:Name="WorkspaceTabs" Grid.Row="1" Style="{StaticResource InspectorTabs}" ItemContainerStyle="{StaticResource InspectorTab}" AutomationProperties.Name="오른쪽 작업 선택">
            <TabItem Header="검사">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ComboBox ItemsSource="{Binding Inspections.Tools}" DisplayMemberPath="Name" SelectedValuePath="Kind" SelectedValue="{Binding Inspections.Selected}" IsEnabled="{Binding Inspections.IsIdle}" AutomationProperties.Name="검사 도구" Margin="0,0,0,12"/>
                    <Grid Grid.Row="1">
                        <Grid Visibility="{Binding Inspections.ShowPatterns, Converter={StaticResource BoolVisibility}}">
                            <views:ShapeMatchingPanel DataContext="{Binding Matching}"/>
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding Inspections.ShowShapes, Converter={StaticResource BoolVisibility}}">
                            <views:PrimitiveShapeDetectionPanel DataContext="{Binding Inspections.Shapes}"/>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="영역">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,8,4,12">
                        <TextBlock Text="반복 ROI: 위치·크기·회전·부분 선택·복붙을 지원합니다. 그룹화·이름·검색 범위·필터·마스크·검사는 일반 ROI에서 사용하세요." TextWrapping="Wrap" Margin="0,8,0,12" FontSize="11" Visibility="{Binding HasRepeatedSelection, Converter={StaticResource BoolVisibility}}"/>
                        <StackPanel Visibility="{Binding Properties.HasSingleSelection, Converter={StaticResource BoolVisibility}}">
                            <TextBlock Text="{Binding Properties.ShapeDescription}" FontWeight="SemiBold" Margin="0,12,0,6"/>
                            <TextBlock Text="{Binding Properties.GroupDescription}" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="{Binding Properties.IsGroup, Converter={StaticResource BoolVisibility}}"/>
                            <StackPanel Visibility="{Binding Properties.CanChangeType, Converter={StaticResource BoolVisibility}}">
                                <TextBlock Text="ROI 타입" Style="{StaticResource Caption}"/>
                                <ComboBox ItemsSource="{Binding Properties.Types}" SelectedIndex="{Binding Properties.SelectedType}" AutomationProperties.Name="ROI 타입" Margin="0,0,0,12"/>
                            </StackPanel>
                            <TextBlock Text="이름" Style="{StaticResource Caption}"/>
                            <controls:ValueTextBox Style="{StaticResource ValueTextBoxStyle}" Value="{Binding Properties.Name, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Properties.CanEditMetadata}" MaxLength="256" AutomationProperties.Name="ROI 이름"/>
                            <CheckBox Content="캔버스에 이름 표시 (Visible)" IsChecked="{Binding Properties.IsNameVisible}" IsEnabled="{Binding Properties.CanEditMetadata}" Margin="0,12,0,0" AutomationProperties.Name="캔버스 이름 표시"/>
                            <StackPanel Visibility="{Binding Properties.HasSearchRange, Converter={StaticResource BoolVisibility}}" Margin="0,20,0,0">
                                <TextBlock Text="검색 범위 · 빨간 점선" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBlock Text="가로 양쪽 여유 (px)" Style="{StaticResource Caption}"/>
                                <controls:ValueTextBox Style="{StaticResource ValueTextBoxStyle}" Value="{Binding Properties.SearchHorizontal, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="검색 가로 여유"/>
                                <TextBlock Text="세로 양쪽 여유 (px)" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
                                <controls:ValueTextBox Style="{StaticResource ValueTextBoxStyle}" Value="{Binding Properties.SearchVertical, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="검색 세로 여유"/>
                                <TextBlock Text="타입 선택은 즉시 적용됩니다. ROI 로컬 축 기준으로 양쪽을 확장하며 이동·회전을 따릅니다. 여유 숫자는 변경 적용으로 확정하세요." TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,9,0,0"/>
                            </StackPanel>
                            <Border Height="1" Background="{StaticResource Stroke}" Margin="0,24"/>
                            <TextBlock Text="위치와 크기" FontWeight="SemiBold" Margin="0,0,0,16"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="중심 X" Style="{StaticResource Caption}"/>
                                    <controls:ValueTextBox Style="{StaticResource ValueTextBoxStyle}" Value="{Binding Properties.X, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="중심 X"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="중심 Y" Style="{StaticResource Caption}"/>
                                    <controls:ValueTextBox Style="{StaticResource ValueTextBoxStyle}" Value="{Binding Properties.Y, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="중심 Y"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="너비" Style="{StaticResource Caption}"/>
                                    <controls:ValueTextBox Style="{StaticResource ValueTextBoxStyle}" Value="{Binding Properties.Width, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="ROI 너비"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="높이" Style="{StaticResource Caption}"/>
                                    <controls:ValueTextBox Style="{StaticResource ValueTextBoxStyle}" Value="{Binding Properties.Height, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="ROI 높이"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding Properties.SizeHint}" TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,9,0,0"/>
                            <Border Height="1" Background="{StaticResource Stroke}" Margin="0,24"/>
                            <DockPanel Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Tag="{StaticResource ResetIcon}" Command="{Binding ResetAngle}" Style="{StaticResource IconButton}" ToolTip="절대 각도 0°로 초기화" AutomationProperties.Name="0도 초기화"/>
                                <TextBlock Text="회전" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="°" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <controls:ValueTextBox Style="{StaticResource ValueTextBoxStyle}" Value="{Binding Properties.Angle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="이미지 기준 회전 각도"/>
                            </DockPanel>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Button Content="−15°" Command="{Binding RotateLeft}" Style="{StaticResource SecondaryButton}"/>
                                <Button Grid.Column="2" Content="＋15°" Command="{Binding RotateRight}" Style="{StaticResource SecondaryButton}"/>
                            </Grid>
                            <TextBlock Text="{Binding Properties.RelativeAngle, StringFormat=부모 기준 · {0}}" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,12,0,0"/>
                            <Button Content="변경 적용" Command="{Binding ApplyProperties}" Style="{StaticResource PrimaryButton}" Margin="0,24,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="0,36,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Properties.HasSingleSelection}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Path Data="{StaticResource CursorIcon}" Width="24" Height="24" Stretch="Uniform" Stroke="#9DA9BA" StrokeThickness="1.5" HorizontalAlignment="Left" Margin="0,0,0,20"/>
                            <TextBlock Text="{Binding SelectionTitle}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="영역 하나를 선택하면 위치, 크기와 회전을 정밀하게 편집할 수 있습니다." TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                            <Button Content="선택 각도 0°로 초기화" Command="{Binding ResetAngle}" Style="{StaticResource SecondaryButton}" Margin="0,20,0,0"/>
                        </StackPanel>
                        <Expander Header="검사에서 제외할 부분 · 마스크" Margin="0,16,0,0">
                            <views:RoiMaskPanel DataContext="{Binding Masks}"/>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="필터">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,12,4,8">
                        <TextBlock Text="선택 ROI의 화면 미리보기입니다. 검사 원본은 바뀌지 않습니다." TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                        <Border IsEnabled="{Binding CanUseOrdinaryRoiTools}">
                            <filters:FilterPanel DataContext="{Binding Filters}"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
