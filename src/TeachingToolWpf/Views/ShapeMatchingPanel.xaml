<UserControl x:Class="TeachingToolWpf.Views.ShapeMatchingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TeachingToolWpf.Controls"
             Validation.Error="OnNumericValidationError">
    <Expander Header="패턴 학습 · 검사" IsExpanded="True" Margin="0,0,0,20">
        <StackPanel Margin="0,12,0,0">
            <Border Background="#F1F5F9" BorderBrush="{Binding VerdictColor}" BorderThickness="3,0,0,0" Padding="8" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" Foreground="#334155"/>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
                </StackPanel>
            </Border>
            <ComboBox ItemsSource="{Binding Methods}" DisplayMemberPath="Name" SelectedValuePath="Method" SelectedValue="{Binding Method}"
                      IsEnabled="{Binding IsIdle}" AutomationProperties.Name="매칭 방식" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding MethodDescription}" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
            <Expander Header="후보 예산 · 실행 제어" IsExpanded="True" Margin="0,0,0,10" IsEnabled="{Binding IsIdle}">
                <StackPanel Margin="0,8,0,0">
                    <ComboBox ItemsSource="{Binding SpeedProfiles}" DisplayMemberPath="Name" SelectedValuePath="Profile"
                              SelectedValue="{Binding SpeedProfile}" AutomationProperties.Name="후보 예산 프리셋" Margin="0,0,0,8"/>
                    <TextBlock Text="후보 예산은 검증할 후보 수를 정합니다. 확대하면 누락을 줄일 수 있지만 더 오래 걸릴 수 있습니다. 합격 점수·최대 결과 수와 원본 정밀화는 유지됩니다."
                               TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                    <StackPanel Visibility="{Binding IsShapeMethod, Converter={StaticResource BoolVisibility}}">
                        <ComboBox ItemsSource="{Binding ComputeModes}" DisplayMemberPath="Name" SelectedValuePath="Mode"
                                  SelectedValue="{Binding ComputeMode}" AutomationProperties.Name="검사 실행 장치" Margin="0,0,0,8"/>
                        <TextBlock Text="CUDA는 방향별 후보 점수를 일괄 계산합니다. 전처리와 최종 위치·각도·형상 검증은 CPU 병렬 연산입니다. NVIDIA GPU가 필요합니다."
                                   TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Text="CPU 최대 병렬도 (1~16)" Style="{StaticResource Caption}"/>
                        <TextBox Text="{Binding MaximumParallelism, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="검사 CPU 병렬도" Margin="0,4,0,8"/>
                    </StackPanel>
                    <TextBlock Text="검사 시간 한도 (초 · 0은 제한 없음)" Style="{StaticResource Caption}" ToolTip="최초 CUDA 장치 준비 시간을 포함합니다. 시간 초과 시 진행 중인 연산이 안전하게 끝난 뒤 취소됩니다."/>
                    <TextBox Text="{Binding SearchTimeoutSeconds, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="검사 시간 한도" Margin="0,4,0,8"/>
                    <TextBlock Text="시간 초과는 검색 불완전 경고입니다. 진행 중인 GPU·네이티브 연산을 안전하게 마친 뒤 취소하므로 지정 시간을 넘길 수 있습니다."
                               TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>
            </Expander>
            <TextBlock Text="{Binding ModelSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <Border Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" Padding="8" Margin="0,0,0,10"
                    Visibility="{Binding IsTrainingDirty, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="재학습 필요 · 학습 설정이 변경되었습니다. 선택 ROI로 다시 학습한 뒤 검사하세요."
                           Foreground="#9A3412" TextWrapping="Wrap" FontSize="11"/>
            </Border>
            <Expander Header="학습 설정 · 변경 후 다시 학습" IsExpanded="False" Margin="0,0,0,10"
                      Visibility="{Binding IsShapeMethod, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding IsIdle}">
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="검색 회전 편차 (학습 ROI 기준 · 최대 360°)" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                    <UniformGrid Columns="2" Margin="0,5,0,10" IsEnabled="{Binding CanEditSearchAngle}">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="최소 각도" Style="{StaticResource Caption}"/>
                            <TextBox Text="{Binding MinimumAngle, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최소 검색 각도" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="최대 각도" Style="{StaticResource Caption}"/>
                            <TextBox Text="{Binding MaximumAngle, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최대 검색 각도" Margin="0,4,0,0"/>
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Text="각도 간격 (° · 0 초과, 45 이하)" Style="{StaticResource Caption}"/>
                    <TextBox Text="{Binding AngleStep, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="템플릿 각도 간격" Margin="0,5,0,10"/>
                    <CheckBox Content="균일 스케일 검색" IsChecked="{Binding EnableScale}" Margin="0,0,0,8"/>
                    <StackPanel IsEnabled="{Binding EnableScale}">
                        <TextBlock Text="최소 / 최대 / 간격 (배율 · 최대 8)" Style="{StaticResource Caption}"/>
                        <UniformGrid Columns="3" Margin="0,5,0,10">
                            <TextBox Text="{Binding MinimumScale, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최소 배율" ToolTip="0보다 크고 최대 배율 이하여야 합니다." Margin="0,0,4,0"/>
                            <TextBox Text="{Binding MaximumScale, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최대 배율" ToolTip="최소 배율 이상, 8 이하입니다." Margin="0,0,4,0"/>
                            <TextBox Text="{Binding ScaleStep, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="템플릿 배율 간격" ToolTip="0보다 큰 배율 간격입니다."/>
                        </UniformGrid>
                    </StackPanel>
                    <CheckBox Content="명암 반전 허용" IsChecked="{Binding IgnorePolarity}" Margin="0,0,0,10"/>
                    <Expander Header="윤곽 학습 고급" IsExpanded="False" Margin="0,0,0,10">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="최대 특징 수 (12~512개)" Style="{StaticResource Caption}"/>
                            <TextBox Text="{Binding MaximumFeatures, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최대 학습 특징 수" Margin="0,5,0,10"/>
                            <TextBlock Text="최소 명암 경사 (0 초과)" Style="{StaticResource Caption}"/>
                            <TextBox Text="{Binding MinimumGradient, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최소 학습 명암 경사" Margin="0,5,0,10"
                                     ToolTip="값을 높이면 약한 윤곽을 제외합니다. 낮추면 약한 윤곽과 잡음이 함께 늘어날 수 있습니다."/>
                            <TextBlock Text="특징 최소 대비 비율 (0~1)" Style="{StaticResource Caption}"/>
                            <TextBox Text="{Binding MinimumFeatureContrastRatio, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="특징 최소 대비 비율" Margin="0,5,0,10"
                                     ToolTip="기본값은 0.2입니다. 가장 강한 학습 에지에 대한 상대 강도로 방향 특징 후보를 추립니다. 0은 이 비율로 후보를 제외하지 않으며 최소 명암 경사·최대 특징 수·공간 분산 규칙은 유지됩니다. 전체 기하 윤곽·원본 마스크는 보존합니다. 값 변경 후 다시 학습하세요."/>
                            <TextBlock Text="낮은 대비의 실제 세부까지 검사하려면 0으로 설정하고 다시 학습하세요. 기본 0.2에서는 제외된 세부가 없어도 높은 점수가 나올 수 있습니다."
                                       FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
                            <TextBlock Text="회전·배율 템플릿 한도 (1~16384개)" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                            <TextBox Text="{Binding MaximumTemplates, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최대 학습 템플릿 수" Margin="0,5,0,10"/>
                        </StackPanel>
                    </Expander>
                    <TextBlock Text="ROI 크기에 따라 축소 단계를 자동으로 선택합니다. 실제 단계 수는 모델 요약에 표시됩니다."
                               FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>
            </Expander>
            <Border BorderBrush="#64748B" BorderThickness="1" Padding="8" Margin="0,0,0,10"
                    Visibility="{Binding IsPaperMethod, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding IsIdle}">
                <StackPanel>
                    <CheckBox Content="회전 불량 검사 · 변경 후 재학습" IsChecked="{Binding InspectRotation}"
                              AutomationProperties.Name="회전 불량 검사" Margin="0,0,0,8"/>
                    <TextBlock Text="켜면 학습 방향 대비 전체 360°를 탐색하고 아래 정상 범위를 벗어난 검출을 NG로 표시합니다. 끄면 학습 설정의 검색 각도 범위만 사용합니다."
                               TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                    <UniformGrid Columns="2" IsEnabled="{Binding InspectRotation}">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="정상 최소 편차 (°)" Style="{StaticResource Caption}"/>
                            <TextBox Text="{Binding MinimumAcceptedAngle, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="정상 최소 회전 편차" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="정상 최대 편차 (°)" Style="{StaticResource Caption}"/>
                            <TextBox Text="{Binding MaximumAcceptedAngle, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="정상 최대 회전 편차" Margin="0,4,0,0"/>
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Text="학습한 형상 자체가 대칭이면 방향을 구분할 수 없습니다. 방향을 구별하는 글자·몸체까지 ROI에 포함하세요. 점수는 일치도이며 회전 합격 여부와 별도로 표시합니다."
                               TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <TextBlock Text="OpenCV는 학습한 방향·크기를 유지하며 위치만 검색합니다. 회전·배율 및 윤곽 학습 설정은 사용하지 않습니다."
                       Visibility="{Binding IsTemplateMethod, Converter={StaticResource BoolVisibility}}" FontSize="10"
                       TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
            <Border x:Name="NumericInputError" Visibility="Collapsed" Background="#FFF7ED" BorderBrush="#FDBA74"
                    BorderThickness="1" Padding="8" Margin="0,0,0,10" AutomationProperties.Name="패턴 숫자 입력 오류">
                <TextBlock Text="숫자 입력을 확인하세요. 잘못된 입력이 있으면 학습·검사를 실행할 수 없습니다. 방식을 바꾸면 잘못 입력한 값은 저장된 설정으로 복원됩니다."
                           Foreground="#9A3412" TextWrapping="Wrap" FontSize="11"/>
            </Border>
            <TextBlock Text="{Binding OptionsError, TargetNullValue='', FallbackValue=''}" AutomationProperties.Name="패턴 설정 오류"
                       Foreground="#9A3412" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button x:Name="TrainButton" Content="선택 ROI로 모델 학습" Command="{Binding Train}" Style="{StaticResource PrimaryButton}"
                    ToolTip="ROI 하나를 선택하세요. 라이브 영상은 정지 후 학습합니다." Margin="0,0,0,8"/>
            <Button Content="모델 해제" Command="{Binding Clear}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,16"/>
            <StackPanel IsEnabled="{Binding IsIdle}">
                <CheckBox Content="선택 ROI 안에서 기준점 검색" IsChecked="{Binding UseSelection}" Margin="0,0,0,10"/>
                <UniformGrid Columns="2" Margin="0,5,0,10">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="최소 점수 (0~1)" Style="{StaticResource Caption}"/>
                        <TextBox Text="{Binding MinimumScore, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최소 최종 매칭 점수" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="최대 결과 (1~1000)" Style="{StaticResource Caption}"/>
                        <TextBox Text="{Binding MaximumMatches, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최대 매칭 결과 수" Margin="0,5,0,0"/>
                    </StackPanel>
                </UniformGrid>
                <TextBlock Text="결과 수는 한 번에 반환할 최대 개수이며 학습 개수가 아닙니다. 결과 또는 후보 한도를 초과하면 검색 불완전 경고를 표시합니다."
                           FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
                <Expander Header="공통 검색 고급 · 후보 수와 중복" IsExpanded="False" Margin="0,0,0,10">
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="최대 후보 수 (1~100000개)" Style="{StaticResource Caption}"/>
                        <TextBox Text="{Binding MaximumCandidates, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최대 검색 후보 수" Margin="0,5,0,10"/>
                        <TextBlock Text="허용 중복 비율 (IoU · 0~1)" Style="{StaticResource Caption}"/>
                        <TextBox Text="{Binding MaximumOverlap, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최대 검출 중복 비율" Margin="0,5,0,10"
                                 ToolTip="두 검출 영역의 교집합/합집합 비율입니다. 이 값을 넘는 중복 검출을 제거합니다."/>
                        <TextBlock Text="후보 한도를 높이면 유사한 무늬가 많은 이미지에서 더 많은 위치를 확인합니다. 검사 시간과 메모리 사용이 늘어날 수 있습니다."
                                   FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Expander>
                <Expander Header="형상 검색 고급 · 후보와 방향" IsExpanded="False" Margin="0,0,0,10"
                          Visibility="{Binding IsShapeMethod, Converter={StaticResource BoolVisibility}}">
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="최소 후보 점수 (0~1)" Style="{StaticResource Caption}"/>
                        <TextBox Text="{Binding CandidateThreshold, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최소 형상 후보 점수" Margin="0,5,0,10"
                                 ToolTip="축소 검색에서 원본 검증으로 넘길 후보 기준입니다. 최종 점수와 별도로 적용합니다."/>
                        <TextBlock Text="최소 방향 지지율 (0~1)" Style="{StaticResource Caption}"/>
                        <TextBox Text="{Binding MinimumSupport, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최소 방향 지지율" Margin="0,5,0,10"/>
                        <TextBlock Text="최대 형상 검증 후보 (1~4096개)" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding MaximumVerifiedCandidates, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최대 형상 검증 후보 수" Margin="0,5,0,10"/>
                        <TextBlock Text="최대 축소 검증 후보 (1~4096개)" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding MaximumCoarseVerifiedCandidates, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최대 축소 형상 검증 후보 수" Margin="0,5,0,10"/>
                        <CheckBox Content="검출 위치·자세 정밀화" IsChecked="{Binding Refine}" Margin="0,0,0,10"/>
                        <TextBlock Text="방향 점수는 윤곽 방향의 유사도, 방향 지지율은 방향이 일치하는 특징의 비율입니다. 검증 한도가 작으면 후보가 남아 검색 불완전 경고가 표시될 수 있습니다."
                                   FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Expander>
                <Expander Header="형상 점수 · 추가 윤곽 감점" IsExpanded="False" Margin="0,0,0,10"
                          Visibility="{Binding IsShapeMethod, Converter={StaticResource BoolVisibility}}">
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="작은 논문 형상은 원본 세부 획 일치도 D를 추가 검증합니다. 최종 점수에 (1 − 비중 × (1−D))를 곱합니다. 비중 0은 세부 감점도 끕니다. 모델 요약에 적용 여부를 표시합니다."
                                   TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
                        <TextBlock Text="추가 윤곽 감점 비중 (0~1)" Style="{StaticResource Caption}"/>
                        <TextBox Text="{Binding ClutterWeight, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="추가 윤곽 감점 비중" Margin="0,5,0,10"
                                 ToolTip="대비 감점 비율은 설명되지 않은 장면 에지 강도² 합을 학습 마스크 안 전체 장면 에지 강도² 합으로 나눈 값입니다. 위치·방향 대응과 조명 보정 후 대비 허용 범위를 함께 평가합니다. 개수 비율 제한과는 별도 기준입니다."/>
                        <TextBlock Text="윤곽 대응 허용 거리 (원본 px · 0.5~8)" Style="{StaticResource Caption}"/>
                        <TextBox Text="{Binding GeometricTolerancePixels, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="윤곽 대응 허용 거리" Margin="0,5,0,10"/>
                        <TextBlock Text="최종 점수 = 방향 점수 × (1 − 비중 × 추가 윤곽 대비 비율). 에지 강도의 제곱으로 가중합니다. 조명 보정 후에도 학습 윤곽보다 2배를 넘게 강한 에지는 대비가 설명되지 않은 것으로 봅니다. 기본 비중은 1이며 0은 감점하지 않습니다. 개수 비율은 따로 표시합니다. 점수는 전체 형상의 동일성이나 불량 확률이 아닙니다."
                                   TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource TextSecondary}"
                                   ToolTip="조명 보정 배율은 강한 학습 윤곽 최대 128개의 위치·방향 대응에서 장면 강도/학습 강도 비의 중앙값으로 정합니다. 대응이 없으면 1을 사용하며 추가 결함의 최대 강도로 보정하지 않습니다. 학습 영역 밖은 평가하지 않습니다."/>
                    </StackPanel>
                </Expander>
                <Expander Header="기하 검증 · 원본 윤곽 확인" IsExpanded="False" Margin="0,0,0,10"
                          Visibility="{Binding IsGeometricMethod, Converter={StaticResource BoolVisibility}}">
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="최소 윤곽 특징 검출비율 (0~1)" Style="{StaticResource Caption}"/>
                        <TextBox Text="{Binding MinimumCoverage, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최소 윤곽 특징 검출비율" Margin="0,5,0,10"/>
                        <CheckBox Content="위치 오차 제한" IsChecked="{Binding LimitFitError}" Margin="0,0,0,5"/>
                        <TextBlock Text="최대 위치 오차 (원본 px RMS · 0 초과)" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding MaximumFitErrorPixels, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding LimitFitError}" AutomationProperties.Name="최대 윤곽 위치 오차" Margin="0,5,0,10"/>
                        <CheckBox Content="불필요 윤곽 제한" IsChecked="{Binding LimitClutter}" Margin="0,0,0,5"/>
                        <TextBlock Text="최대 불필요 윤곽비율 (개수 · 0~1)" Style="{StaticResource Caption}"/>
                        <TextBox Text="{Binding MaximumClutterRatio, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding LimitClutter}" AutomationProperties.Name="최대 불필요 윤곽비율" Margin="0,5,0,10"/>
                        <TextBlock Text="검출비율은 선택한 학습 특징 중 허용 거리 안의 실제 에지와 대응한 비율입니다.&#10;위치 오차는 대응 윤곽 사이 거리의 RMS입니다. 불필요 윤곽 제한은 학습 영역의 에지 중 전체 모델 윤곽으로 위치·방향을 설명할 수 없는 개수 비율에 적용합니다. 이 기존 개수 기준에는 대비 에너지 조건을 추가하지 않습니다. 최종 점수의 대비 감점과 별도 기준이며, 물체 면적 비율이나 치수 측정값은 아닙니다.&#10;기본값에서는 품질만 계산합니다. 검출비율을 높이거나 제한을 켜면 검출 조건으로 적용합니다."
                                   TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
            <UniformGrid Columns="2">
                <Button x:Name="SearchButton" Content="검사 실행" Command="{Binding Search}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0"
                        ToolTip="학습한 모델로 현재 원본 이미지를 검사합니다. 라이브 영상은 정지하세요."/>
                <Button Content="취소" Command="{Binding Cancel}" Style="{StaticResource SecondaryButton}"/>
            </UniformGrid>
            <Border BorderBrush="{Binding VerdictColor}" BorderThickness="3,0,0,0" Background="#101820" Padding="10,8" Margin="0,14,0,10">
                <TextBlock Text="{Binding VerdictText}" Foreground="{Binding VerdictColor}" FontWeight="Bold" FontSize="16"/>
            </Border>
            <WrapPanel Margin="0,0,0,10">
                <CheckBox Content="검사 위치 표시" IsChecked="{Binding ShowOverlay}" Margin="0,0,12,8"/>
                <CheckBox Content="특징점 표시" IsChecked="{Binding ShowFeatures}" IsEnabled="{Binding IsShapeMethod}" Margin="0,0,0,8"
                          ToolTip="학습된 윤곽 특징점을 검출된 위치·각도·배율로 변환해 표시합니다. 재검사 없이 켜고 끌 수 있습니다."/>
            </WrapPanel>
            <Button Content="검출 위치로 화면 맞춤" Command="{Binding Locate}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,10"
                    ToolTip="검출된 모든 패턴이 보이도록 화면을 이동·확대합니다."/>
            <TextBlock Text="정상 · LimeGreen / 불량 · Tomato&#10;경고 · Orange / 사용자 확인 · Gold" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
            <TextBlock Text="점선: 검색 범위 · 실선: 검출된 학습 영역" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" FontSize="11"/>
            <Expander Header="검사 시간 로그 · 최근 20회" Margin="0,10,0,8" IsExpanded="False">
                <StackPanel>
                    <Button Content="로그 JSON 저장" Click="OnSaveInspectionLog" Style="{StaticResource SecondaryButton}" Margin="0,8,0,8"/>
                    <TextBox Text="{Binding InspectionLogText, Mode=OneWay}" IsReadOnly="True" Height="280"
                             TextWrapping="Wrap" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11" AutomationProperties.Name="논문 형상 검사 단계별 시간 로그"/>
                </StackPanel>
            </Expander>
            <ListBox ItemsSource="{Binding ResultRows}" Height="320" Margin="0,8,0,0"
                     Visibility="{Binding HasResultRows, Converter={StaticResource BoolVisibility}}"
                     AutomationProperties.Name="논문 형상 전체 검사 결과"
                     ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Expander>
</UserControl>
