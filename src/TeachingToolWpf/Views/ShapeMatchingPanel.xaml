<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:TeachingToolWpf.Controls" x:Class="TeachingToolWpf.Views.ShapeMatchingPanel" Validation.Error="OnNumericValidationError">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="매칭 방식" Style="{StaticResource Caption}"/>
            <ComboBox ItemsSource="{Binding Methods}" DisplayMemberPath="Name" SelectedValuePath="Method" SelectedValue="{Binding Method}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="매칭 방식" Margin="0,4,0,8"/>
        </StackPanel>
        <TabControl x:Name="MatchingTabs" Grid.Row="1" Style="{StaticResource InspectorTabs}" ItemContainerStyle="{StaticResource InspectorTab}" AutomationProperties.Name="패턴 검사 작업">
            <TabItem Header="기본">
                <ScrollViewer x:Name="BasicScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,8,4,8">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Right" ToolTip="{Binding ModelSummary}" FontSize="11" Foreground="{StaticResource TextSecondary}" AutomationProperties.Name="학습 모델 상태">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="미학습"/><Style.Triggers>
                                    <DataTrigger Binding="{Binding HasModel}" Value="True"><Setter Property="Text" Value="학습됨"/></DataTrigger>
                                    <DataTrigger Binding="{Binding IsTrainingDirty}" Value="True"><Setter Property="Text" Value="재학습 필요"/></DataTrigger>
                                </Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="1  기준 패턴 학습" FontWeight="SemiBold"/>
                        </DockPanel>
                        <TextBlock Text="{Binding TeachingSelectionText}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                        <UniformGrid Columns="2">
                            <Button x:Name="TrainButton" Content="선택 ROI 학습" Command="{Binding Train}" Style="{StaticResource PrimaryButton}" ToolTip="ROI 하나를 선택하세요. 라이브 영상은 정지 후 학습합니다." Margin="0,0,8,0"/>
                            <Button Content="모델 해제" Command="{Binding Clear}" Style="{StaticResource SecondaryButton}" Margin="0"/>
                        </UniformGrid>
                        <TextBlock Text="2  검색 범위와 조건" FontWeight="SemiBold" Margin="0,16,0,8"/>
                        <StackPanel IsEnabled="{Binding IsIdle}">
                            <CheckBox Content="선택 ROI 범위에서 찾기" IsChecked="{Binding UseSelection}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding SearchScopeText}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,4"/>
                            <TextBlock Text="범위 크기·여유는 위의 ‘영역’ 탭에서 변경" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,8,8">
                                    <TextBlock Text="최소 점수 (0~1)" Style="{StaticResource Caption}"/>
                                    <TextBox Text="{Binding MinimumScore, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최소 최종 매칭 점수"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,8">
                                    <TextBlock Text="최대 결과 (1~1000)" Style="{StaticResource Caption}"/>
                                    <TextBox Text="{Binding MaximumMatches, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최대 매칭 결과 수"/>
                                </StackPanel>
                            </UniformGrid>
                            <StackPanel Visibility="{Binding IsCpuMethod, Converter={StaticResource BoolVisibility}}">
                                <UniformGrid Columns="2" ToolTip="학습 방향을 기준으로 검색할 각도 범위입니다. 제품 합격/불량 허용각과는 별도입니다.">
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Text="검색각 최소 (°)" Style="{StaticResource Caption}"/>
                                        <TextBox Text="{Binding CpuMinimumAngle, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최소 회전 편차 (학습 ROI 기준 °)"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Text="검색각 최대 (°)" Style="{StaticResource Caption}"/>
                                        <TextBox Text="{Binding CpuMaximumAngle, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최대 회전 편차 (최대 폭 360°)"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="상세 설정">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,12,4,8" IsEnabled="{Binding IsIdle}">
                        <Expander Header="방식 안내 · 학습 모델" Margin="0,0,0,12">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="{Binding MethodDescription}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ModelSummary}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Expander>
                        <Expander Header="CPU · 배율과 정밀 검색" IsExpanded="False" Margin="0,0,0,10" Visibility="{Binding IsCpuMethod, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding IsIdle}">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="원본 사각형 학습 4~512px. 최대 8192×8192 전체 검색을 지원합니다. 기본 탭의 ‘선택 ROI 범위에서 찾기’를 끄면 전체를 검색합니다. 마스크 미지원." TextWrapping="Wrap" FontSize="10" Margin="0,0,0,8"/>
                                <TextBlock Text="각도·배율은 재학습 없이 변경됩니다. 검색 각도 범위는 불량 판정 허용각과 다릅니다. 아래 최소 점수·최대 결과 수·후보 수도 적용됩니다. 후보 수 16~16384, 점수 0 초과~1." TextWrapping="Wrap" FontSize="10" Margin="0,0,0,8"/>
                                <TextBlock Text="검색 각도 간격 (0.25~30°)" Style="{StaticResource Caption}"/>
                                <TextBox Text="{Binding CpuAngleStep, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="검색 각도 간격 (0.25~30°)" Margin="0,4,0,8"/>
                                <TextBlock Text="최소 배율 (0.5~2)" Style="{StaticResource Caption}"/>
                                <TextBox Text="{Binding CpuMinimumScale, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최소 배율 (0.5~2)" Margin="0,4,0,8"/>
                                <TextBlock Text="최대 배율 (0.5~2)" Style="{StaticResource Caption}"/>
                                <TextBox Text="{Binding CpuMaximumScale, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최대 배율 (0.5~2)" Margin="0,4,0,8"/>
                                <TextBlock Text="배율 간격 (0.01~0.5)" Style="{StaticResource Caption}"/>
                                <TextBox Text="{Binding CpuScaleStep, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="배율 간격 (0.01~0.5)" Margin="0,4,0,8"/>
                                <TextBlock Text="피라미드 단계 (1~5)" Style="{StaticResource Caption}"/>
                                <TextBox Text="{Binding CpuPyramidLevels, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="피라미드 단계 (1~5)" Margin="0,4,0,8"/>
                                <TextBlock Text="중복 억제 반경 (원본 px · 1 이상)" Style="{StaticResource Caption}"/>
                                <TextBox Text="{Binding CpuSuppressionRadius, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="중복 억제 반경 (원본 px · 1 이상)" Margin="0,4,0,8"/>
                            </StackPanel>
                        </Expander>
                        <Expander Header="알고리즘별 설정 · 변경 후 다시 학습" Margin="0,0,0,10" Visibility="{Binding IsCpuMethod, Converter={StaticResource BoolVisibility}}">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="선택한 방식에만 저장됩니다. 기본값은 기존 검출 조건과 같으며, 특징·표본 수나 허용치를 바꾸면 검출 결과가 달라질 수 있습니다." TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"/>
                                <StackPanel Visibility="{Binding IsCpuEdgeMethod, Converter={StaticResource BoolVisibility}}">
                                    <TextBlock Text="축소 특징 수 (16~512 · 기본 64)" Style="{StaticResource Caption}"/>
                                    <TextBox Text="{Binding CpuCoarseFeatures, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="축소 특징 수" Margin="0,4,0,8"/>
                                    <TextBlock Text="원본 특징 수 (16~512 · 기본 128)" Style="{StaticResource Caption}"/>
                                    <TextBox Text="{Binding CpuFineFeatures, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="원본 특징 수" Margin="0,4,0,8"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding IsCpuSubNcc, Converter={StaticResource BoolVisibility}}">
                                    <TextBlock Text="축소 표본 수 (16~512 짝수 · 기본 96)" Style="{StaticResource Caption}"/>
                                    <TextBox Text="{Binding CpuNccCoarseSamples, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Sub-NCC 축소 표본 수" Margin="0,4,0,8"/>
                                    <TextBlock Text="학습 최소 명암차 (1~255 · 기본 8)" Style="{StaticResource Caption}"/>
                                    <TextBox Text="{Binding CpuNccMinimumContrast, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Sub-NCC 학습 최소 명암차" Margin="0,4,0,8"/>
                                    <TextBlock Text="원본 정밀 검증은 항상 내부 픽셀 전체를 사용합니다." FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding IsCpuChamfer, Converter={StaticResource BoolVisibility}}">
                                    <TextBlock Text="축소 거리 단위 (0.6~8 px · 기본 5)" Style="{StaticResource Caption}"/>
                                    <TextBox Text="{Binding CpuChamferCoarseTolerance, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Chamfer 축소 거리 단위" Margin="0,4,0,8"/>
                                    <TextBlock Text="원본 거리 상한 (0.6~4 px · 기본 1)" Style="{StaticResource Caption}"/>
                                    <TextBox Text="{Binding CpuChamferFineTolerance, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Chamfer 원본 거리 상한" Margin="0,4,0,8"/>
                                    <TextBlock Text="방향 한 칸 비용 (0.1~8 · 기본 1.5)" Style="{StaticResource Caption}"/>
                                    <TextBox Text="{Binding CpuChamferDirectionPenalty, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Chamfer 방향 비용" Margin="0,4,0,8"/>
                                    <TextBlock Text="원본 양방향 윤곽 검증은 항상 유지됩니다." FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                        <Expander Header="학습 설정 · 변경 후 다시 학습" IsExpanded="False" Margin="0,0,0,10" Visibility="{Binding IsShapeMethod, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding IsIdle}">
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="검색 회전 편차 (학습 ROI 기준 · 최대 360°)" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                <UniformGrid Columns="2" Margin="0,5,0,10" IsEnabled="{Binding CanEditSearchAngle}">
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="최소 각도" Style="{StaticResource Caption}"/>
                                        <TextBox Text="{Binding MinimumAngle, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최소 검색 각도" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="최대 각도" Style="{StaticResource Caption}"/>
                                        <TextBox Text="{Binding MaximumAngle, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최대 검색 각도" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Text="각도 간격 (° · 0 초과, 45 이하)" Style="{StaticResource Caption}"/>
                                <TextBox Text="{Binding AngleStep, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="템플릿 각도 간격" Margin="0,5,0,10"/>
                                <CheckBox Content="균일 스케일 검색" IsChecked="{Binding EnableScale}" Margin="0,0,0,8"/>
                                <StackPanel IsEnabled="{Binding EnableScale}">
                                    <TextBlock Text="최소 / 최대 / 간격 (배율 · 최대 8)" Style="{StaticResource Caption}"/>
                                    <UniformGrid Columns="3" Margin="0,5,0,10">
                                        <TextBox Text="{Binding MinimumScale, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최소 배율" ToolTip="0보다 크고 최대 배율 이하여야 합니다." Margin="0,0,4,0"/>
                                        <TextBox Text="{Binding MaximumScale, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최대 배율" ToolTip="최소 배율 이상, 8 이하입니다." Margin="0,0,4,0"/>
                                        <TextBox Text="{Binding ScaleStep, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="템플릿 배율 간격" ToolTip="0보다 큰 배율 간격입니다."/>
                                    </UniformGrid>
                                </StackPanel>
                                <CheckBox Content="명암 반전 허용" IsChecked="{Binding IgnorePolarity}" Margin="0,0,0,10"/>
                                <Expander Header="윤곽 학습 고급" IsExpanded="False" Margin="0,0,0,10">
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="최대 특징 수 (12~512개)" Style="{StaticResource Caption}"/>
                                        <TextBox Text="{Binding MaximumFeatures, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최대 학습 특징 수" Margin="0,5,0,10"/>
                                        <TextBlock Text="최소 명암 경사 (0 초과)" Style="{StaticResource Caption}"/>
                                        <TextBox Text="{Binding MinimumGradient, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최소 학습 명암 경사" Margin="0,5,0,10" ToolTip="값을 높이면 약한 윤곽을 제외합니다. 낮추면 약한 윤곽과 잡음이 함께 늘어날 수 있습니다."/>
                                        <TextBlock Text="특징 최소 대비 비율 (0~1)" Style="{StaticResource Caption}"/>
                                        <TextBox Text="{Binding MinimumFeatureContrastRatio, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="특징 최소 대비 비율" Margin="0,5,0,10" ToolTip="기본값은 0.2입니다. 가장 강한 학습 에지에 대한 상대 강도로 방향 특징 후보를 추립니다. 0은 이 비율로 후보를 제외하지 않으며 최소 명암 경사·최대 특징 수·공간 분산 규칙은 유지됩니다. 전체 학습 윤곽·원본 마스크는 보존합니다. 값 변경 후 다시 학습하세요."/>
                                        <TextBlock Text="낮은 대비의 실제 세부까지 검사하려면 0으로 설정하고 다시 학습하세요. 기본 0.2에서는 제외된 세부가 없어도 높은 점수가 나올 수 있습니다." FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
                                        <TextBlock Text="회전·배율 템플릿 한도 (1~16384개)" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                        <TextBox Text="{Binding MaximumTemplates, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최대 학습 템플릿 수" Margin="0,5,0,10"/>
                                    </StackPanel>
                                </Expander>
                                <TextBlock Text="ROI 크기에 따라 축소 단계를 자동으로 선택합니다. 실제 단계 수는 모델 요약에 표시됩니다." FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </Expander>
                        <Border BorderBrush="#64748B" BorderThickness="1" Padding="8" Margin="0,0,0,10" Visibility="{Binding IsPaperMethod, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding IsIdle}">
                            <StackPanel>
                                <CheckBox Content="회전 불량 검사 · 변경 후 재학습" IsChecked="{Binding InspectRotation}" AutomationProperties.Name="회전 불량 검사" Margin="0,0,0,8"/>
                                <TextBlock Text="켜면 학습 방향 대비 전체 360°를 탐색하고 아래 정상 범위를 벗어난 검출을 NG로 표시합니다. 끄면 학습 설정의 검색 각도 범위만 사용합니다." TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                                <UniformGrid Columns="2" IsEnabled="{Binding InspectRotation}">
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="정상 최소 편차 (°)" Style="{StaticResource Caption}"/>
                                        <TextBox Text="{Binding MinimumAcceptedAngle, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="정상 최소 회전 편차" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="정상 최대 편차 (°)" Style="{StaticResource Caption}"/>
                                        <TextBox Text="{Binding MaximumAcceptedAngle, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="정상 최대 회전 편차" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Text="학습한 형상 자체가 대칭이면 방향을 구분할 수 없습니다. 방향을 구별하는 글자·몸체까지 ROI에 포함하세요. 점수는 일치도이며 회전 합격 여부와 별도로 표시합니다." TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Expander Header="PoseMatch-TDCM 설정" IsExpanded="False" Margin="0,0,0,10" Visibility="{Binding IsTdcmMethod, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding IsIdle}">
                            <StackPanel>
                                <TextBlock Text="학습 ROI 18~2048px · 비율 1:2~2:1 · 내부 36×36. 출력은 신경망의 추정이며 불량 판정은 별도 확인하세요." TextWrapping="Wrap" Margin="0,8"/>
                                <TextBlock Text="추론 장치 (CUDA는 NVIDIA CUDA 12 / cuDNN 9 필요)"/>
                                <TextBlock Text="추론 엔진"/>
                                <ComboBox ItemsSource="{Binding TdcmBackends}" SelectedItem="{Binding TdcmBackend}"/>
                                <ComboBox ItemsSource="{Binding TdcmDevices}" SelectedItem="{Binding TdcmDevice}"/>
                                <TextBlock Text="학습한 가중치 파일 (빈칸: 공식 모델)"/>
                                <TextBox Text="{Binding TdcmWeightsPath, UpdateSourceTrigger=LostFocus}" ToolTip="C# 가중치 학습 도구에서 저장한 .tdcm 파일 경로. TorchSharp에서 사용합니다."/>
                                <TextBlock Text="추론 창 크기 (224~1024, 4 배수)"/>
                                <TextBox Text="{Binding TdcmWindowSize, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="CPU 스레드 (1~32)"/>
                                <CheckBox Content="명암 기반 각도·X/Y 배율 보정 (추가 CPU 비용)" IsChecked="{Binding TdcmRefinePose}" Margin="0,8"/>
                                <TextBox Text="{Binding TdcmThreads, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="최대 검색 창 (1~65536, 초과 시 불완전 경고)"/>
                                <TextBox Text="{Binding TdcmMaximumWindows, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="중복 억제 반경 (축소 영상 px, 1~144)"/>
                                <TextBox Text="{Binding TdcmSuppressionRadius, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="중심 보정 반경 (축소 영상 px, 0~72)"/>
                                <TextBox Text="{Binding TdcmCenterRadius, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Expander>
                        <Expander Header="후보 예산 · 실행 제어" IsExpanded="False" Margin="0,0,0,10" IsEnabled="{Binding IsIdle}">
                            <StackPanel Margin="0,8,0,0">
                                <ComboBox ItemsSource="{Binding SpeedProfiles}" DisplayMemberPath="Name" SelectedValuePath="Profile" SelectedValue="{Binding SpeedProfile}" AutomationProperties.Name="후보 예산 프리셋" Margin="0,0,0,8"/>
                                <TextBlock Text="Line2D·Sub-NCC·Chamfer는 후보를 묶음으로 나누어 끝까지 검사합니다. 후보 수는 한 묶음의 크기이며 검출 개수를 제한하지 않습니다. 다른 방식은 기존 후보 예산을 사용합니다." TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                                <StackPanel Visibility="{Binding IsCpuMethod, Converter={StaticResource BoolVisibility}}">
                                    <ComboBox ItemsSource="{Binding ComputeModes}" DisplayMemberPath="Name" SelectedValuePath="Mode" SelectedValue="{Binding ComputeMode}" AutomationProperties.Name="템플릿 검사 실행 장치" Margin="0,0,0,8"/>
                                    <TextBlock Text="CPU+CUDA: 모든 후보 위치의 점수를 GPU로 계산하고, 위치·각도 보정과 원본 검증은 CPU가 수행합니다. 첫 실행에는 장치 준비 시간이 포함됩니다." TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding IsShapeMethod, Converter={StaticResource BoolVisibility}}">
                                    <ComboBox ItemsSource="{Binding ComputeModes}" DisplayMemberPath="Name" SelectedValuePath="Mode" SelectedValue="{Binding ComputeMode}" AutomationProperties.Name="검사 실행 장치" Margin="0,0,0,8"/>
                                    <TextBlock Text="CUDA는 방향별 후보 점수를 일괄 계산합니다. 전처리와 최종 위치·각도·형상 검증은 CPU 병렬 연산입니다. NVIDIA GPU가 필요합니다." TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                                    <TextBlock Text="CPU 최대 병렬도 (1~16)" Style="{StaticResource Caption}"/>
                                    <TextBox Text="{Binding MaximumParallelism, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="검사 CPU 병렬도" Margin="0,4,0,8"/>
                                </StackPanel>
                                <TextBlock Text="검사 시간 한도 (초 · 0은 제한 없음)" Style="{StaticResource Caption}" ToolTip="최초 CUDA 장치 준비 시간을 포함합니다. 시간 초과 시 진행 중인 연산이 안전하게 끝난 뒤 취소됩니다."/>
                                <TextBox Text="{Binding SearchTimeoutSeconds, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="검사 시간 한도" Margin="0,4,0,8"/>
                                <TextBlock Text="시간 초과는 검색 불완전 경고입니다. 진행 중인 GPU·네이티브 연산을 안전하게 마친 뒤 취소하므로 지정 시간을 넘길 수 있습니다." TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </Expander>
                        <Expander Header="공통 검색 고급 · 후보 수와 중복" IsExpanded="False" Margin="0,0,0,10">
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="후보 수 (세 CPU 방식: 묶음 크기 16~16384, 그 외: 최대 수)" Style="{StaticResource Caption}"/>
                                <TextBox Text="{Binding MaximumCandidates, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최대 검색 후보 수" Margin="0,5,0,10"/>
                                <TextBlock Text="허용 중복 비율 (IoU · 0~1)" Style="{StaticResource Caption}" Visibility="{Binding SupportsOverlapRatio, Converter={StaticResource BoolVisibility}}"/>
                                <TextBox Text="{Binding MaximumOverlap, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최대 검출 중복 비율" Margin="0,5,0,10" Visibility="{Binding SupportsOverlapRatio, Converter={StaticResource BoolVisibility}}" ToolTip="두 검출 영역의 교집합/합집합 비율입니다. 이 값을 넘는 중복 검출을 제거합니다."/>
                                <TextBlock Text="세 CPU 방식은 이 값이 작아도 다음 묶음으로 계속 검사하며, 점수·검색 영역·각도 조건은 유지합니다. 다른 방식은 후보 한도를 높이면 확인하는 위치와 비용이 늘어날 수 있습니다." FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </Expander>
                        <Expander Header="형상 검색 고급 · 후보와 방향" IsExpanded="False" Margin="0,0,0,10" Visibility="{Binding IsShapeMethod, Converter={StaticResource BoolVisibility}}">
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="최소 후보 점수 (0~1)" Style="{StaticResource Caption}"/>
                                <TextBox Text="{Binding CandidateThreshold, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최소 형상 후보 점수" Margin="0,5,0,10" ToolTip="축소 검색에서 원본 검증으로 넘길 후보 기준입니다. 최종 점수와 별도로 적용합니다."/>
                                <TextBlock Text="최소 방향 지지율 (0~1)" Style="{StaticResource Caption}"/>
                                <TextBox Text="{Binding MinimumSupport, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최소 방향 지지율" Margin="0,5,0,10"/>
                                <TextBlock Text="최대 형상 검증 후보 (1~4096개)" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                <TextBox Text="{Binding MaximumVerifiedCandidates, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최대 형상 검증 후보 수" Margin="0,5,0,10"/>
                                <TextBlock Text="최대 축소 검증 후보 (1~4096개)" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                <TextBox Text="{Binding MaximumCoarseVerifiedCandidates, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최대 축소 형상 검증 후보 수" Margin="0,5,0,10"/>
                                <CheckBox Content="검출 위치·자세 정밀화" IsChecked="{Binding Refine}" Margin="0,0,0,10"/>
                                <TextBlock Text="방향 점수는 윤곽 방향의 유사도, 방향 지지율은 방향이 일치하는 특징의 비율입니다. 검증 한도가 작으면 후보가 남아 검색 불완전 경고가 표시될 수 있습니다." FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </Expander>
                        <Expander Header="형상 점수 · 추가 윤곽 감점" IsExpanded="False" Margin="0,0,0,10" Visibility="{Binding IsShapeMethod, Converter={StaticResource BoolVisibility}}">
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="작은 논문 형상은 원본 세부 획 일치도 D를 추가 검증합니다. 최종 점수에 (1 − 비중 × (1−D))를 곱합니다. 비중 0은 세부 감점도 끕니다. 모델 요약에 적용 여부를 표시합니다." TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
                                <TextBlock Text="추가 윤곽 감점 비중 (0~1)" Style="{StaticResource Caption}"/>
                                <TextBox Text="{Binding ClutterWeight, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="추가 윤곽 감점 비중" Margin="0,5,0,10" ToolTip="대비 감점 비율은 설명되지 않은 장면 에지 강도² 합을 학습 마스크 안 전체 장면 에지 강도² 합으로 나눈 값입니다. 위치·방향 대응과 조명 보정 후 대비 허용 범위를 함께 평가합니다. 별도로 표시하는 개수 비율과는 다른 값입니다."/>
                                <TextBlock Text="윤곽 대응 허용 거리 (원본 px · 0.5~8)" Style="{StaticResource Caption}"/>
                                <TextBox Text="{Binding ClutterTolerancePixels, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="윤곽 대응 허용 거리" Margin="0,5,0,10"/>
                                <TextBlock Text="최종 점수 = 방향 점수 × (1 − 비중 × 추가 윤곽 대비 비율). 에지 강도의 제곱으로 가중합니다. 조명 보정 후에도 학습 윤곽보다 2배를 넘게 강한 에지는 대비가 설명되지 않은 것으로 봅니다. 기본 비중은 1이며 0은 감점하지 않습니다. 개수 비율은 따로 표시합니다. 점수는 전체 형상의 동일성이나 불량 확률이 아닙니다." TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource TextSecondary}" ToolTip="조명 보정 배율은 강한 학습 윤곽 최대 128개의 위치·방향 대응에서 장면 강도/학습 강도 비의 중앙값으로 정합니다. 대응이 없으면 1을 사용하며 추가 결함의 최대 강도로 보정하지 않습니다. 학습 영역 밖은 평가하지 않습니다."/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="결과">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,10">
                            <CheckBox Content="검사 위치 표시" IsChecked="{Binding ShowOverlay}" Margin="0,0,12,8"/>
                            <CheckBox Content="특징점 표시" IsChecked="{Binding ShowFeatures}" IsEnabled="{Binding IsShapeMethod}" Margin="0,0,0,8" ToolTip="학습된 윤곽 특징점을 검출된 위치·각도·배율로 변환해 표시합니다. 재검사 없이 켜고 끌 수 있습니다."/>
                        </WrapPanel>
                        <Button Content="검출 위치로 화면 맞춤" Command="{Binding Locate}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,10" ToolTip="검출된 모든 패턴이 보이도록 화면을 이동·확대합니다."/>
                        <TextBlock Text="점선: 검색 범위 / 실선: 검출된 패턴" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"/>
                        <Expander Header="검사 요약·안내" IsExpanded="False" Margin="0,0,0,8">
                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" Margin="0,6,4,0"/>
                            </ScrollViewer>
                        </Expander>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding ResultRows}" Margin="0,8,0,0" Visibility="{Binding HasResultRows, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="검출 위치와 점수 목록" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" HorizontalContentAlignment="Stretch" Grid.Row="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
            <TabItem Header="로그">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Content="로그 JSON 저장" Click="OnSaveInspectionLog" Margin="0,8,0,8" VerticalAlignment="Top">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Style.Triggers>
                            <DataTrigger Binding="{Binding IsTemplateMethod}" Value="True"><Setter Property="IsEnabled" Value="False"/><Setter Property="ToolTip" Value="OpenCV 검사 시간은 결과 탭에서 확인하세요."/></DataTrigger>
                        </Style.Triggers></Style></Button.Style>
                    </Button>
                    <TextBox Text="{Binding InspectionLogText, Mode=OneWay}" IsReadOnly="True" Height="Auto" TextWrapping="Wrap" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" AutomationProperties.Name="검사 단계별 시간 로그" Grid.Row="1" Style="{x:Null}" VerticalContentAlignment="Top" Padding="8"/>
                </Grid>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="0,12,0,8" Margin="0,8,0,0">
            <StackPanel>
                <Border BorderBrush="{Binding VerdictColor}" BorderThickness="3,0,0,0" Background="{StaticResource Shell}" Padding="10,6">
                    <StackPanel>
                        <TextBlock x:Name="OutcomeTitle" Text="{Binding PanelTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="OutcomeHint" Text="{Binding PanelHint}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" MaxHeight="62" ToolTip="{Binding PanelHint}"/>
                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,6,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
                    </StackPanel>
                </Border>
                <UniformGrid Columns="2" Margin="0,10,0,0">
                    <Button x:Name="SearchButton" Content="검사 실행" Command="{Binding Search}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" ToolTip="학습한 모델로 현재 원본 이미지를 검사합니다. 라이브 영상은 정지하세요."/>
                    <Button Content="취소" Command="{Binding Cancel}" Style="{StaticResource SecondaryButton}"/>
                </UniformGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
