<UserControl x:Class="TeachingToolWpf.Views.ShapeMatchingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Expander Header="패턴 학습 · 검사" IsExpanded="True" Margin="0,0,0,20">
        <StackPanel Margin="0,12,0,0">
            <TextBlock Text="{Binding ModelSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <Expander Header="학습 설정 · 변경 후 다시 학습" IsExpanded="False" Margin="0,0,0,10">
            <StackPanel IsEnabled="{Binding IsIdle}" Margin="0,10,0,0">
                <TextBlock Text="학습 ROI 기준 회전 편차 / 간격 (°)" Style="{StaticResource Caption}"/>
                <UniformGrid Columns="3" Margin="0,5,0,10">
                    <TextBox Text="{Binding MinimumAngle}" AutomationProperties.Name="최소 검색 각도" Margin="0,0,4,0"/>
                    <TextBox Text="{Binding MaximumAngle}" AutomationProperties.Name="최대 검색 각도" Margin="0,0,4,0"/>
                    <TextBox Text="{Binding AngleStep}" AutomationProperties.Name="템플릿 각도 간격"/>
                </UniformGrid>
                <CheckBox Content="균일 스케일 검색" IsChecked="{Binding EnableScale}" Margin="0,0,0,8"/>
                <UniformGrid Columns="2" IsEnabled="{Binding EnableScale}" Margin="0,0,0,10">
                    <TextBox Text="{Binding MinimumScale}" AutomationProperties.Name="최소 배율" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding MaximumScale}" AutomationProperties.Name="최대 배율"/>
                </UniformGrid>
                <CheckBox Content="명암 반전 허용" IsChecked="{Binding IgnorePolarity}" Margin="0,0,0,10"/>
            </StackPanel>
            </Expander>
            <Button Content="선택 ROI로 모델 학습" Command="{Binding Train}" Style="{StaticResource PrimaryButton}"
                    ToolTip="ROI 하나를 선택하세요. 라이브 영상은 정지 후 학습합니다." Margin="0,0,0,8"/>
            <Button Content="모델 해제" Command="{Binding Clear}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,16"/>
            <StackPanel IsEnabled="{Binding IsIdle}">
                <CheckBox Content="선택 ROI 안에서 기준점 검색" IsChecked="{Binding UseSelection}" Margin="0,0,0,10"/>
                <TextBlock Text="최소 최종 점수 / 최대 결과 수" Style="{StaticResource Caption}"/>
                <UniformGrid Columns="2" Margin="0,5,0,10">
                    <TextBox Text="{Binding MinimumScore}" AutomationProperties.Name="최소 최종 매칭 점수" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding MaximumMatches}" AutomationProperties.Name="최대 매칭 결과 수"/>
                </UniformGrid>
            </StackPanel>
            <UniformGrid Columns="2">
                <Button Content="검사 실행" Command="{Binding Search}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0"
                        ToolTip="학습한 모델로 현재 원본 이미지를 검사합니다. 라이브 영상은 정지하세요."/>
                <Button Content="취소" Command="{Binding Cancel}" Style="{StaticResource SecondaryButton}"/>
            </UniformGrid>
            <Border BorderBrush="{Binding VerdictColor}" BorderThickness="3,0,0,0" Background="#101820" Padding="10,8" Margin="0,14,0,10">
                <TextBlock Text="{Binding VerdictText}" Foreground="{Binding VerdictColor}" FontWeight="Bold" FontSize="16"/>
            </Border>
            <WrapPanel Margin="0,0,0,10">
                <CheckBox Content="검사 위치 표시" IsChecked="{Binding ShowOverlay}" Margin="0,0,12,8"/>
                <CheckBox Content="특징점 표시" IsChecked="{Binding ShowFeatures}" Margin="0,0,0,8"
                          ToolTip="학습된 윤곽 특징점을 검출된 위치·각도·배율로 변환해 표시합니다. 재검사 없이 켜고 끌 수 있습니다."/>
            </WrapPanel>
            <Button Content="검출 위치로 화면 맞춤" Command="{Binding Locate}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,10"
                    ToolTip="검출된 모든 패턴이 보이도록 화면을 이동·확대합니다."/>
            <TextBlock Text="정상 · LimeGreen / 불량 · Tomato&#10;경고 · Orange / 사용자 확인 · Gold" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10" Foreground="{StaticResource TextSecondary}"/>
            <TextBlock Text="{Binding Results}" TextWrapping="Wrap" FontSize="11"/>
        </StackPanel>
    </Expander>
</UserControl>
