<UserControl x:Class="TeachingToolWpf.Views.RoiPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:TeachingToolWpf.Controls">
    <Grid Background="White">
        <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="16,0" VerticalAlignment="Center">
            <Border DockPanel.Dock="Right" Background="{StaticResource Shell}" CornerRadius="5" Padding="7,3"><TextBlock Text="{Binding RoiCount}" FontSize="11" Foreground="{StaticResource TextSecondary}"/></Border>
            <TextBlock Text="영역" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <controls:RoiListBox x:Name="RoiList" Grid.Row="1" SelectionMode="Extended" Style="{StaticResource {x:Type ListBox}}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="ROI 계층 목록">
            <ListBox.ItemTemplate><DataTemplate><DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Kind}" Foreground="{StaticResource TextSecondary}" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0"/>
                <Border DockPanel.Dock="Left" Width="{Binding IndentWidth}"/>
                <Path DockPanel.Dock="Left" Data="{StaticResource DrawIcon}" Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.3" Margin="0,0,9,0"/>
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"/>
            </DockPanel></DataTemplate></ListBox.ItemTemplate>
        </controls:RoiListBox>
        <StackPanel Grid.Row="1" Margin="22,64,22,0" VerticalAlignment="Top">
            <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding HasRois}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <Border Width="44" Height="44" Background="{StaticResource AccentSoft}" CornerRadius="12" HorizontalAlignment="Left" Margin="0,0,0,16"><Path Data="{StaticResource DrawIcon}" Width="20" Height="20" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="1.5"/></Border>
            <TextBlock Text="첫 영역을 만들어 보세요" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Text="ROI를 바로 추가하거나, 그리기 도구로 이미지 위에 원하는 범위를 지정하세요." TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="11" LineHeight="19"/>
            <Button Content="부모 ROI 추가" Tag="{StaticResource AddIcon}" Command="{Binding AddRoi}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
        </StackPanel>
        <Border Grid.Row="2" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="12">
            <StackPanel>
                <TextBlock Text="추가할 도형" FontSize="11" Margin="2,0,0,6"/>
                <ComboBox ItemsSource="{Binding ShapeOptions}" DisplayMemberPath="Label" SelectedValuePath="Kind"
                          SelectedValue="{Binding SelectedShape}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="ROI 도형 선택"/>
                <WrapPanel Margin="0,6,0,0">
                    <Button Content="부모 추가" Command="{Binding AddRoi}" ToolTip="독립 ROI를 추가합니다. 폴리곤은 점을 클릭해 그리기를 시작합니다."/>
                    <Button Content="부모 그리기" Command="{Binding DrawTool}" ToolTip="새 부모 ROI를 그립니다. 사각형·원·삼각형: 드래그 / 폴리곤: 꼭짓점 클릭"/>
                </WrapPanel>
                <WrapPanel Margin="0,4,0,0">
                    <Button Content="자식 추가" Command="{Binding AddChildRoi}" ToolTip="부모로 사용할 ROI 하나를 먼저 선택하세요. 폴리곤은 점을 클릭해 자식을 그립니다." ToolTipService.ShowOnDisabled="True"/>
                    <Button Content="자식 그리기" Command="{Binding DrawChildRoi}" ToolTip="ROI 하나를 선택한 뒤 해당 ROI의 자식을 그립니다." ToolTipService.ShowOnDisabled="True"/>
                </WrapPanel>
                <TextBlock Text="자식 추가: 부모로 쓸 ROI 1개 선택" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="2,4,0,0"/>
                <TextBlock Text="폴리곤: 점 클릭으로 연결 · 선 교차 시 자동 완성" TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="2,4,0,0"/>
                <WrapPanel Margin="0,4,0,10">
                    <Button Content="완료" Command="{Binding CompletePolygon}" ToolTip="폴리곤 확정 · Enter · 꼭짓점 3개 이상"/>
                    <Button Content="점 취소" Command="{Binding RemovePolygonPoint}" ToolTip="마지막 꼭짓점 제거 · Backspace"/>
                    <Button Content="취소" Command="{Binding CancelPolygon}" ToolTip="폴리곤 그리기 취소 · Esc"/>
                </WrapPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Left" Content="‹" Command="{Binding PreviousRowPage}" ToolTip="이전 512개 영역" AutomationProperties.Name="이전 ROI 페이지"/>
                    <Button DockPanel.Dock="Right" Content="›" Command="{Binding NextRowPage}" ToolTip="다음 512개 영역" AutomationProperties.Name="다음 ROI 페이지"/>
                    <TextBlock Text="{Binding RowPageLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                </DockPanel>
                <Button Content="모두 선택" Command="{Binding SelectAll}" HorizontalAlignment="Left"/>
                <WrapPanel Margin="0,6,0,0">
                    <Button Content="복사" Command="{Binding Copy}" ToolTip="선택 ROI와 자손 복사 · Ctrl+C"/>
                    <Button Content="붙여넣기" Command="{Binding Paste}" ToolTip="복사한 ROI 붙여넣기 · Ctrl+V" Margin="6,0,0,0"/>
                </WrapPanel>
                <WrapPanel Margin="0,6,0,4">
                    <Button Tag="{StaticResource GroupIcon}" Command="{Binding Group}" ToolTip="새 부모로 그룹화 · Ctrl+G" AutomationProperties.Name="부모로 그룹화" Style="{StaticResource IconButton}"/>
                    <Button Tag="{StaticResource UngroupIcon}" Command="{Binding Ungroup}" ToolTip="그룹 해제 · 자식은 유지 · Ctrl+Shift+G" AutomationProperties.Name="그룹 해제" Style="{StaticResource IconButton}"/>
                    <Button Tag="{StaticResource DeleteIcon}" Command="{Binding Delete}" ToolTip="선택과 모든 자손 삭제 · Delete" AutomationProperties.Name="ROI 삭제" Style="{StaticResource IconButton}"/>
                </WrapPanel>
                <TextBlock Text="Ctrl / Shift로 여러 영역 선택" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="2,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
