<UserControl x:Class="TeachingToolWpf.Views.RoiStylePanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:TeachingToolWpf.Controls">
    <StackPanel>
        <TextBlock Text="ROI 색상과 선 두께" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Text="4단계 계층의 색상과 선택 상태를 각각 설정합니다. 부모 없는 ROI도 자식 ROI 색상을 사용합니다." TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,16"/>
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
            <TextBlock Text="역할" Style="{StaticResource Caption}"/>
            <TextBlock Grid.Column="1" Text="선택 안 됨" Style="{StaticResource Caption}"/>
            <TextBlock Grid.Column="2" Text="단일 선택" Style="{StaticResource Caption}"/>
            <TextBlock Grid.Column="3" Text="다중 선택" Style="{StaticResource Caption}"/>
            <TextBlock Grid.Column="4" Text="두께 (DIP)" Style="{StaticResource Caption}"/>
        </Grid>
        <ItemsControl ItemsSource="{Binding Roles}">
            <ItemsControl.ItemTemplate><DataTemplate>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" MaxLength="9" AutomationProperties.Name="{Binding Name, StringFormat={}{0} 기본 색상}"/>
                    <TextBox Grid.Column="2" Text="{Binding SelectedColor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" MaxLength="9" AutomationProperties.Name="{Binding Name, StringFormat={}{0} 단일 선택 색상}"/>
                    <TextBox Grid.Column="3" Text="{Binding MultiSelectedColor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" MaxLength="9" AutomationProperties.Name="{Binding Name, StringFormat={}{0} 다중 선택 색상}"/>
                    <controls:ValueTextBox Grid.Column="4" Style="{StaticResource ValueTextBoxStyle}" Value="{Binding Thickness, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Name, StringFormat={}{0} 선 두께}" ToolTip="0.5~8 DIP · 선택 시 0.5 DIP 추가"/>
                </Grid>
            </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="색상: #RRGGBB 또는 #AARRGGBB · 예: #FFB82E (주황)" Style="{StaticResource Caption}" Margin="0,4,0,8"/>
        <TextBlock Text="RootGroup(검사 전체) → ModuleGroup(모듈) → RoiGroup(부모) → Roi(자식), 최대 4단계입니다. 공통 표시는 축소 요약·반복 ROI·다중 선택 외곽선과 핸들에 적용됩니다." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondary}" LineHeight="18"/>
        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="Firebrick" FontSize="11" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="ROI 표시 적용" Command="{Binding Apply}" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="ROI 표시 설정 적용"/>
            <Button Content="ROI 기본값" Command="{Binding Reset}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" AutomationProperties.Name="ROI 표시 설정 기본값 복원"/>
        </StackPanel>
    </StackPanel>
</UserControl>
