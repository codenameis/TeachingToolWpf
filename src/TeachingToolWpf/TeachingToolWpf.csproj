<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TeachingToolWpf.Presentation\TeachingToolWpf.Presentation.csproj" />
    <ProjectReference Include="..\TeachingToolWpf.Diagnostics\TeachingToolWpf.Diagnostics.csproj" />
    <ProjectReference Include="..\CpuMatching.Cuda\CpuMatching.Cuda.csproj" />
    <ProjectReference Include="..\VisionCanvas.Core\VisionCanvas.Core.csproj" />
    <ProjectReference Include="..\VisionCanvas\VisionCanvas.csproj" />
    <ProjectReference Include="..\VisionCanvas.Filters.Wpf\VisionCanvas.Filters.Wpf.csproj" />
    <ProjectReference Include="..\VisionAlgorithm\VisionAlgorithm.csproj" />
    <ProjectReference Include="..\VisionInspection\VisionInspection.csproj" />
    <ProjectReference Include="..\VisionCompute.ILGPU\VisionCompute.ILGPU.csproj" />
    <ProjectReference Include="..\..\IndustrialVision.Filters\src\IndustrialVision.Filters.Gpu.ILGPU\IndustrialVision.Filters.Gpu.ILGPU.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md;..\..\THIRD-PARTY-NOTICES.md" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\AGENTS.md;..\..\Agent.MD" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Include="..\..\licenses\**\*" Exclude="..\..\licenses\NetVips*;..\..\licenses\LGPL-3.0.txt;..\..\licenses\GPL-3.0.txt;..\..\licenses\skia\**\*" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\docs\**\*.md;..\..\docs\**\*.json;..\..\docs\**\*.csv;..\..\docs\**\*.zip" Link="docs\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Include="..\..\tasks\*.md" Link="tasks\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Include="..\..\scripts\Summarize-*.ps1" Link="scripts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\pattern-matching.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Assets\primitive-shapes.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Assets\edge-fewshot-single-board.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="../../build/InspectionNativeRuntime.props" />
</Project>
