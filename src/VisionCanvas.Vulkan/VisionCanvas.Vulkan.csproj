<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../VisionCanvas.Host/VisionCanvas.Host.csproj" />
    <PackageReference Include="Vortice.Vulkan" Version="3.2.3" />
    <PackageReference Include="Vortice.ShaderCompiler" Version="1.9.0" />
    <InternalsVisibleTo Include="VisionCanvas.Vulkan.Tests" />
    <None Update="Shaders/*.hlsl" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
