<UserControl x:Class="VisionCanvas.Controls.AlignmentTestPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#EEF2F7" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,4,0,6">
        <Expander IsExpanded="{Binding IsPanelExpanded, Mode=TwoWay}"
                  Header="보정 테스트 페이지 · 전체 / 모듈 / 컴포넌트 계층 보정 (X, Y, Theta 픽셀·각도 입력 · 1억~100억 ROI 무관)">
            <StackPanel Margin="0,8,0,0">
                <WrapPanel Margin="0,0,0,6">
                    <TextBlock Text="테스트 규모:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,4" />
                    <ComboBox ItemsSource="{Binding ScalePresets}" SelectedItem="{Binding SelectedScalePreset, Mode=TwoWay}"
                              DisplayMemberPath="Name" Width="210" MinHeight="30" Margin="0,0,8,4" VerticalContentAlignment="Center" />
                    <Button Content="계층 보정 프리셋 로드" Command="{Binding LoadPresetCommand}"
                            Padding="10,5" Margin="0,0,14,4" FontWeight="SemiBold"
                            ToolTip="8K 영상 위에 보드(전체) → 모듈 A/B → 컴포넌트 4개 + 보정마크 + 초고밀도 ROI 배치를 구성합니다." />

                    <TextBlock Text="보정 범위:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,4" />
                    <ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding SelectedScope, Mode=TwoWay}"
                              DisplayMemberPath="Name" Width="250" MinHeight="30" Margin="0,0,6,4" VerticalContentAlignment="Center"
                              AutomationProperties.Name="보정 대상 범위 선택" />
                    <Button Content="범위 보기" Command="{Binding FocusScopeCommand}" Padding="8,5" Margin="0,0,12,4" />
                    <CheckBox Content="보정마크 있음 (체크 해제 시 상위 보정 상속)"
                              IsChecked="{Binding IsMarkEnabled, Mode=TwoWay}"
                              VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,4" />
                </WrapPanel>

                <WrapPanel Margin="0,0,0,6">
                    <TextBlock Text="X (px):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,4" />
                    <TextBox Text="{Binding DeltaXText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="68" MinHeight="28" VerticalContentAlignment="Center" Margin="0,0,4,4"
                             AutomationProperties.Name="X 픽셀 보정값" />
                    <Button Content="-10" Command="{Binding NudgeCommand}" CommandParameter="X:-10" Padding="6,4" Margin="0,0,2,4" />
                    <Button Content="-1" Command="{Binding NudgeCommand}" CommandParameter="X:-1" Padding="6,4" Margin="0,0,2,4" />
                    <Button Content="+1" Command="{Binding NudgeCommand}" CommandParameter="X:1" Padding="6,4" Margin="0,0,2,4" />
                    <Button Content="+10" Command="{Binding NudgeCommand}" CommandParameter="X:10" Padding="6,4" Margin="0,0,14,4" />

                    <TextBlock Text="Y (px):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,4" />
                    <TextBox Text="{Binding DeltaYText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="68" MinHeight="28" VerticalContentAlignment="Center" Margin="0,0,4,4"
                             AutomationProperties.Name="Y 픽셀 보정값" />
                    <Button Content="-10" Command="{Binding NudgeCommand}" CommandParameter="Y:-10" Padding="6,4" Margin="0,0,2,4" />
                    <Button Content="-1" Command="{Binding NudgeCommand}" CommandParameter="Y:-1" Padding="6,4" Margin="0,0,2,4" />
                    <Button Content="+1" Command="{Binding NudgeCommand}" CommandParameter="Y:1" Padding="6,4" Margin="0,0,2,4" />
                    <Button Content="+10" Command="{Binding NudgeCommand}" CommandParameter="Y:10" Padding="6,4" Margin="0,0,14,4" />

                    <TextBlock Text="Theta (°):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,4" />
                    <TextBox Text="{Binding DeltaThetaText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="68" MinHeight="28" VerticalContentAlignment="Center" Margin="0,0,4,4"
                             AutomationProperties.Name="Theta 회전 각도 보정값" />
                    <Button Content="-5°" Command="{Binding NudgeCommand}" CommandParameter="Theta:-5" Padding="6,4" Margin="0,0,2,4" />
                    <Button Content="-1°" Command="{Binding NudgeCommand}" CommandParameter="Theta:-1" Padding="6,4" Margin="0,0,2,4" />
                    <Button Content="+1°" Command="{Binding NudgeCommand}" CommandParameter="Theta:1" Padding="6,4" Margin="0,0,2,4" />
                    <Button Content="+5°" Command="{Binding NudgeCommand}" CommandParameter="Theta:5" Padding="6,4" Margin="0,0,14,4" />

                    <Button Content="보정 적용" Command="{Binding ApplyCommand}" Padding="12,5" Margin="0,0,6,4" FontWeight="SemiBold" />
                    <Button Content="선택 범위 초기화" Command="{Binding ResetScopeCommand}" Padding="10,5" Margin="0,0,6,4" />
                    <Button Content="전체 보정 초기화" Command="{Binding ResetAllCommand}" Padding="10,5" Margin="0,0,0,4" />
                </WrapPanel>

                <TextBlock Text="{Binding TransformSummary}" Foreground="#1E293B" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,2" />
                <TextBlock Text="{Binding SampleCellsSummary}" Foreground="#334155" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </Expander>
    </Border>
</UserControl>
