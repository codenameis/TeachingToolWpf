<UserControl x:Class="VisionCanvas.Controls.ViewportNavigationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <WrapPanel Margin="0,4">
        <CheckBox Content="검사 화면 잠금" IsChecked="{Binding IsLocked, Mode=TwoWay}"
                  VerticalAlignment="Center" Margin="4,0,12,0"
                  ToolTip="영상 갱신을 유지하면서 캔버스 키·선택·편집·이동·휠을 차단합니다. 해제하려면 다시 누르세요." />
        <TextBlock Text="ROI 위치 보기" VerticalAlignment="Center" Margin="0,0,6,0" />
        <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding Target, Mode=TwoWay}"
                  DisplayMemberPath="Name" Width="180" MinHeight="28" Margin="0,0,6,0"
                  IsEnabled="{Binding CanNavigate}" DropDownOpened="OnDropDownOpened"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True" AutomationProperties.Name="선택 없이 볼 ROI 목록">
            <ComboBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ComboBox.ItemsPanel>
        </ComboBox>
        <Button Content="ROI 맞춤" Command="{Binding FocusCommand}" Padding="8,4" Margin="0,0,6,0" />
        <Button Content="전체 보기" Command="{Binding FitCommand}" Padding="8,4" Margin="0" />
    </WrapPanel>
</UserControl>
