<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../VisionCanvas.Host/VisionCanvas.Host.csproj" />
    <PackageReference Include="Alimer.Bindings.WebGPU" Version="1.6.0" />
    <PackageReference Include="Alimer.WebGPU.Native" Version="1.0.4" />
    <InternalsVisibleTo Include="VisionCanvas.Wgpu.Tests" />
    <None Update="Shaders/*.wgsl" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
