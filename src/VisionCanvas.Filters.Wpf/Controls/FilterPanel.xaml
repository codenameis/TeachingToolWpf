<UserControl x:Class="VisionCanvas.Filters.Wpf.Controls.FilterPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:VisionCanvas.Filters.Wpf.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>
        <SolidColorBrush x:Key="Stroke" Color="#E2E8F0"/>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#334155"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="local:ParameterSlider">
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="BeginEditCommand" Value="{Binding BeginParameterEdit}"/>
            <Setter Property="EndEditCommand" Value="{Binding EndParameterEdit}"/>
            <Setter Property="CancelEditCommand" Value="{Binding CancelParameterEdit}"/>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="? 매뉴얼" Command="{Binding ToggleHelpManual}" Padding="7,2" Margin="6,0,0,0" FontSize="10.5" FontWeight="Bold" Background="#EBF1FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE" ToolTip="다단계 전처리 파이프라인 및 선(先)필터→후(後)검사 규칙 매뉴얼 펼치기/닫기"/>
            <Border DockPanel.Dock="Right" Background="#EBF1FF" CornerRadius="4" Padding="6,3"><TextBlock Text="IndustrialVision" Foreground="#2463EB" FontSize="9" FontWeight="SemiBold"/></Border>
            <TextBlock Text="ROI 전처리 필터 파이프라인" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>

        <Border x:Name="HelpManualBorder" Visibility="Collapsed" Background="#F8FAFC" BorderBrush="#93C5FD" BorderThickness="3,1,1,1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHelpManualOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="다단계 전처리 파이프라인 &amp; 선(先)필터 → 후(後)검사 규칙" FontWeight="Bold" FontSize="11" Foreground="#1E40AF" Margin="0,0,0,4"/>
                <TextBlock Text="• 필터 리스트에 들어간 활성 필터들은 모든 본검사(패턴 매칭, 도형 검출, Few-Shot, 정밀 계측/OCR/바코드) 실행 직전에 순서대로 먼저 수행됩니다." FontSize="10.5" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,3"/>
                <TextBlock Text="• 검사가 늦어지면 리스트에서 무거운 필터의 체크박스를 끄거나 [삭제] 버튼으로 빼면 즉시 우회되어 원래 속도로 복구됩니다." FontSize="10.5" Foreground="#B45309" TextWrapping="Wrap" Margin="0,0,0,3"/>
                <TextBlock Text="• 신규 추가 필터: 2D FFT Periodic Notch(모아레/메쉬 격자 제거), Homomorphic(조명·반사율 분리), 2D Gabor(방향성 크랙 강조)." FontSize="10.5" Foreground="#047857" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <CheckBox Content="선(先)필터 → 후(後)검사 자동 적용 (본검사 전 필터 리스트 선행)" IsChecked="{Binding PreFilterBeforeInspection, Mode=TwoWay}" FontWeight="SemiBold" Foreground="#0F766E" Margin="0,0,0,6"/>
        <TextBlock Text="{Binding PipelineSummaryText}" FontSize="10.5" Foreground="#1D4ED8" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <!-- Ordered Multi-Filter Pipeline List -->
        <Border Background="#F8FAFC" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="＋ 리스트에 추가" Command="{Binding AddStepToPipeline}" Padding="8,3" FontSize="10.5" Background="#2563EB" Foreground="White" BorderThickness="0"/>
                    <TextBlock Text="전처리 필터 리스트 (순차 실행)" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <ListBox ItemsSource="{Binding PipelineSteps}" SelectedItem="{Binding SelectedPipelineStep, Mode=TwoWay}" MaxHeight="130" BorderBrush="{StaticResource Stroke}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True" Margin="0,1">
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="체크 해제 시 이 필터를 건너뛰어 검사 속도를 즉시 확보합니다"/>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding StepBadge}" FontWeight="Bold" Foreground="#2563EB" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding SummaryText}" FontSize="10.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <UniformGrid Columns="3" Margin="0,6,0,0">
                    <Button Content="↑ 위로" Command="{Binding MoveSelectedStepUp}" Padding="6,3" FontSize="10.5" Margin="0,0,3,0"/>
                    <Button Content="↓ 아래로" Command="{Binding MoveSelectedStepDown}" Padding="6,3" FontSize="10.5" Margin="2,0"/>
                    <Button Content="✕ 선택 제거" Command="{Binding RemoveSelectedStep}" Padding="6,3" FontSize="10.5" Margin="3,0,0,0"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Live ROI Histogram & 1D Line Profile Summary -->
        <Border Background="#F8FAFC" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="실시간 ROI 히스토그램(Otsu) &amp; 1D 중심선 프로파일" FontSize="10.5" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,3"/>
                <TextBlock Text="{Binding RoiHistogramSummaryText}" FontSize="10" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding RoiLineProfileSummaryText}" FontSize="10" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ComboBox ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedValuePath="Kind" SelectedValue="{Binding SelectedFilter}" ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="ROI 필터 선택"/>
        <ToggleButton x:Name="PreviewToggle" IsChecked="{Binding IsPreviewEnabled, Mode=TwoWay}" AutomationProperties.Name="실시간 필터 미리보기" Margin="0,12,0,0" Padding="12,8">
            <ToggleButton.Style>
                <Style TargetType="ToggleButton">
                    <Setter Property="Content" Value="미리보기 OFF · 원본"/>
                    <Setter Property="Background" Value="#F1F5F9"/>
                    <Setter Property="Foreground" Value="#334155"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Content" Value="미리보기 ON · 자동 갱신"/>
                            <Setter Property="Background" Value="#2563EB"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ToggleButton.Style>
        </ToggleButton>
        <TextBlock Text="서로 다른 설정 · 각 ROI 필터로 표시 중" Visibility="{Binding HasMixedFilters, Converter={StaticResource BoolVisibility}}" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
        <StackPanel Visibility="{Binding IsIndustrial, Converter={StaticResource BoolVisibility}}" Margin="0,12,0,0">
            <TextBlock Text="실행 모드 · CpuGpu는 CUDA 요청, 불가 시 사유 표시" TextWrapping="Wrap" Style="{StaticResource Caption}"/>
            <ComboBox ItemsSource="{Binding ExecutionOptions}" SelectedItem="{Binding Execution}" AutomationProperties.Name="필터 실행 모드"/>
        </StackPanel>
        <StackPanel Visibility="{Binding UsesRadius, Converter={StaticResource BoolVisibility}}" Margin="0,12,0,0">
            <TextBlock Text="반경 · 1–31 (커널 크기 2r+1, 미리보기 픽셀)" TextWrapping="Wrap" Style="{StaticResource Caption}"/>
            <TextBox x:Name="RadiusInput" Text="{Binding Radius, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="필터 반경"/>
            <local:ParameterSlider x:Name="RadiusSlider" Minimum="1" Maximum="31" SmallChange="1" LargeChange="2" Value="{Binding RadiusValue, Mode=TwoWay}" AutomationProperties.Name="필터 반경 조절"/>
        </StackPanel>
        <StackPanel Visibility="{Binding UsesSigma, Converter={StaticResource BoolVisibility}}" Margin="0,12,0,0">
            <TextBlock Text="Gaussian sigma · 0 초과–100 이하" Style="{StaticResource Caption}"/>
            <TextBox x:Name="SigmaInput" Text="{Binding Sigma, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Gaussian sigma"/>
            <local:ParameterSlider Minimum="0.01" Maximum="100" SmallChange="0.1" LargeChange="1" Value="{Binding SigmaValue, Mode=TwoWay}" AutomationProperties.Name="Gaussian sigma 조절"/>
        </StackPanel>
        <StackPanel Visibility="{Binding UsesThreshold, Converter={StaticResource BoolVisibility}}" Margin="0,12,0,0">
            <TextBlock Text="{Binding ThresholdCaption}" TextWrapping="Wrap" Style="{StaticResource Caption}"/>
            <TextBox x:Name="ThresholdInput" Text="{Binding Threshold, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="이진화 임계값"/>
            <local:ParameterSlider Minimum="0" Maximum="{Binding ThresholdMaximum}" SmallChange="1" LargeChange="10" Value="{Binding ThresholdValue, Mode=TwoWay}" AutomationProperties.Name="임계값 조절"/>
        </StackPanel>
        <Grid Visibility="{Binding IsEdge, Converter={StaticResource BoolVisibility}}" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Edge 하한" Style="{StaticResource Caption}"/><TextBox Text="{Binding EdgeLow, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Edge 하한"/><local:ParameterSlider Minimum="0" Maximum="255" SmallChange="1" Value="{Binding EdgeLowValue, Mode=TwoWay}" AutomationProperties.Name="Edge 하한 조절"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Edge 상한" Style="{StaticResource Caption}"/><TextBox Text="{Binding EdgeHigh, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Edge 상한"/><local:ParameterSlider Minimum="0" Maximum="255" SmallChange="1" Value="{Binding EdgeHighValue, Mode=TwoWay}" AutomationProperties.Name="Edge 상한 조절"/></StackPanel>
        </Grid>
        <Button Content="등록 해제" Command="{Binding ClearRegistration}" HorizontalAlignment="Left" ToolTip="선택된 모든 ROI의 필터 등록 해제 · Undo 가능" Margin="0,6,0,0"/>
        <Button Content="설정 적용" Command="{Binding Apply}" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" ToolTip="선택 ROI에 설정 등록 · 미리보기 토글 상태 유지"/>
        <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" Foreground="#B91C1C" FontSize="11" Margin="0,6,0,0"/>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="10" LineHeight="17" Foreground="{StaticResource TextSecondary}" Margin="0,10,0,0"/>
        <TextBlock Text="ON: ROI 이동·회전·크기·파라미터 자동 갱신&#x0a;슬라이더를 놓으면 한 번 확정 · Esc로 취소&#x0a;OFF: 선택을 바꿔도 원본 유지&#x0a;최대 1,024 px · 라이브 최대 5회/초 · 검사 원본과 별도&#x0a;Gray16 연산 후 표시만 8비트 · 최초 CUDA 준비 포함" TextWrapping="Wrap" FontSize="10" LineHeight="17" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
        <Border Height="1" Background="{StaticResource Stroke}" Margin="0,20"/>
    </StackPanel>
</UserControl>
