<ui:FluentWindow x:Class="TeachingToolWpf.Fluent2.Views.Fluent2StudioWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:canvas="clr-namespace:VisionCanvas.Controls;assembly=VisionCanvas"
                 xmlns:canvasHost="clr-namespace:VisionCanvas.Controls;assembly=VisionCanvas.Host"
                 xmlns:controls="clr-namespace:TeachingToolWpf.Controls;assembly=TeachingToolWpf.Presentation"
                 xmlns:views="clr-namespace:TeachingToolWpf.Fluent2.Views"
                 Title="Vision Teaching Studio · Fluent 2 Design System (Mica)"
                 Width="1880"
                 Height="1020"
                 MinWidth="1280"
                 MinHeight="760"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 FontFamily="Segoe UI Variable, Segoe UI, Malgun Gothic"
                 UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- Row 0: Fluent 2 Integrated TitleBar + Theme Switcher (ApplicationThemeManager) -->
        <ui:TitleBar Grid.Row="0"
                     Title="Vision Teaching Studio · Fluent 2 Design System (Mica)">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <ui:Button Command="{Binding ApplyLightTheme}"
                               Appearance="Secondary"
                               Content="☀ Light"
                               CornerRadius="{StaticResource Fluent2ControlCornerRadius}"
                               Padding="8,4"
                               Margin="0,0,4,0"
                               ToolTip="ApplicationThemeManager.Apply(ApplicationTheme.Light, WindowBackdropType.Mica)" />
                    <ui:Button Command="{Binding ApplyDarkTheme}"
                               Appearance="Secondary"
                               Content="🌙 Dark"
                               CornerRadius="{StaticResource Fluent2ControlCornerRadius}"
                               Padding="8,4"
                               Margin="0,0,4,0"
                               ToolTip="ApplicationThemeManager.Apply(ApplicationTheme.Dark, WindowBackdropType.Mica)" />
                    <ui:Button Command="{Binding ToggleTheme}"
                               Appearance="Secondary"
                               Content="{Binding ThemeBadgeText}"
                               CornerRadius="{StaticResource Fluent2ControlCornerRadius}"
                               Padding="10,4"
                               ToolTip="라이트 / 다크 테마 토글 (ApplicationThemeManager)" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Row 1: Fluent 2 Top Command Bar (CornerRadius=8 Layer Card, 1920x1080 Single-Line Optimized) -->
        <Border Grid.Row="1"
                Margin="10,2,10,0"
                Style="{StaticResource Fluent2SurfaceCardStyle}"
                Padding="10,5">
            <DockPanel VerticalAlignment="Center">
                <!-- Right: Global Inspection Scope Toggle + Quick Multi-ROI Inspect + SIMD Readiness Pill + Undo/Redo -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Fluent2ControlCornerRadius}"
                            Padding="8,2"
                            Margin="0,0,6,0"
                            ToolTip="{Binding Studio.Inspections.SearchScopeSummaryText}">
                        <CheckBox Content="전체 이미지 검사"
                                  IsChecked="{Binding Studio.Inspections.SearchFullImage, Mode=TwoWay}"
                                  IsEnabled="{Binding Studio.Inspections.IsIdle}"
                                  FontSize="10.5"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center" />
                    </Border>
                    <ui:Button Content="{Binding Studio.Inspections.QuickInspectLabel}"
                               Command="{Binding Studio.Inspections.ExecuteActiveToolOnRois}"
                               Appearance="Primary"
                               Style="{StaticResource Fluent2UiButtonStyle}"
                               Margin="0,0,6,0"
                               ToolTip="단일 ROI 선택 시 해당 ROI를, 다중 선택 또는 미선택(0개) 시 대상 리프 ROI들을 각각 개별 검사합니다." />
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{Binding ReadinessAccent}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Fluent2ControlCornerRadius}"
                            Padding="8,3"
                            Margin="0,0,6,0"
                            ToolTip="{Binding ReadinessDetail}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{Binding ReadinessAccent}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="{Binding ReadinessBadge}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ui:Button Content="↶ 실행취소"
                               Command="{Binding Studio.Undo}"
                               Style="{StaticResource Fluent2UiButtonStyle}"
                               ToolTip="{Binding Studio.UndoHint}"
                               Margin="0,0,4,0" />
                    <ui:Button Content="↷ 다시실행"
                               Command="{Binding Studio.Redo}"
                               Style="{StaticResource Fluent2UiButtonStyle}"
                               ToolTip="{Binding Studio.RedoHint}" />
                </StackPanel>

                <!-- Left: Studio Brand + Current Image Summary -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Border Width="26"
                            Height="26"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            CornerRadius="{StaticResource Fluent2ControlCornerRadius}"
                            Margin="0,0,8,0">
                        <Path Data="M5,14 L10,19 21,7"
                              Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                              StrokeThickness="2.2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Fluent 2 Vision Studio" FontSize="12.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Studio.ImageDetails}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Center: 1-Click Source & Sample Bar -->
                <WrapPanel VerticalAlignment="Center">
                    <ui:Button Content="열기" Command="{Binding Studio.OpenImage}" Style="{StaticResource Fluent2UiButtonStyle}" Margin="0,0,4,0" />
                    <ui:Button Content="8K" Command="{Binding Studio.Sample8K}" Style="{StaticResource Fluent2UiButtonStyle}" Margin="0,0,4,0" ToolTip="8,192 × 8,192 합성 검사 이미지" />
                    <ui:Button Content="24K" Command="{Binding Studio.Sample24K}" Style="{StaticResource Fluent2UiButtonStyle}" Margin="0,0,4,0" ToolTip="24,576 × 32,768 초대형 이미지" />
                    <ui:Button Content="패턴 샘플" Command="{Binding Studio.PatternSample}" Style="{StaticResource Fluent2UiButtonStyle}" Margin="0,0,4,0" />
                    <ui:Button Content="도형 샘플" Command="{Binding Studio.PrimitiveSample}" Style="{StaticResource Fluent2UiButtonStyle}" Margin="0,0,4,0" />
                    <ui:Button Content="Few-Shot" Command="{Binding Studio.FewShotSample}" Style="{StaticResource Fluent2UiButtonStyle}" Margin="0,0,4,0" />
                    <ui:Button Content="7종 스위트" Command="{Binding Studio.SuiteSample}" Style="{StaticResource Fluent2UiButtonStyle}" Margin="0,0,4,0" />
                    <ui:Button Content="1억 ROI" Command="{Binding Studio.AddRepeatedTest}" Style="{StaticResource Fluent2UiButtonStyle}" Margin="0,0,6,0" ToolTip="100,020,001개 압축 반복 셀 배치 추가" />
                    <ComboBox ItemsSource="{Binding Studio.LiveFormats}" SelectedItem="{Binding Studio.LiveFormat}" Width="96" Margin="0,0,4,0" ToolTip="라이브 스트림 픽셀 포맷" />
                    <ui:Button Content="라이브" Command="{Binding Studio.StartLive}" Appearance="Primary" Style="{StaticResource Fluent2UiButtonStyle}" Margin="0,0,4,0" />
                    <Button Content="정지" Command="{Binding Studio.StopLive}" Style="{StaticResource DangerGlassButton}" Visibility="{Binding Studio.IsLiveRunning, Converter={StaticResource BoolVisibility}}" Margin="0,0,4,0" />
                    <Button Content="취소" Command="{Binding Studio.CancelImport}" Style="{StaticResource DangerGlassButton}" Visibility="{Binding Studio.Images.IsBusy, Converter={StaticResource BoolVisibility}}" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Row 2: 3-Zone Fluent 2 Workspace (Optimized for 1920x1080 Resolution) -->
        <Grid Grid.Row="2" Margin="10,4,10,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="300" MaxWidth="440" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="730" MinWidth="580" MaxWidth="960" />
            </Grid.ColumnDefinitions>

            <!-- Zone 1 (Left Layer Panel): Shape Selector + Fluent 2 ROI List + Selected ROI Applied Algorithm Card + Quick Geometry -->
            <Border Grid.Column="0" Style="{StaticResource Fluent2LayerPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: 1-Click Shape Selector & ROI Creation Grid -->
                    <Border Grid.Row="0" Style="{StaticResource Fluent2SurfaceCardStyle}" Padding="10,8">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Studio.SelectionSummary}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                <TextBlock Text="도형 1-Click 선택 · 영역 생성" Style="{StaticResource SectionBadgeText}" />
                            </DockPanel>

                            <UniformGrid Columns="4" Margin="0,0,0,6" IsEnabled="{Binding Studio.CanEdit}">
                                <Button Content="▭ 사각" Command="{Binding SelectRectangleShape}" Margin="0,0,3,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRectangleShapeSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="◯ 원" Command="{Binding SelectCircleShape}" Margin="2,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCircleShapeSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="△ 삼각" Command="{Binding SelectTriangleShape}" Margin="2,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTriangleShapeSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="⬠ 폴리곤" Command="{Binding SelectPolygonShape}" Margin="3,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPolygonShapeSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </UniformGrid>

                            <UniformGrid Columns="2" Margin="0,0,0,2">
                                <ui:Button Content="ROI 그리기 (R)" Command="{Binding Studio.DrawTool}" Appearance="Primary" Style="{StaticResource Fluent2UiButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,3,4" />
                                <ui:Button Content="ROI 중앙 추가" Command="{Binding Studio.AddRoi}" Style="{StaticResource Fluent2UiButtonStyle}" HorizontalAlignment="Stretch" Margin="3,0,0,4" />
                                <ui:Button Content="부모 그룹 그리기" Command="{Binding Studio.DrawParentRoi}" Style="{StaticResource Fluent2UiButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,3,0" />
                                <ui:Button Content="부모 그룹 추가" Command="{Binding Studio.AddParentRoi}" Style="{StaticResource Fluent2UiButtonStyle}" HorizontalAlignment="Stretch" Margin="3,0,0,0" />
                            </UniformGrid>

                            <UniformGrid Columns="3" Margin="0,6,0,0" Visibility="{Binding IsPolygonShapeSelected, Converter={StaticResource BoolVisibility}}">
                                <Button Content="폴리곤 완료" Command="{Binding Studio.CompletePolygon}" Style="{StaticResource PrimaryButton}" Height="26" Margin="0,0,3,0" />
                                <Button Content="점 취소" Command="{Binding Studio.RemovePolygonPoint}" Style="{StaticResource SecondaryButton}" Height="26" Margin="2,0" />
                                <Button Content="취소 (Esc)" Command="{Binding Studio.CancelPolygon}" Style="{StaticResource DangerGlassButton}" Height="26" Margin="3,0,0,0" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Row 1: Fluent 2 ROI Hierarchy List (Applied Algorithm & Verdict Badges) -->
                    <Border Grid.Row="1" Style="{StaticResource Fluent2SurfaceCardStyle}" Padding="9,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="2,0,2,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="‹" Command="{Binding Studio.PreviousRowPage}" Style="{StaticResource SecondaryButton}" Width="24" Height="22" Padding="0" />
                                    <TextBlock Text="{Binding Studio.RowPageLabel}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="6,0" />
                                    <Button Content="›" Command="{Binding Studio.NextRowPage}" Style="{StaticResource SecondaryButton}" Width="24" Height="22" Padding="0" />
                                </StackPanel>
                                <TextBlock Text="ROI 목록 · 적용 알고리즘 &amp; 판정" Style="{StaticResource CardHeaderTitle}" VerticalAlignment="Center" />
                            </DockPanel>

                            <Border Grid.Row="1"
                                    Background="{DynamicResource SubtleFillColorTransparentBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Fluent2ControlCornerRadius}"
                                    Padding="4">
                                <controls:RoiListBox x:Name="RoiList"
                                                     SelectionMode="Extended"
                                                     Style="{StaticResource Fluent2RoiListBoxStyle}"
                                                     ItemContainerStyle="{StaticResource Fluent2RoiListBoxItemStyle}"
                                                     IsEnabled="{Binding Studio.CanEdit}"
                                                     AutomationProperties.Name="ROI 계층 목록">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="{Binding IndentWidth}" />

                                                <Border Grid.Column="1"
                                                        Width="24"
                                                        Height="24"
                                                        CornerRadius="{StaticResource Fluent2ControlCornerRadius}"
                                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ShapeGlyph}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Trained Pattern Thumbnail Preview inside ROI Row -->
                                                <Border Grid.Column="2"
                                                        Width="32"
                                                        Height="32"
                                                        CornerRadius="4"
                                                        Background="#FF0F172A"
                                                        BorderBrush="{Binding AlgorithmAccent}"
                                                        BorderThickness="1"
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center"
                                                        ClipToBounds="True"
                                                        Visibility="{Binding HasPatternThumbnail, Converter={StaticResource BoolVisibility}}">
                                                    <Image Source="{Binding PatternThumbnail}"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>

                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Label}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Label}" />
                                                    <TextBlock Text="{Binding Kind}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Margin="0,1,0,0" />
                                                </StackPanel>

                                                <Border Grid.Column="4"
                                                        CornerRadius="{StaticResource Fluent2ControlCornerRadius}"
                                                        Padding="6,2"
                                                        Margin="6,0,0,0"
                                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                        BorderBrush="{Binding AlgorithmAccent}"
                                                        BorderThickness="1"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding HasAlgorithm, Converter={StaticResource BoolVisibility}}">
                                                    <TextBlock Text="{Binding AlgorithmBadge}"
                                                               Foreground="{Binding AlgorithmAccent}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold" />
                                                </Border>

                                                <Border Grid.Column="5"
                                                        CornerRadius="{StaticResource Fluent2ControlCornerRadius}"
                                                        Padding="6,2"
                                                        Margin="5,0,0,0"
                                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                        BorderBrush="{Binding VerdictAccent}"
                                                        BorderThickness="1"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding HasVerdict, Converter={StaticResource BoolVisibility}}">
                                                    <TextBlock Text="{Binding VerdictBadge}"
                                                               Foreground="{Binding VerdictAccent}"
                                                               FontSize="10"
                                                               FontWeight="Bold" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </controls:RoiListBox>
                            </Border>

                            <StackPanel Grid.Row="2" Margin="0,6,0,0">
                                <!-- Left Panel Registered Pattern Image List (Always visible when patterns are registered or for quick OK/NG registration) -->
                                <Border CornerRadius="{StaticResource Fluent2ControlCornerRadius}"
                                        Padding="6,5"
                                        Margin="0,0,0,6"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Content="＋정상"
                                                        Command="{Binding Studio.Matching.RegisterGoodPattern}"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Height="22"
                                                        FontSize="10"
                                                        Padding="6,0"
                                                        Margin="0,0,3,0"
                                                        ToolTip="현재 선택 ROI를 정상(OK) 패턴 이미지로 등록합니다." />
                                                <Button Content="＋불량"
                                                        Command="{Binding Studio.Matching.RegisterDefectPattern}"
                                                        Style="{StaticResource DangerGlassButton}"
                                                        Height="22"
                                                        FontSize="10"
                                                        Padding="6,0"
                                                        ToolTip="현재 선택 ROI를 불량(NG) 패턴 이미지로 등록합니다." />
                                            </StackPanel>
                                            <TextBlock Text="등록 패턴 이미지 관리 (정상/불량)"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>

                                        <TextBlock Text="{Binding Studio.Matching.RegisteredPatternListSummary}"
                                                   FontSize="9.5"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,3" />

                                        <ListBox ItemsSource="{Binding Studio.Matching.ActiveMethodPatterns}"
                                                 SelectedItem="{Binding Studio.Matching.SelectedRegisteredPattern, Mode=TwoWay}"
                                                 MaxHeight="132"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 Visibility="{Binding Studio.Matching.HasRegisteredPatterns, Converter={StaticResource BoolVisibility}}">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="1" />
                                                    <Setter Property="Margin" Value="0,0,0,2" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="4"
                                                            Padding="5,4"
                                                            Background="{DynamicResource LayerFillColorDefaultBrush}"
                                                            BorderBrush="{Binding RoleAccent}"
                                                            BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0"
                                                                    Width="38"
                                                                    Height="38"
                                                                    CornerRadius="3"
                                                                    Background="#FF0F172A"
                                                                    BorderBrush="{Binding RoleAccent}"
                                                                    BorderThickness="1"
                                                                    Margin="0,0,6,0"
                                                                    ClipToBounds="True">
                                                                <Image Source="{Binding ThumbnailImage}"
                                                                       Stretch="Uniform"
                                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                            </Border>

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0">
                                                                <TextBlock Text="{Binding DisplayTitle}"
                                                                           FontSize="10.5"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding ImageDimensionsText}"
                                                                           FontSize="9"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel>

                                                            <Button Grid.Column="2"
                                                                    Content="{Binding RoleShortBadge}"
                                                                    Command="{Binding ToggleRoleCommand}"
                                                                    Style="{StaticResource SecondaryButton}"
                                                                    Foreground="{Binding RoleAccent}"
                                                                    BorderBrush="{Binding RoleAccent}"
                                                                    FontSize="9.5"
                                                                    FontWeight="Bold"
                                                                    Padding="5,1"
                                                                    Height="22"
                                                                    Margin="0,0,3,0"
                                                                    ToolTip="클릭하여 정상(OK) ↔ 불량(NG) 전환" />

                                                            <Button Grid.Column="3"
                                                                    Content="삭제"
                                                                    Command="{Binding RemoveCommand}"
                                                                    Style="{StaticResource DangerGlassButton}"
                                                                    FontSize="9.5"
                                                                    Padding="5,1"
                                                                    Height="22"
                                                                    ToolTip="이 등록 패턴을 삭제합니다." />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>

                                <UniformGrid Columns="4" Margin="0,0,0,4">
                                    <Button Content="전체선택" Command="{Binding Studio.SelectAll}" Style="{StaticResource SecondaryButton}" Height="26" FontSize="10.5" Padding="4,0" Margin="0,0,2,0" />
                                    <Button Content="복사" Command="{Binding Studio.Copy}" Style="{StaticResource SecondaryButton}" Height="26" FontSize="10.5" Padding="4,0" Margin="2,0" />
                                    <Button Content="붙여넣기" Command="{Binding Studio.Paste}" Style="{StaticResource SecondaryButton}" Height="26" FontSize="10.5" Padding="4,0" Margin="2,0" />
                                    <Button Content="삭제" Command="{Binding Studio.Delete}" Style="{StaticResource DangerGlassButton}" Height="26" FontSize="10.5" Padding="4,0" Margin="2,0,0,0" />
                                </UniformGrid>
                                <UniformGrid Columns="4">
                                    <Button Content="그룹화" Command="{Binding Studio.Group}" Style="{StaticResource SecondaryButton}" Height="26" FontSize="10.5" Padding="4,0" Margin="0,0,2,0" />
                                    <Button Content="그룹해제" Command="{Binding Studio.Ungroup}" Style="{StaticResource SecondaryButton}" Height="26" FontSize="10.5" Padding="4,0" Margin="2,0" />
                                    <Button Content="자식지정" Command="{Binding Studio.ChooseChildRois}" Style="{StaticResource SecondaryButton}" Height="26" FontSize="10.5" Padding="4,0" Margin="2,0" />
                                    <Button Content="부모연결" Command="{Binding Studio.AttachToParent}" Style="{StaticResource SecondaryButton}" Height="26" FontSize="10.5" Padding="4,0" Margin="2,0,0,0" />
                                </UniformGrid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 2: Selected ROI Applied Algorithm & Quick Multi/All Inspect Card -->
                    <Border Grid.Row="2"
                            Style="{StaticResource Fluent2SurfaceCardStyle}"
                            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                            Padding="10,8">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right"
                                        CornerRadius="{StaticResource Fluent2ControlCornerRadius}"
                                        Padding="7,2"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{Binding Studio.Inspections.SelectedRoiVerdictAccent}"
                                        BorderThickness="1"
                                        Visibility="{Binding Studio.Inspections.SelectedRoiHasVerdict, Converter={StaticResource BoolVisibility}}">
                                    <TextBlock Text="{Binding Studio.Inspections.SelectedRoiVerdictBadge}"
                                               Foreground="{Binding Studio.Inspections.SelectedRoiVerdictAccent}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                </Border>
                                <TextBlock Text="{Binding Studio.Inspections.SelectedRoiHeaderText}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>

                            <Grid Margin="0,5,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="44"
                                        Height="44"
                                        CornerRadius="4"
                                        Background="#FF0F172A"
                                        BorderBrush="{Binding Studio.Inspections.SelectedRoiAlgorithmAccent}"
                                        BorderThickness="1.2"
                                        Margin="0,0,8,0"
                                        ClipToBounds="True"
                                        Visibility="{Binding Studio.Inspections.SelectedRoiHasPatternThumbnail, Converter={StaticResource BoolVisibility}}">
                                    <Image Source="{Binding Studio.Inspections.SelectedRoiPatternThumbnail}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <DockPanel Margin="0,0,0,3">
                                        <Border CornerRadius="{StaticResource Fluent2ControlCornerRadius}"
                                                Padding="7,2"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{Binding Studio.Inspections.SelectedRoiAlgorithmAccent}"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding Studio.Inspections.SelectedRoiAlgorithmBadge}"
                                                       Foreground="{Binding Studio.Inspections.SelectedRoiAlgorithmAccent}"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </DockPanel>

                                    <TextBlock Text="{Binding Studio.Inspections.SelectedRoiParameterSummary}"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0"
                                           Content="📌 현재 알고리즘 할당"
                                           Command="{Binding Studio.Inspections.AssignCurrentAlgorithmToSelectedRois}"
                                           Style="{StaticResource Fluent2UiButtonStyle}"
                                           ToolTip="현재 우측에 선택된 알고리즘을 대상 ROI에 할당합니다." />
                                <ui:Button Grid.Column="2"
                                           Content="{Binding Studio.Inspections.QuickInspectLabel}"
                                           Command="{Binding Studio.Inspections.ExecuteActiveToolOnRois}"
                                           Appearance="Primary"
                                           Style="{StaticResource Fluent2UiButtonStyle}"
                                           HorizontalAlignment="Stretch" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Row 3: Selected ROI Quick Geometry & Search Range Inspector -->
                    <Border Grid.Row="3" Style="{StaticResource Fluent2SurfaceCardStyle}" Padding="10,8" Margin="0" IsEnabled="{Binding Studio.CanEdit}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,5">
                                <Button DockPanel.Dock="Right" Content="0° 초기화" Command="{Binding Studio.ResetAngle}" Style="{StaticResource SecondaryButton}" Height="22" Padding="7,0" FontSize="10" />
                                <TextBlock Text="선택 ROI 수치 · 검색 여유 편집" Style="{StaticResource SectionBadgeText}" VerticalAlignment="Center" />
                            </DockPanel>

                            <StackPanel Visibility="{Binding Studio.Properties.HasSingleSelection, Converter={StaticResource BoolVisibility}}">
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="이름" Style="{StaticResource Caption}" />
                                        <controls:ValueTextBox Style="{StaticResource ValueTextBoxStyle}" Value="{Binding Studio.Properties.Name, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Visibility="{Binding Studio.Properties.CanChangeType, Converter={StaticResource BoolVisibility}}">
                                        <TextBlock Text="ROI 역할" Style="{StaticResource Caption}" />
                                        <ComboBox ItemsSource="{Binding Studio.Properties.Types}" SelectedIndex="{Binding Studio.Properties.SelectedType}" />
                                    </StackPanel>
                                </Grid>

                                <UniformGrid Columns="3" Margin="0,0,0,5">
                                    <StackPanel Margin="0,0,3,0">
                                        <TextBlock Text="중심 X" Style="{StaticResource Caption}" />
                                        <controls:ValueTextBox Style="{StaticResource ValueTextBoxStyle}" Value="{Binding Studio.Properties.X, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="2,0">
                                        <TextBlock Text="중심 Y" Style="{StaticResource Caption}" />
                                        <controls:ValueTextBox Style="{StaticResource ValueTextBoxStyle}" Value="{Binding Studio.Properties.Y, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="3,0,0,0">
                                        <TextBlock Text="각도 (°)" Style="{StaticResource Caption}" />
                                        <controls:ValueTextBox Style="{StaticResource ValueTextBoxStyle}" Value="{Binding Studio.Properties.Angle, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>

                                <UniformGrid Columns="4" Margin="0,0,0,5">
                                    <StackPanel Margin="0,0,3,0">
                                        <TextBlock Text="너비 W" Style="{StaticResource Caption}" />
                                        <controls:ValueTextBox Style="{StaticResource ValueTextBoxStyle}" Value="{Binding Studio.Properties.Width, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="2,0">
                                        <TextBlock Text="높이 H" Style="{StaticResource Caption}" />
                                        <controls:ValueTextBox Style="{StaticResource ValueTextBoxStyle}" Value="{Binding Studio.Properties.Height, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="2,0" Visibility="{Binding Studio.Properties.HasSearchRange, Converter={StaticResource BoolVisibility}}">
                                        <TextBlock Text="검색 X여유" Style="{StaticResource Caption}" />
                                        <controls:ValueTextBox Style="{StaticResource ValueTextBoxStyle}" Value="{Binding Studio.Properties.SearchHorizontal, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="3,0,0,0" Visibility="{Binding Studio.Properties.HasSearchRange, Converter={StaticResource BoolVisibility}}">
                                        <TextBlock Text="검색 Y여유" Style="{StaticResource Caption}" />
                                        <controls:ValueTextBox Style="{StaticResource ValueTextBoxStyle}" Value="{Binding Studio.Properties.SearchVertical, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="−15°" Command="{Binding Studio.RotateLeft}" Style="{StaticResource SecondaryButton}" Width="44" Height="27" Padding="0" />
                                    <Button Grid.Column="2" Content="＋15°" Command="{Binding Studio.RotateRight}" Style="{StaticResource SecondaryButton}" Width="44" Height="27" Padding="0" />
                                    <Button Grid.Column="4" Content="수치 변경 적용" Command="{Binding Studio.ApplyProperties}" Style="{StaticResource PrimaryButton}" Height="27" />
                                </Grid>
                            </StackPanel>

                            <TextBlock Text="ROI를 클릭하면 위치·크기·회전·검색 여유(px)와 적용 알고리즘을 즉시 확인·편집할 수 있습니다."
                                       TextWrapping="Wrap"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Studio.Properties.HasSingleSelection}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Zone 2 (Center Layer Panel): DX12 Hardware Viewport + Tool Rail & Navigation Bar -->
            <Border Grid.Column="1"
                    Style="{StaticResource Fluent2LayerPanelStyle}"
                    Margin="8,0,0,0"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Viewport Top HUD -->
                    <Border Grid.Row="0" Style="{StaticResource Fluent2SurfaceCardStyle}" Padding="12,7" Margin="0,0,0,6">
                        <DockPanel>
                            <Border DockPanel.Dock="Right"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    CornerRadius="{StaticResource Fluent2ControlCornerRadius}"
                                    Padding="9,3"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Studio.ToolName}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding Studio.ImageTitle}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Studio.ToolHint}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Viewport Body: Left Tool Rail + DX12 Surface -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource Fluent2SurfaceCardStyle}"
                                Margin="0,0,6,0"
                                Padding="4,8">
                            <StackPanel>
                                <Button Content="선택" Command="{Binding Studio.SelectTool}" Style="{StaticResource SecondaryButton}" FontSize="10" Padding="2,4" ToolTip="선택 도구 (V)" Margin="0,0,0,6" />
                                <Button Content="이동" Command="{Binding Studio.PanTool}" Style="{StaticResource SecondaryButton}" FontSize="10" Padding="2,4" ToolTip="화면 이동 도구 (H)" Margin="0,0,0,6" />
                                <Button Content="그리기" Command="{Binding Studio.DrawTool}" Style="{StaticResource SecondaryButton}" FontSize="10" Padding="2,4" ToolTip="ROI 그리기 (R)" Margin="0,0,0,6" />
                                <Button Content="＋ROI" Command="{Binding Studio.AddRoi}" Style="{StaticResource SecondaryButton}" FontSize="10" Padding="2,4" ToolTip="ROI 중앙 추가" Margin="0,0,0,6" />
                                <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="4,4,4,8" />
                                <Button Content="그룹" Command="{Binding Studio.Group}" Style="{StaticResource SecondaryButton}" FontSize="10" Padding="2,4" ToolTip="그룹화 (Ctrl+G)" Margin="0,0,0,6" />
                                <Button Content="해제" Command="{Binding Studio.Ungroup}" Style="{StaticResource SecondaryButton}" FontSize="10" Padding="2,4" ToolTip="그룹 해제 (Ctrl+Shift+G)" Margin="0,0,0,6" />
                                <Button Content="0°" Command="{Binding Studio.ResetAngle}" Style="{StaticResource SecondaryButton}" FontSize="10" Padding="2,4" ToolTip="0° 회전 초기화" Margin="0,0,0,6" />
                                <Button Content="삭제" Command="{Binding Studio.Delete}" Style="{StaticResource DangerGlassButton}" FontSize="10" Padding="2,4" ToolTip="선택 삭제 (Del)" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Fluent2OverlayCornerRadius}"
                                ClipToBounds="True">
                            <canvas:Dx12Viewport x:Name="Viewport"
                                                 AutomationProperties.Name="이미지 ROI 편집 캔버스"
                                                 Scene="{Binding Studio.Scene, Mode=OneWay}"
                                                 LayoutState="{Binding Studio.Layout}"
                                                 PointerInput="{Binding Studio.Input}"
                                                 KeyAction="{Binding Studio.KeyHandler}"
                                                 IsInputEnabled="{Binding Studio.CanNavigate}" />
                        </Border>
                    </Grid>

                    <!-- Viewport Bottom Navigation & Zoom Bar (Fluent 2 ui:TextBox & ui:Button) -->
                    <Border Grid.Row="2" Style="{StaticResource Fluent2SurfaceCardStyle}" Padding="10,6" Margin="0,6,0,0">
                        <StackPanel>
                            <canvasHost:ViewportNavigationBar DataContext="{Binding Studio.Navigation}" Margin="0,0,0,4" />
                            <DockPanel LastChildFill="False" IsEnabled="{Binding Studio.CanNavigate}">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <Button Content="−" Command="{Binding Studio.ZoomOut}" Style="{StaticResource SecondaryButton}" Width="28" Height="28" Padding="0" ToolTip="축소" />
                                    <ui:TextBox Width="68"
                                                Text="{Binding Studio.ZoomText, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource Fluent2UiTextBoxStyle}"
                                                TextAlignment="Right"
                                                Margin="4,0">
                                        <ui:TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding Studio.ApplyZoom}" />
                                        </ui:TextBox.InputBindings>
                                    </ui:TextBox>
                                    <TextBlock Text="%" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <ui:Button Content="적용" Command="{Binding Studio.ApplyZoom}" Style="{StaticResource Fluent2UiButtonStyle}" Margin="0,0,4,0" />
                                    <Button Content="＋" Command="{Binding Studio.ZoomIn}" Style="{StaticResource SecondaryButton}" Width="28" Height="28" Padding="0" ToolTip="확대" Margin="0,0,8,0" />
                                    <ui:Button Content="화면 맞춤 (F)" Command="{Binding Studio.Fit}" Style="{StaticResource Fluent2UiButtonStyle}" Margin="0,0,4,0" />
                                    <ui:Button Content="1:1 원본" Command="{Binding Studio.ActualSize}" Style="{StaticResource Fluent2UiButtonStyle}" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="←" Command="{Binding Studio.Left}" Style="{StaticResource SecondaryButton}" Width="28" Height="28" Padding="0" Margin="0,0,3,0" />
                                    <Button Content="↑" Command="{Binding Studio.Up}" Style="{StaticResource SecondaryButton}" Width="28" Height="28" Padding="0" Margin="0,0,3,0" />
                                    <Button Content="↓" Command="{Binding Studio.Down}" Style="{StaticResource SecondaryButton}" Width="28" Height="28" Padding="0" Margin="0,0,3,0" />
                                    <Button Content="→" Command="{Binding Studio.Right}" Style="{StaticResource SecondaryButton}" Width="28" Height="28" Padding="0" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="2"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True" />

            <!-- Zone 3 (Right Workbench): WPF-UI NavigationView + Active Stage Cards + Inspection Log Center -->
            <Border Grid.Column="3"
                    Style="{StaticResource Fluent2LayerPanelStyle}"
                    IsEnabled="{Binding Studio.CanNavigate}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="172" MinHeight="128" MaxHeight="320" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Fluent 2 NavigationView (Top PaneDisplayMode + 5 Stage NavigationViewItems, 1080p Fitted) -->
                    <Border Grid.Row="0"
                            Style="{StaticResource Fluent2SurfaceCardStyle}"
                            Padding="6,4"
                            Margin="0,0,0,6">
                        <Grid>
                            <ui:NavigationView x:Name="WorkspaceNavigation"
                                               PaneDisplayMode="Top"
                                               IsBackButtonVisible="Collapsed"
                                               IsPaneToggleVisible="False"
                                               Height="0"
                                               Opacity="0"
                                               IsHitTestVisible="False">
                                <ui:NavigationView.MenuItems>
                                    <ui:NavigationViewItem Content="① 패턴 매칭"
                                                           Command="{Binding SelectPatternStage}"
                                                           IsActive="{Binding IsPatternStage, Mode=OneWay}" />
                                    <ui:NavigationViewItem Content="② 도형·마크"
                                                           Command="{Binding SelectPrimitiveStage}"
                                                           IsActive="{Binding IsPrimitiveStage, Mode=OneWay}" />
                                    <ui:NavigationViewItem Content="③ Few-Shot"
                                                           Command="{Binding SelectFewShotStage}"
                                                           IsActive="{Binding IsFewShotStage, Mode=OneWay}" />
                                    <ui:NavigationViewItem Content="④ 7종 스위트"
                                                           Command="{Binding SelectSuiteStage}"
                                                           IsActive="{Binding IsSuiteStage, Mode=OneWay}" />
                                    <ui:NavigationViewItem Content="⑤ 필터·마스크"
                                                           Command="{Binding SelectFilterMaskStage}"
                                                           IsActive="{Binding IsFilterMaskStage, Mode=OneWay}" />
                                </ui:NavigationView.MenuItems>
                            </ui:NavigationView>

                            <!-- Equal-Width 5-Item Fluent 2 Navigation Bar (Never Overflows into '...' on 1920x1080) -->
                            <UniformGrid Columns="5">
                                <Button Content="① 패턴 매칭" Command="{Binding SelectPatternStage}" Margin="0,0,3,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource StageTabButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPatternStage}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="② 도형·마크" Command="{Binding SelectPrimitiveStage}" Margin="2,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource StageTabButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPrimitiveStage}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="③ Few-Shot" Command="{Binding SelectFewShotStage}" Margin="2,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource StageTabButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFewShotStage}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="④ 7종 스위트" Command="{Binding SelectSuiteStage}" Margin="2,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource StageTabButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSuiteStage}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="⑤ 필터·마스크" Command="{Binding SelectFilterMaskStage}" Margin="3,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource StageTabButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFilterMaskStage}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <!-- Row 1: Active Stage Content (Zero Expanders) -->
                    <Grid Grid.Row="1">
                        <views:FluentPatternCard Visibility="{Binding IsPatternStage, Converter={StaticResource BoolVisibility}}" />
                        <views:FluentPrimitiveCard Visibility="{Binding IsPrimitiveStage, Converter={StaticResource BoolVisibility}}" />
                        <views:FluentFewShotCard Visibility="{Binding IsFewShotStage, Converter={StaticResource BoolVisibility}}" />
                        <views:FluentSuiteCard Visibility="{Binding IsSuiteStage, Converter={StaticResource BoolVisibility}}" />
                        <views:FluentFilterCard Visibility="{Binding IsFilterMaskStage, Converter={StaticResource BoolVisibility}}" />
                    </Grid>

                    <!-- Row 2: Horizontal Splitter for Inspection Log Center -->
                    <GridSplitter Grid.Row="2"
                                  Height="6"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Background="Transparent"
                                  ResizeDirection="Rows"
                                  ResizeBehavior="PreviousAndNext"
                                  ShowsPreview="True" />

                    <!-- Row 3: Fluent 2 Inspection Log Center -->
                    <Border Grid.Row="3"
                            Style="{StaticResource Fluent2SurfaceCardStyle}"
                            Padding="10,8"
                            Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Log Header + Action Buttons -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,5">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="🎯 위치 이동"
                                            Command="{Binding Studio.Inspections.LocateSelectedLogEntry}"
                                            Style="{StaticResource SecondaryButton}"
                                            Height="23"
                                            FontSize="10"
                                            Padding="7,0"
                                            Margin="0,0,4,0"
                                            ToolTip="선택한 로그 항목의 ROI 검출 위치로 캔버스를 이동합니다." />
                                    <Button Content="📋 복사"
                                            Command="{Binding CopyStructuredLogs}"
                                            Style="{StaticResource SecondaryButton}"
                                            Height="23"
                                            FontSize="10"
                                            Padding="7,0"
                                            Margin="0,0,4,0"
                                            ToolTip="현재 필터링된 검사 로그를 클립보드에 복사합니다." />
                                    <Button Content="🗑 비우기"
                                            Command="{Binding Studio.Inspections.ClearStructuredLogs}"
                                            Style="{StaticResource DangerGlassButton}"
                                            Height="23"
                                            FontSize="10"
                                            Padding="7,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="실시간 ROI별 검사 로그 센터" Style="{StaticResource SectionBadgeText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Studio.Inspections.LogSummaryText}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Filter Pill Strip (전체 / PASS / NG·WARN / 선택 ROI) -->
                            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,5">
                                <Button Content="전체 로그" Command="{Binding Studio.Inspections.FilterAllLogs}" Height="24" FontSize="10.5" Margin="0,0,3,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Studio.Inspections.IsLogFilterAll}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="PASS 정상만" Command="{Binding Studio.Inspections.FilterPassLogs}" Height="24" FontSize="10.5" Margin="2,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Studio.Inspections.IsLogFilterPass}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="NG · WARN만" Command="{Binding Studio.Inspections.FilterFailWarnLogs}" Height="24" FontSize="10.5" Margin="2,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Studio.Inspections.IsLogFilterFailWarn}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="선택 ROI만" Command="{Binding Studio.Inspections.FilterSelectedRoiLogs}" Height="24" FontSize="10.5" Margin="3,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Studio.Inspections.IsLogFilterSelectedRoi}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </UniformGrid>

                            <!-- Structured Inspection Log ListBox -->
                            <Border Grid.Row="2"
                                    Background="{DynamicResource SubtleFillColorTransparentBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Fluent2ControlCornerRadius}"
                                    Padding="3">
                                <ListBox ItemsSource="{Binding Studio.Inspections.FilteredLogs}"
                                         SelectedItem="{Binding Studio.Inspections.SelectedLogEntry, Mode=TwoWay}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         AutomationProperties.Name="ROI별 구조화 검사 로그">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding ElapsedText}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0" />
                                                <Border DockPanel.Dock="Left"
                                                        CornerRadius="{StaticResource Fluent2ControlCornerRadius}"
                                                        Padding="6,1.5"
                                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                        BorderBrush="{Binding VerdictAccent}"
                                                        BorderThickness="1"
                                                        Margin="0,0,7,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding VerdictBadge}"
                                                               Foreground="{Binding VerdictAccent}"
                                                               FontSize="9.5"
                                                               FontWeight="Bold" />
                                                </Border>
                                                <TextBlock DockPanel.Dock="Left"
                                                           Text="{Binding TimestampText}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,7,0" />
                                                <TextBlock DockPanel.Dock="Left"
                                                           Text="{Binding RoiName}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,7,0" />
                                                <Border DockPanel.Dock="Left"
                                                        CornerRadius="{StaticResource Fluent2ControlCornerRadius}"
                                                        Padding="5,1"
                                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                        Margin="0,0,7,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AlgorithmBadge}"
                                                               FontSize="9.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding ScoreSummary}"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding OneLineSummary}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 3: Fluent 2 Footer Status & Telemetry Bar -->
        <Border Grid.Row="3"
                Margin="12,0,12,6"
                Style="{StaticResource Fluent2SurfaceCardStyle}"
                Padding="14,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding Studio.GuideSettings.ToggleLabel}" Command="{Binding Studio.GuideSettings.Toggle}" Height="22" FontSize="10" Padding="8,0" Margin="0,0,8,0" />
                    <Button Content="미니맵 전환" Command="{Binding ToggleMinimap}" Height="22" FontSize="10" Padding="8,0" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Studio.Performance}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{Binding Studio.GpuStatus}" />
                    <Button Content="GPU 재연결" Command="{Binding Studio.RestartRenderer}" Height="22" FontSize="10" Padding="8,0" ToolTip="{Binding Studio.GpuStatus}" />
                </StackPanel>
                <TextBlock Text="{Binding Studio.Status}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10.5" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
