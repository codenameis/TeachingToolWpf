<UserControl x:Class="TeachingToolWpf.Fluent2.Views.FluentPrimitiveCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TeachingToolWpf.Controls;assembly=TeachingToolWpf.Presentation"
             Validation.Error="OnValidationError">
    <Grid DataContext="{Binding Studio.Inspections.Shapes}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Bento Column: Target Shapes & 1920x1080 3-Column Parameter Sliders -->
                <StackPanel Grid.Column="0" IsEnabled="{Binding IsIdle}">
                    <Border Style="{StaticResource Fluent2SurfaceCardStyle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Content="? 매뉴얼" Command="{Binding ToggleHelpManual}"
                                        Style="{StaticResource SecondaryButton}" Padding="8,2" Height="22" FontSize="10.5" FontWeight="Bold"
                                        ToolTip="일반 도형 및 PCB 정렬 마크 검출 알고리즘의 상세 수식·사용법·파라미터 튜닝 매뉴얼을 펼치거나 닫습니다." />
                                <TextBlock Text="1 · 검출할 기본 도형 · PCB 정렬 마크 (11종)" Style="{StaticResource CardHeaderTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Visibility="{Binding IsHelpManualOpen, Converter={StaticResource BoolVisibility}}"
                                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                    BorderThickness="3,1,1,1"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    Margin="0,2,0,6">
                                <StackPanel DataContext="{Binding ActiveHelpManual}">
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right" Content="닫기 ✕" Command="{Binding DataContext.Studio.Inspections.Shapes.ToggleHelpManual, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource SecondaryButton}" Padding="6,1" Height="20" FontSize="9.5" />
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <TextBlock Text="■ 핵심 원리 및 수식" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding PrincipleAndFormula}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="14.5" Margin="0,0,0,6" />
                                    <TextBlock Text="■ 단계별 사용 방법" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding StepByStepGuide}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="14.5" Margin="0,0,0,6" />
                                    <TextBlock Text="■ 주요 파라미터 튜닝 가이드" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding ParameterTuningGuide}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="14.5" Margin="0,0,0,6" />
                                    <TextBlock Text="■ 현장 트러블슈팅 팁" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding TroubleshootingTips}" FontSize="10" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" TextWrapping="Wrap" LineHeight="14.5" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="학습 없이 원본 윤곽·구멍 계층에서 도형과 PCB 마크를 전수 검출합니다." TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                            <CheckBox Content="GPU 가속 전처리 (CPU + NVIDIA CUDA)" IsChecked="{Binding UseGpu}" Margin="0,0,0,4" />

                            <UniformGrid Columns="3" Margin="0,0,0,4">
                                <CheckBox Content="삼각형" IsChecked="{Binding FindTriangles}" />
                                <CheckBox Content="사각형" IsChecked="{Binding FindRectangles}" />
                                <CheckBox Content="원 (Circle)" IsChecked="{Binding FindCircles}" />
                                <CheckBox Content="십자가" IsChecked="{Binding FindCrosses}" />
                                <CheckBox Content="도넛 (Ring)" IsChecked="{Binding FindRings}" />
                                <CheckBox Content="사각 테두리" IsChecked="{Binding FindRectangleFrames}" />
                                <CheckBox Content="마름모" IsChecked="{Binding FindDiamonds}" />
                                <CheckBox Content="# 마크" IsChecked="{Binding FindCrossHashes}" />
                                <CheckBox Content="더블스퀘어" IsChecked="{Binding FindDoubleSquares}" />
                                <CheckBox Content="별 (5각)" IsChecked="{Binding FindStars}" />
                                <CheckBox Content="별표 (6·8각)" IsChecked="{Binding FindAsterisks}" />
                            </UniformGrid>

                            <TextBlock Text="{Binding SearchScopeText}" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,2,0,5" />

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="명암 극성 방향" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Polarities}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Polarity}" />
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="132" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="최소 크기 (6~512 px)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="6" Maximum="512" TickFrequency="2" Value="{Binding MinimumSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding MinimumSize, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="132" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="최대 크기 (6~512 px)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="6" Maximum="512" TickFrequency="2" Value="{Binding MaximumSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding MaximumSize, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Threshold, Contour Approximation & Budget (Always Open, Zero Expander, Full-Width 3-Column Sliders) -->
                    <Border Style="{StaticResource Fluent2SurfaceCardStyle}">
                        <StackPanel>
                            <TextBlock Text="2 · 이진화 · 윤곽 근사 · 결과 한도" Style="{StaticResource CardHeaderTitle}" Margin="0,0,0,5" />
                            <CheckBox Content="자동 이진화 (창별 Otsu)" IsChecked="{Binding AutomaticThreshold}" Margin="0,0,0,5" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="132" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="수동 이진화 (0~255)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="0" Maximum="255" TickFrequency="1" Value="{Binding Threshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding Threshold, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="132" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="윤곽 근사비 (.005~.04)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="0.005" Maximum="0.04" TickFrequency="0.001" Value="{Binding ApproximationTolerance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding ApproximationTolerance, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="132" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="최소 형상 점수 (0~1)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="0.10" Maximum="0.99" TickFrequency="0.01" Value="{Binding MinimumScore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding MinimumScore, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="132" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="최대 결과 (0=전체)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="0" Maximum="512" TickFrequency="4" Value="{Binding MaximumResults, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding MaximumResults, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="132" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="시간 한도 (0~120초)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="0" Maximum="120" TickFrequency="1" Value="{Binding SearchTimeoutSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding SearchTimeoutSeconds, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Bento Column: Preview Summary & Detection Results -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Fluent2SurfaceCardStyle}">
                        <StackPanel>
                            <TextBlock Text="3 · 실시간 파라미터 요약 · 검출 결과" Style="{StaticResource CardHeaderTitle}" Margin="0,0,0,5" />
                            <Border BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="2,0,0,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,5" Margin="0,0,0,6">
                                <TextBlock Text="{Binding ParameterPreviewSummary}" TextWrapping="Wrap" FontSize="10.5" />
                            </Border>

                            <DockPanel Margin="0,0,0,5">
                                <Button DockPanel.Dock="Right" Content="도형 위치로 맞춤" Command="{Binding Locate}" Style="{StaticResource SecondaryButton}" Height="25" Padding="8,0" FontSize="10.5" />
                                <CheckBox Content="캔버스 도형 윤곽 표시" IsChecked="{Binding ShowOverlay}" VerticalAlignment="Center" />
                            </DockPanel>

                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Left" Content="‹ 이전" Command="{Binding PreviousResults}" Style="{StaticResource SecondaryButton}" Width="60" Height="24" />
                                <Button DockPanel.Dock="Right" Content="다음 ›" Command="{Binding NextResults}" Style="{StaticResource SecondaryButton}" Width="60" Height="24" />
                                <TextBlock Text="{Binding ResultPage}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </DockPanel>

                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="8,6" MinHeight="220">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding Results}" TextWrapping="Wrap" FontSize="11" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Pinned Bottom Execution Bar -->
        <Border Grid.Row="1" Style="{StaticResource Fluent2SurfaceCardStyle}" Margin="0,6,0,0" Padding="10,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Content="도형 검출 실행" Command="{Binding Detect}" Style="{StaticResource PrimaryButton}" Width="116" Height="32" Margin="0,0,6,0" />
                    <Button Content="취소" Command="{Binding Cancel}" Style="{StaticResource SecondaryButton}" Width="64" Height="32" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="11.5" />
                    <TextBlock Text="{Binding OptionsError}" Foreground="{StaticResource RoseAccent}" TextWrapping="Wrap" FontSize="10" />
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,3,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
