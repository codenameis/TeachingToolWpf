<UserControl x:Class="TeachingToolWpf.Fluent2.Views.FluentSuiteCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TeachingToolWpf.Controls;assembly=TeachingToolWpf.Presentation"
             Validation.Error="OnValidationError">
    <Grid DataContext="{Binding Studio.Inspections.Suite}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.98*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="1.02*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: ComboBox Algorithm Selector, Sample Loader, Step-by-Step Guide & Reference Teaching -->
                <StackPanel Grid.Column="0" IsEnabled="{Binding IsIdle}">
                    <Border Style="{StaticResource Fluent2SurfaceCardStyle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,5">
                                <Button DockPanel.Dock="Right" Content="? 매뉴얼" Command="{Binding ToggleHelpManual}"
                                        Style="{StaticResource SecondaryButton}" Padding="8,2" Height="22" FontSize="10.5" FontWeight="Bold"
                                        ToolTip="현재 선택된 알고리즘의 상세 수식 원리·단계별 티칭·파라미터 튜닝 매뉴얼을 펼치거나 닫습니다." />
                                <TextBlock Text="1 · 알고리즘 카테고리 선택" Style="{StaticResource CardHeaderTitle}" VerticalAlignment="Center" />
                            </DockPanel>

                            <UniformGrid Columns="3" Margin="0,0,0,5">
                                <Button Content="치수·기하계측 (5)" Command="{Binding SelectMetrologyCategory}" Margin="0,0,2,2" Padding="4,3" MinHeight="24" FontSize="10">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMetrologyCategorySelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="블롭·표면·3D (6)" Command="{Binding SelectSurface3DCategory}" Margin="1,0,1,2" Padding="4,3" MinHeight="24" FontSize="10">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSurface3DCategorySelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="바코드·OCR (5)" Command="{Binding SelectCodeOcrCategory}" Margin="2,0,0,2" Padding="4,3" MinHeight="24" FontSize="10">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCodeOcrCategorySelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="AI·자동티칭 (2)" Command="{Binding SelectAiAutoTeachingCategory}" Margin="0,2,2,0" Padding="4,3" MinHeight="24" FontSize="10">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAiAutoTeachingCategorySelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="조명·FFT·Gabor (2)" Command="{Binding SelectPreprocessingCategory}" Margin="1,2,1,0" Padding="4,3" MinHeight="24" FontSize="10">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPreprocessingCategorySelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="전체 보기 (20)" Command="{Binding SelectAllCategories}" Margin="2,2,0,0" Padding="4,3" MinHeight="24" FontSize="10">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAllCategoriesSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </UniformGrid>

                            <TextBlock Text="{Binding ActiveCategoryTitle}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,4" />

                            <ItemsControl ItemsSource="{Binding CategoryAlgorithms}" Margin="0,0,0,5">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding ShortPillLabel}"
                                                Command="{Binding SelectCommand}"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="7,2"
                                                MinHeight="22"
                                                FontSize="10"
                                                Margin="0,0,4,4"
                                                ToolTip="{Binding Name}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ComboBox ItemsSource="{Binding CategoryAlgorithms}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Kind"
                                      SelectedValue="{Binding SelectedAlgorithm}"
                                      Margin="0,0,0,6" />

                            <Border x:Name="HelpManualBorder"
                                    Visibility="{Binding IsHelpManualOpen, Converter={StaticResource BoolVisibility}}"
                                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                    BorderThickness="3,1,1,1"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    Margin="0,0,0,6">
                                <StackPanel DataContext="{Binding ActiveHelpManual}">
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right" Content="닫기 ✕" Command="{Binding DataContext.Studio.Inspections.Suite.ToggleHelpManual, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource SecondaryButton}" Padding="6,1" Height="20" FontSize="9.5" />
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <TextBlock Text="■ 핵심 원리 및 수식" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding PrincipleAndFormula}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="14.5" Margin="0,0,0,6" />
                                    <TextBlock Text="■ 단계별 티칭 및 사용 방법" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding StepByStepGuide}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="14.5" Margin="0,0,0,6" />
                                    <TextBlock Text="■ 주요 파라미터 튜닝 가이드" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding ParameterTuningGuide}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="14.5" Margin="0,0,0,6" />
                                    <TextBlock Text="■ 현장 트러블슈팅 팁" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding TroubleshootingTips}" FontSize="10" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" TextWrapping="Wrap" LineHeight="14.5" />
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                <TextBlock Text="{Binding AlgorithmDescription}" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>

                            <Button Content="▶ 현재 선택 알고리즘 전용 샘플 영상 불러오기 (직접 ROI 티칭)"
                                    Command="{Binding LoadSelectedAlgorithmSample}"
                                    Style="{StaticResource PrimaryButton}"
                                    Height="30" />
                        </StackPanel>
                    </Border>

                    <!-- Step-by-Step Usage Guide Card -->
                    <Border Style="{StaticResource Fluent2SurfaceCardStyle}">
                        <StackPanel>
                            <TextBlock Text="2 · 선택 알고리즘 사용 가이드 (Step-by-Step)" Style="{StaticResource CardHeaderTitle}" Margin="0,0,0,4" />
                            <Border BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                    BorderThickness="3,0,0,0"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="4"
                                    Padding="8,6">
                                <TextBlock Text="{Binding AlgorithmUsageGuide}"
                                           TextWrapping="Wrap"
                                           FontSize="10.5"
                                           LineHeight="15" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Reference / AutoTeaching Part Model Pool Registration & Management Card -->
                    <Border Style="{StaticResource Fluent2SurfaceCardStyle}"
                            Visibility="{Binding UsesReferenceRois, Converter={StaticResource BoolVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ReferenceCardTitle}" Style="{StaticResource CardHeaderTitle}" Margin="0,0,0,5" />
                            <UniformGrid Columns="3" Margin="0,0,0,5">
                                <Button Content="{Binding RegisterNormalButtonText}" Command="{Binding RegisterNormalReference}" Style="{StaticResource PrimaryButton}" Margin="0,0,3,0" FontSize="10.5" />
                                <Button Content="불량(NG) 등록" Command="{Binding RegisterDefectReference}" Style="{StaticResource SecondaryButton}" Margin="2,0,2,0" FontSize="10.5" />
                                <Button Content="모델 풀 초기화" Command="{Binding ClearReferences}" Style="{StaticResource SecondaryButton}" Margin="3,0,0,0" FontSize="10.5" />
                            </UniformGrid>
                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,5" Margin="0,0,0,5">
                                <TextBlock Text="{Binding ReferenceSummary}" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            </Border>

                            <!-- Registered Part Model Pool / Reference ROI List -->
                            <ItemsControl ItemsSource="{Binding RegisteredReferenceItems}"
                                          Visibility="{Binding HasRegisteredReferences, Converter={StaticResource BoolVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="5"
                                                Padding="7,5"
                                                Margin="0,0,0,4"
                                                Background="{DynamicResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{Binding RoleAccent}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        CornerRadius="3"
                                                        Padding="5,2"
                                                        Margin="0,0,7,0"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                        BorderBrush="{Binding RoleAccent}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding RoleBadge}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="10.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding GeometrySummary}" FontSize="9.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding ChildTargetSummary}" FontSize="9" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Content="삭제"
                                                        Command="{Binding RemoveCommand}"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="7,2"
                                                        Height="22"
                                                        FontSize="9.5"
                                                        VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Column: Dedicated Per-Algorithm Teaching Parameter Pages & Live Results -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Fluent2SurfaceCardStyle}" IsEnabled="{Binding IsIdle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <CheckBox DockPanel.Dock="Right" Content="실시간 프리뷰" IsChecked="{Binding AutoPreview}" FontSize="10" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedAlgorithmHeaderTitle}" Style="{StaticResource CardHeaderTitle}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>

                            <Border BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                    BorderThickness="2,0,0,0"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="4"
                                    Padding="8,5"
                                    Margin="0,0,0,8">
                                <TextBlock Text="{Binding ParameterPreviewSummary}" TextWrapping="Wrap" FontSize="10" />
                            </Border>

                            <!-- [Page 1] Metrology: 1D Caliper / RANSAC Line / Taubin Circle -->
                            <StackPanel Visibility="{Binding IsMetrologySelected, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,6">
                                <TextBlock Text="캘리퍼 계측 동작 모드" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                                <ComboBox ItemsSource="{Binding MetrologyModes}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Mode"
                                          SelectedValue="{Binding MetrologyMode}"
                                          Margin="0,0,0,6" />
                                <TextBlock Text="에지 검출 극성 (Polarity)" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                                <ComboBox ItemsSource="{Binding PolarityModes}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Polarity"
                                          SelectedValue="{Binding PolarityMode}" />
                            </StackPanel>

                            <!-- Edge / Contrast Parameters (Metrology, Curvilinear, CornerAlignment) -->
                            <StackPanel Visibility="{Binding UsesEdgeContrastParams, Converter={StaticResource BoolVisibility}}">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="가우시안 스무딩 σ (0.4~10)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="0.4" Maximum="10" TickFrequency="0.1" Value="{Binding GaussianSigma, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding GaussianSigma, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="최소 에지 대비 (1~250 GV)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="1" Maximum="250" TickFrequency="1" Value="{Binding MinimumContrast, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding MinimumContrast, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>
                            </StackPanel>

                            <!-- Rake Count & Projection Width (Metrology & CornerAlignment) -->
                            <StackPanel Visibility="{Binding UsesMetrologyOrCornerParams, Converter={StaticResource BoolVisibility}}">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="레이크/스포크 분할 수 (5~48)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="5" Maximum="48" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CaliperRakeCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding CaliperRakeCount, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="1D 투영 적분 폭 (3~45 px)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="3" Maximum="45" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CaliperProjectionWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding CaliperProjectionWidth, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>
                            </StackPanel>

                            <!-- [Page 2] Golden Variation Parameters -->
                            <StackPanel Visibility="{Binding IsGoldenVariationSelected, Converter={StaticResource BoolVisibility}}">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="표준편차 허용 배수 k (1~10)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="1" Maximum="10" TickFrequency="0.1" Value="{Binding VariationStdMultiplier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding VariationStdMultiplier, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="에지 지터 허용치 c (0~3)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="0" Maximum="3" TickFrequency="0.05" Value="{Binding VariationEdgeMultiplier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding VariationEdgeMultiplier, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="최소 결함 판정 면적 (1~200px)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="1" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding GoldenMinDefectAreaPixels, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding GoldenMinDefectAreaPixels, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>
                            </StackPanel>

                            <!-- [Page 3] RLE Blob Parameters -->
                            <StackPanel Visibility="{Binding IsBlobRleSelected, Converter={StaticResource BoolVisibility}}">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="RLE 이진화 임계 밝기 (1~255)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="1" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ThresholdIntensity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding ThresholdIntensity, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="모폴로지 오프닝 반경 (0~16px)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="0" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MorphologyRadius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding MorphologyRadius, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="최소 유효 블롭 면적 (1~500px)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="1" Maximum="500" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding BlobMinimumAreaPixels, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding BlobMinimumAreaPixels, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>
                            </StackPanel>

                            <!-- [Page 4] Curvilinear Bead Width -->
                            <StackPanel Visibility="{Binding IsCurvilinearSelected, Converter={StaticResource BoolVisibility}}">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
