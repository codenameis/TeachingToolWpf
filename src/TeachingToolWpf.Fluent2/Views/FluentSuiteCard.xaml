                            IsEnabled="{Binding IsIdle}"
                            Visibility="{Binding IsAnyOcrSelected, Converter={StaticResource BoolVisibility}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Border DockPanel.Dock="Right" Background="{Binding OcvLastVerdictAccent}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OcvLastVerdictBadge}" Foreground="#0F172A" FontSize="9.5" FontWeight="Bold" />
                                </Border>
                                <TextBlock Text="4 · 티칭 기반 OCV 인쇄 품질 검증 (동일 인쇄 골든 폰트)" Style="{StaticResource CardHeaderTitle}" VerticalAlignment="Center" />
                            </DockPanel>

                            <TextBlock Text="{Binding OcvFontStatusBadge}" FontSize="10" Foreground="#38BDF8" TextWrapping="Wrap" Margin="0,0,0,6" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="118" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="기대 문자열 (ROI)" Style="{StaticResource Fluent2ParameterLabelStyle}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding SelectedRoiOcvExpectedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas, Malgun Gothic" FontSize="11" ToolTip="선택한 ROI의 기준/기대 문자열 (문서 저장 및 Ctrl+Z 실행 취소 지원)" />
                            </Grid>

                            <Button Content="PP-OCR 판독값 → 기대 문자열 채우기"
                                    Command="{Binding ApplyPpOcrTextToOcvExpectedText}"
                                    Style="{StaticResource SecondaryButton}"
                                    Height="24"
                                    FontSize="9.8"
                                    Margin="0,0,0,5"
                                    ToolTip="방금 PP-OCRv4로 판독한 문자열을 현재 선택된 ROI의 OCV 기대 문자열에 즉시 복사합니다." />

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="118" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="형식 마스크 (선택)" Style="{StaticResource Fluent2ParameterLabelStyle}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding SelectedRoiOcvFormatMask, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas, Malgun Gothic" FontSize="10.5" ToolTip="패턴 마스크(A=대문자, 9=숫자, #=영숫자, ?=임의) 또는 ^...$ 정규식" />
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="118" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="전경 대비 (2~80 GV)" Style="{StaticResource Fluent2ParameterLabelStyle}" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="2" Maximum="80" TickFrequency="1" Value="{Binding OcvForegroundContrast, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding OcvForegroundContrast, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="118" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="인쇄 명암 극성" Style="{StaticResource Fluent2ParameterLabelStyle}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding OcvPolarityOptions}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Polarity"
                                          SelectedValue="{Binding SelectedOcvPolarity}" />
                            </Grid>

                            <CheckBox Content="기존 골든 폰트에 문자 샘플 누적 추가 (동일 인쇄 여러 줄 티칭 시 사용)"
                                      IsChecked="{Binding OcvAppendTeachMode}"
                                      FontSize="10"
                                      Margin="0,0,0,6" />

                            <UniformGrid Columns="3" Margin="0,0,0,4">
                                <Button Content="선택 ROI 폰트 티칭" Command="{Binding TeachSelectedRoiOcvFont}" Style="{StaticResource PrimaryButton}" Height="27" FontSize="10" Margin="0,0,3,0" />
                                <Button Content="선택 ROI OCV 검증" Command="{Binding VerifySelectedRoiOcv}" Style="{StaticResource PrimaryButton}" Height="27" FontSize="10" Margin="1,0,2,0" />
                                <Button Content="전체 ROI OCV 검증" Command="{Binding VerifyAllRoisOcv}" Style="{StaticResource SecondaryButton}" Height="27" FontSize="10" Margin="2,0,0,0" />
                            </UniformGrid>

                            <UniformGrid Columns="3" Margin="0,0,0,6">
                                <Button Content="골든 폰트 저장…" Command="{Binding SaveOcvFontModel}" Style="{StaticResource SecondaryButton}" Height="24" FontSize="9.8" Margin="0,0,3,0" />
                                <Button Content="골든 폰트 불러오기…" Command="{Binding LoadOcvFontModel}" Style="{StaticResource SecondaryButton}" Height="24" FontSize="9.8" Margin="1,0,2,0" />
                                <Button Content="폰트 초기화" Command="{Binding ClearOcvFontModel}" Style="{StaticResource SecondaryButton}" Height="24" FontSize="9.8" Margin="2,0,0,0" />
                            </UniformGrid>

                            <ListBox ItemsSource="{Binding OcvVerificationItems}"
                                     SelectedItem="{Binding SelectedOcvVerificationItem}"
                                     Visibility="{Binding HasOcvVerificationItems, Converter={StaticResource BoolVisibility}}"
                                     MaxHeight="150"
                                     Margin="0,0,0,5">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,2">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Background="{Binding VerdictAccent}" CornerRadius="3" Padding="5,1" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding VerdictBadge}" Foreground="#0F172A" FontSize="9" FontWeight="Bold" />
                                                </Border>
                                                <TextBlock Text="{Binding RoiName}" FontWeight="SemiBold" FontSize="10" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding DecodedText}" FontFamily="Consolas" FontSize="10" FontWeight="Bold" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding CauseSummary}" FontSize="9.2" Foreground="#FBBF24" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding RecommendedAction}" FontSize="9" Foreground="#94A3B8" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <ItemsControl ItemsSource="{Binding SelectedOcvCharacterItems}"
                                          Visibility="{Binding HasSelectedOcvCharacterItems, Converter={StaticResource BoolVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,1">
                                            <Border DockPanel.Dock="Left" Background="{Binding VerdictAccent}" CornerRadius="2" Padding="4,0" Margin="0,0,5,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding VerdictBadge}" Foreground="#0F172A" FontSize="8.5" FontWeight="Bold" />
                                            </Border>
                                            <TextBlock Text="{Binding SummaryLine}" FontFamily="Consolas, Malgun Gothic" FontSize="9.2" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Execution Results & Master 8K Suite Verification -->
                    <Border Style="{StaticResource Fluent2SurfaceCardStyle}" IsEnabled="{Binding IsIdle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,5">
                                <Button DockPanel.Dock="Right" Content="결과 위치로 맞춤" Command="{Binding Locate}" Style="{StaticResource SecondaryButton}" Height="23" Padding="7,0" FontSize="10" />
                                <CheckBox Content="캔버스 기하/특징점 오버레이 표시" IsChecked="{Binding ShowOverlay}" VerticalAlignment="Center" />
                            </DockPanel>

                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="8,6" MinHeight="145" MaxHeight="260" Margin="0,0,0,6">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding Results}" TextWrapping="Wrap" FontSize="10.5" LineHeight="15" />
                                </ScrollViewer>
                            </Border>

                            <Button Content="8K 전수 통합 검증 실행 (11종 스위트 + OCR/코너/자동티칭 19종)"
                                    Command="{Binding RunMaster8kBenchmark}"
                                    Style="{StaticResource SecondaryButton}"
                                    Height="28" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Pinned Bottom Execution Bar -->
        <Border Grid.Row="1" Style="{StaticResource Fluent2SurfaceCardStyle}" Margin="0,6,0,0" Padding="10,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Content="선택 ROI 실행" Command="{Binding ExecuteSelected}" Style="{StaticResource PrimaryButton}" Width="104" Height="32" Margin="0,0,5,0" />
                    <Button Content="전체 ROI 실행" Command="{Binding ExecuteAllRois}" Style="{StaticResource PrimaryButton}" Width="104" Height="32" Margin="0,0,5,0" />
                    <Button Content="취소" Command="{Binding Cancel}" Style="{StaticResource SecondaryButton}" Width="60" Height="32" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="11.5" />
                    <TextBlock Text="{Binding OptionsError}" Foreground="{StaticResource RoseAccent}" TextWrapping="Wrap" FontSize="10" />
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,3,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
