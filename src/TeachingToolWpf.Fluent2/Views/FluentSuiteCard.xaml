                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding AnisotropicDiffusionKappa, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Vincent 재구성 마커 반경 (1~10 px)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ReconstructionMarkerRadius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding ReconstructionMarkerRadius, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>
                            </StackPanel>

                            <!-- [Page 14] Composite Caliper & Fitzgibbon/Sampson Ellipse Fitting Parameters -->
                            <StackPanel Visibility="{Binding IsAdvancedMetrologyEllipseSelected, Converter={StaticResource BoolVisibility}}">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="복합 캘리퍼 목표 폭 (4~160 px)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="4" Maximum="160" TickFrequency="0.5" Value="{Binding CompositeExpectedSpanPx, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding CompositeExpectedSpanPx, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="타원 방사 스포크 수 (8~64개)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="8" Maximum="64" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding EllipseSpokeCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding EllipseSpokeCount, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Sampson 허용 잔차 RMS (0.2~8 px)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="0.2" Maximum="8.0" TickFrequency="0.1" Value="{Binding EllipseMaxRmsErrorPx, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding EllipseMaxRmsErrorPx, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="서브픽셀 가우시안 σ (0.4~6.0)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="0.4" Maximum="6.0" TickFrequency="0.1" Value="{Binding GaussianSigma, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding GaussianSigma, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="최소 에지 기울기 대비 (2~120)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="2" Maximum="120" TickFrequency="1" Value="{Binding MinimumContrast, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding MinimumContrast, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>
                            </StackPanel>

                            <!-- [Page 15] Advanced Blob Topology & Meijster EDT Watershed Parameters -->
                            <StackPanel Visibility="{Binding IsAdvancedBlobWatershedSelected, Converter={StaticResource BoolVisibility}}">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="워터셰드 이진화 밝기 (1~254 GV)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="1" Maximum="254" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding WatershedThresholdIntensity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding WatershedThresholdIntensity, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="EDT 시드 최소 분리 거리 (3~80 px)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="3" Maximum="80" TickFrequency="0.5" Value="{Binding WatershedMinPeakDistancePx, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding WatershedMinPeakDistancePx, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="분리 객체 최소 면적 (1~1000 px)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="1" Maximum="1000" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding WatershedMinAreaPixels, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding WatershedMinAreaPixels, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>
                            </StackPanel>

                            <!-- [Page 16] ISO/IEC 16022 ECC 200 2D DataMatrix & Reed-Solomon Parameters -->
                            <StackPanel Visibility="{Binding IsDataMatrix2DSelected, Converter={StaticResource BoolVisibility}}">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ISO 15415 최소 심볼 대비 (0.05~0.9)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="0.05" Maximum="0.90" TickFrequency="0.01" Value="{Binding DataMatrixMinIsoContrast, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding DataMatrixMinIsoContrast, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="RS(GF 2^8) 최대 허용 정정수 (0~32)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="0" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding DataMatrixMaxEccErrors, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding DataMatrixMaxEccErrors, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>
                            </StackPanel>

                            <!-- [Page 17] 2D Radix-2 FFT Notch, Homomorphic & Gabor Filter Parameters -->
                            <StackPanel Visibility="{Binding IsPreprocessingFftGaborSelected, Converter={StaticResource BoolVisibility}}">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="노치/Gabor 주파수 대역폭 σ (0.6~10)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="0.6" Maximum="10.0" TickFrequency="0.1" Value="{Binding FftNotchOrGaborSigma, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding FftNotchOrGaborSigma, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="FFT 주기 피크 억제 임계비 (1.5~12x)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="1.5" Maximum="12.0" TickFrequency="0.1" Value="{Binding FftPeakThresholdRatio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding FftPeakThresholdRatio, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="호모모픽 고주파 증폭 γH (1.0~3.5)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="1.0" Maximum="3.5" TickFrequency="0.05" Value="{Binding HomomorphicGammaHigh, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding HomomorphicGammaHigh, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>
                            </StackPanel>

                            <!-- [Page 18] Code 128B 1D Multi-Scanline Sub-Pixel Barcode Parameters -->
                            <StackPanel Visibility="{Binding IsBarcode1DSelected, Converter={StaticResource BoolVisibility}}">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="다중 스캔라인 투표 줄 수 (1~25)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="1" Maximum="25" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding BarcodeScanlineCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding BarcodeScanlineCount, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ISO 15416 최소 심볼 대비 (0.05~0.9)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="0.05" Maximum="0.90" TickFrequency="0.01" Value="{Binding BarcodeMinSymbolContrast, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding BarcodeMinSymbolContrast, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>
                            </StackPanel>

                            <!-- [Page 19] Woodham 4-Light Photometric Stereo & 3D Curvature Parameters -->
                            <StackPanel Visibility="{Binding IsPhotometricStereoSelected, Converter={StaticResource BoolVisibility}}">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="조명 링 경사 고도각 (15~75°)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="15" Maximum="75" TickFrequency="1" Value="{Binding PhotometricSlantAngleDeg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding PhotometricSlantAngleDeg, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="3D 평균곡률 |H| 결함 임계 (0.01~0.45)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="0.01" Maximum="0.45" TickFrequency="0.005" Value="{Binding PhotometricCurvatureThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding PhotometricCurvatureThreshold, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="허용 최대 곡률 결함 화소수 (1~500 px)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="1" Maximum="500" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding PhotometricMaxDefectPixels, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding PhotometricMaxDefectPixels, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>
                            </StackPanel>

                            <!-- [Page 20] Sub-Pixel Geometric Dimensioning & Tolerancing (GD&T) Parameters -->
                            <StackPanel Visibility="{Binding IsGeometricTolerancingSelected, Converter={StaticResource BoolVisibility}}">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="데이텀 직교도 허용 공차 (0.2~15°)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="0.2" Maximum="15.0" TickFrequency="0.1" Value="{Binding GdtAngleToleranceDeg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding GdtAngleToleranceDeg, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="이중 보어 동심도 한계 Δc (0.2~20 px)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="0.2" Maximum="20.0" TickFrequency="0.1" Value="{Binding GdtConcentricityLimitPx, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding GdtConcentricityLimitPx, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="보어-데이텀 거리 공차 (0.2~30 px)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="0.2" Maximum="30.0" TickFrequency="0.2" Value="{Binding GdtDistanceTolerancePx, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding GdtDistanceTolerancePx, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="서브픽셀 에지 최소 대비 (2~120)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="2" Maximum="120" TickFrequency="1" Value="{Binding GdtGradientThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding GdtGradientThreshold, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Execution Results & Master 8K Suite Verification -->
                    <Border Style="{StaticResource Fluent2SurfaceCardStyle}" IsEnabled="{Binding IsIdle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,5">
                                <Button DockPanel.Dock="Right" Content="결과 위치로 맞춤" Command="{Binding Locate}" Style="{StaticResource SecondaryButton}" Height="23" Padding="7,0" FontSize="10" />
                                <CheckBox Content="캔버스 기하/특징점 오버레이 표시" IsChecked="{Binding ShowOverlay}" VerticalAlignment="Center" />
                            </DockPanel>

                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="8,6" MinHeight="145" MaxHeight="260" Margin="0,0,0,6">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding Results}" TextWrapping="Wrap" FontSize="10.5" LineHeight="15" />
                                </ScrollViewer>
                            </Border>

                            <Button Content="8K 전수 통합 검증 실행 (11종 스위트 + OCR/코너/자동티칭 19종)"
                                    Command="{Binding RunMaster8kBenchmark}"
                                    Style="{StaticResource SecondaryButton}"
                                    Height="28" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Pinned Bottom Execution Bar -->
        <Border Grid.Row="1" Style="{StaticResource Fluent2SurfaceCardStyle}" Margin="0,6,0,0" Padding="10,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Content="선택 ROI 실행" Command="{Binding ExecuteSelected}" Style="{StaticResource PrimaryButton}" Width="104" Height="32" Margin="0,0,5,0" />
                    <Button Content="전체 ROI 실행" Command="{Binding ExecuteAllRois}" Style="{StaticResource PrimaryButton}" Width="104" Height="32" Margin="0,0,5,0" />
                    <Button Content="취소" Command="{Binding Cancel}" Style="{StaticResource SecondaryButton}" Width="60" Height="32" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="11.5" />
                    <TextBlock Text="{Binding OptionsError}" Foreground="{StaticResource RoseAccent}" TextWrapping="Wrap" FontSize="10" />
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,3,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
