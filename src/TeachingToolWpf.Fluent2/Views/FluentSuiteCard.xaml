<UserControl x:Class="TeachingToolWpf.Fluent2.Views.FluentSuiteCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TeachingToolWpf.Controls;assembly=TeachingToolWpf.Presentation"
             Validation.Error="OnValidationError">
    <Grid DataContext="{Binding Studio.Inspections.Suite}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.98*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="1.02*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: ComboBox Algorithm Selector, Sample Loader, Step-by-Step Guide & Reference Teaching -->
                <StackPanel Grid.Column="0" IsEnabled="{Binding IsIdle}">
                    <Border Style="{StaticResource Fluent2SurfaceCardStyle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,5">
                                <Button DockPanel.Dock="Right" Content="? 매뉴얼" Command="{Binding ToggleHelpManual}"
                                        Style="{StaticResource SecondaryButton}" Padding="8,2" Height="22" FontSize="10.5" FontWeight="Bold"
                                        ToolTip="현재 선택된 알고리즘의 상세 수식 원리·단계별 티칭·파라미터 튜닝 매뉴얼을 펼치거나 닫습니다." />
                                <TextBlock Text="1 · 알고리즘 카테고리 선택" Style="{StaticResource CardHeaderTitle}" VerticalAlignment="Center" />
                            </DockPanel>

                            <UniformGrid Columns="4" Margin="0,0,0,2">
                                <Button Content="치수·기하계측 (5)" Command="{Binding SelectMetrologyCategory}" Margin="0,0,2,0" Padding="4,3" MinHeight="24" FontSize="10">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMetrologyCategorySelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="블롭·표면·3D (6)" Command="{Binding SelectSurface3DCategory}" Margin="1,0,1,0" Padding="4,3" MinHeight="24" FontSize="10">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSurface3DCategorySelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="OCR·문자인식" Command="{Binding SelectOcrCategory}" Margin="1,0,1,0" Padding="4,3" MinHeight="24" FontSize="10" ToolTip="산업용 도트·레이저 OCR·OCV (권장) / [실험용] 경량 고속 1-Pass 조닝 OCR / 다중 대비 앙상블 OCR / PP-OCR (ONNX)">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOcrCategorySelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="1D·2D 바코드 (2)" Command="{Binding SelectBarcodeCategory}" Margin="2,0,0,0" Padding="4,3" MinHeight="24" FontSize="10" ToolTip="1D Code 128 바코드 / 2D DataMatrix ECC 200">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBarcodeCategorySelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </UniformGrid>
                            <UniformGrid Columns="3" Margin="0,2,0,5">
                                <Button Content="AI·자동티칭 (2)" Command="{Binding SelectAiAutoTeachingCategory}" Margin="0,0,2,0" Padding="4,3" MinHeight="24" FontSize="10">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAiAutoTeachingCategorySelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="조명·FFT·Gabor (2)" Command="{Binding SelectPreprocessingCategory}" Margin="1,0,1,0" Padding="4,3" MinHeight="24" FontSize="10">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPreprocessingCategorySelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="전체 보기 (20)" Command="{Binding SelectAllCategories}" Margin="2,0,0,0" Padding="4,3" MinHeight="24" FontSize="10">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAllCategoriesSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </UniformGrid>

                            <TextBlock Text="{Binding ActiveCategoryTitle}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,4" />

                            <ItemsControl ItemsSource="{Binding CategoryAlgorithms}" Margin="0,0,0,5">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding ShortPillLabel}"
                                                Command="{Binding SelectCommand}"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="7,2"
                                                MinHeight="22"
                                                FontSize="10"
                                                Margin="0,0,4,4"
                                                ToolTip="{Binding Name}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ComboBox ItemsSource="{Binding CategoryAlgorithms}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Kind"
                                      SelectedValue="{Binding SelectedAlgorithm}"
                                      Margin="0,0,0,6" />

                            <Border x:Name="HelpManualBorder"
                                    Visibility="{Binding IsHelpManualOpen, Converter={StaticResource BoolVisibility}}"
                                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                    BorderThickness="3,1,1,1"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    Margin="0,0,0,6">
                                <StackPanel DataContext="{Binding ActiveHelpManual}">
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right" Content="닫기 ✕" Command="{Binding DataContext.Studio.Inspections.Suite.ToggleHelpManual, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource SecondaryButton}" Padding="6,1" Height="20" FontSize="9.5" />
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <TextBlock Text="■ 핵심 원리 및 수식" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding PrincipleAndFormula}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="14.5" Margin="0,0,0,6" />
                                    <TextBlock Text="■ 단계별 티칭 및 사용 방법" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding StepByStepGuide}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="14.5" Margin="0,0,0,6" />
                                    <TextBlock Text="■ 주요 파라미터 튜닝 가이드" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding ParameterTuningGuide}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="14.5" Margin="0,0,0,6" />
                                    <TextBlock Text="■ 현장 트러블슈팅 팁" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding TroubleshootingTips}" FontSize="10" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" TextWrapping="Wrap" LineHeight="14.5" />
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                <TextBlock Text="{Binding AlgorithmDescription}" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>

                            <Button Content="▶ 현재 선택 알고리즘 전용 샘플 영상 불러오기 (직접 ROI 티칭)"
                                    Command="{Binding LoadSelectedAlgorithmSample}"
                                    Style="{StaticResource PrimaryButton}"
                                    Height="30" />

                            <!-- Dedicated OCR Benchmark Images Quick Loader (Visible when any OCR algorithm is selected) -->
                            <Border Visibility="{Binding IsAnyOcrSelected, Converter={StaticResource BoolVisibility}}"
                                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                    BorderThickness="1"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="5"
                                    Padding="7,6"
                                    Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="★ OCR 실전 테스트 이미지 + ROI 원클릭 열기 (ocr1 ~ ocr7 / expire)"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                               Margin="0,0,0,4" />
                                    <UniformGrid Columns="4" Margin="0,0,0,3">
                                        <Button Content="ocr1 (영문4줄)"
                                                Command="{Binding DataContext.LoadOcrTest01, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource SecondaryButton}"
                                                Height="23"
                                                FontSize="9.5"
                                                Margin="0,0,2,0"
                                                ToolTip="ocr1.png 영문/숫자 4줄 불러오기 및 OCR 실행" />
                                        <Button Content="ocr2 (청구서)"
                                                Command="{Binding DataContext.LoadOcrTest02, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource SecondaryButton}"
                                                Height="23"
                                                FontSize="9.5"
                                                Margin="1,0"
                                                ToolTip="ocr2.png 소형 비례 폰트/OCR 폰트 영수증 불러오기 및 OCR 실행" />
                                        <Button Content="ocr3 (레이저)"
                                                Command="{Binding DataContext.LoadOcrTest03, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource SecondaryButton}"
                                                Height="23"
                                                FontSize="9.5"
                                                Margin="1,0"
                                                ToolTip="ocr3.png 금속 캡 레이저 각인 불러오기 및 OCR 실행" />
                                        <Button Content="ocr4 (영수증)"
                                                Command="{Binding DataContext.LoadOcrTest04, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource SecondaryButton}"
                                                Height="23"
                                                FontSize="9.5"
                                                Margin="2,0,0,0"
                                                ToolTip="ocr4.png 감열식 영수증 불러오기 및 OCR 실행" />
                                    </UniformGrid>
                                    <UniformGrid Columns="4">
                                        <Button Content="ocr5 (한글번호판)"
                                                Command="{Binding DataContext.LoadOcrTest05, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource SecondaryButton}"
                                                Height="24"
                                                FontSize="9.5"
                                                FontWeight="SemiBold"
                                                Margin="0,0,2,0"
                                                ToolTip="ocr5.png 한글 자동차 번호판 (123 가 4568) 불러오기 및 OCR 실행" />
                                        <Button Content="ocr6 (실전영수증)"
                                                Command="{Binding DataContext.LoadOcrTest06, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource PrimaryButton}"
                                                Height="24"
                                                FontSize="9.5"
                                                FontWeight="SemiBold"
                                                Margin="1,0"
                                                ToolTip="ocr6.jpg 실전 마트 영수증 전체 19줄 불러오기 및 OCR 실행" />
                                        <Button Content="ocr7 (종합타깃)"
                                                Command="{Binding DataContext.LoadOcrTest07, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource PrimaryButton}"
                                                Height="24"
                                                FontSize="9.5"
                                                FontWeight="SemiBold"
                                                Margin="1,0"
                                                ToolTip="OCR7.jpg 산업용 종합 테스트 타깃 (도트매트릭스/저대비/손상/반전/기울기) 불러오기 및 OCR 실행" />
                                        <Button Content="expire (캔유통기한)"
                                                Command="{Binding DataContext.LoadOcrTest08, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource PrimaryButton}"
                                                Height="24"
                                                FontSize="9.5"
                                                FontWeight="SemiBold"
                                                Margin="2,0,0,0"
                                                ToolTip="expire.jpg 금속 캔 하단 5x7 도트매트릭스 유통기한 (2024/01/28 &amp; 14:00 QZ) 불러오기 및 OCR 실행" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Step-by-Step Usage Guide Card -->
                    <Border Style="{StaticResource Fluent2SurfaceCardStyle}">
                        <StackPanel>
                            <TextBlock Text="2 · 선택 알고리즘 사용 가이드 (Step-by-Step)" Style="{StaticResource CardHeaderTitle}" Margin="0,0,0,4" />
                            <Border BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                    BorderThickness="3,0,0,0"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="4"
                                    Padding="8,6">
                                <TextBlock Text="{Binding AlgorithmUsageGuide}"
                                           TextWrapping="Wrap"
                                           FontSize="10.5"
                                           LineHeight="15" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Reference / AutoTeaching Part Model Pool Registration & Management Card -->
                    <Border Style="{StaticResource Fluent2SurfaceCardStyle}"
                            Visibility="{Binding UsesReferenceRois, Converter={StaticResource BoolVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ReferenceCardTitle}" Style="{StaticResource CardHeaderTitle}" Margin="0,0,0,5" />
                            <UniformGrid Columns="3" Margin="0,0,0,5">
                                <Button Content="{Binding RegisterNormalButtonText}" Command="{Binding RegisterNormalReference}" Style="{StaticResource PrimaryButton}" Margin="0,0,3,0" FontSize="10.5" />
                                <Button Content="불량(NG) 등록" Command="{Binding RegisterDefectReference}" Style="{StaticResource SecondaryButton}" Margin="2,0,2,0" FontSize="10.5" />
                                <Button Content="모델 풀 초기화" Command="{Binding ClearReferences}" Style="{StaticResource SecondaryButton}" Margin="3,0,0,0" FontSize="10.5" />
                            </UniformGrid>
                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,5" Margin="0,0,0,5">
                                <TextBlock Text="{Binding ReferenceSummary}" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            </Border>

                            <!-- Registered Part Model Pool / Reference ROI List -->
                            <ItemsControl ItemsSource="{Binding RegisteredReferenceItems}"
                                          Visibility="{Binding HasRegisteredReferences, Converter={StaticResource BoolVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="5"
                                                Padding="7,5"
                                                Margin="0,0,0,4"
                                                Background="{DynamicResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{Binding RoleAccent}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        CornerRadius="3"
                                                        Padding="5,2"
                                                        Margin="0,0,7,0"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                        BorderBrush="{Binding RoleAccent}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding RoleBadge}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="10.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding GeometrySummary}" FontSize="9.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding ChildTargetSummary}" FontSize="9" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Content="삭제"
                                                        Command="{Binding RemoveCommand}"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="7,2"
                                                        Height="22"
                                                        FontSize="9.5"
                                                        VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Column: Dedicated Per-Algorithm Teaching Parameter Pages & Live Results -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Fluent2SurfaceCardStyle}" IsEnabled="{Binding IsIdle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <CheckBox DockPanel.Dock="Right" Content="실시간 프리뷰" IsChecked="{Binding AutoPreview}" FontSize="10" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedAlgorithmHeaderTitle}" Style="{StaticResource CardHeaderTitle}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>

                            <Border BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                    BorderThickness="2,0,0,0"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="4"
                                    Padding="8,5"
                                    Margin="0,0,0,8">
                                <TextBlock Text="{Binding ParameterPreviewSummary}" TextWrapping="Wrap" FontSize="10" />
                            </Border>

                            <!-- Real-Time Intuitive OCR Visual Diagnostic & Readout Preview Card (Visible for all 3 OCR algorithms) -->
                            <Border Visibility="{Binding IsAnyOcrSelected, Converter={StaticResource BoolVisibility}}"
                                    Background="#181C24"
                                    BorderBrush="#2E3646"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="9,8"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <!-- Top Row: Live Verdict Badge & Preprocessing Summary -->
                                    <DockPanel Margin="0,0,0,5">
                                        <Border DockPanel.Dock="Right"
                                                Background="{Binding OcrLiveVerdictAccent}"
                                                CornerRadius="4"
                                                Padding="7,2"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OcrLiveVerdictBadge}"
                                                       Foreground="#0F172A"
                                                       FontSize="9.5"
                                                       FontWeight="Bold" />
                                        </Border>
                                        <TextBlock Text="실시간 OCR 판독 · 전처리/이진화 프리뷰"
                                                   Foreground="#38BDF8"
                                                   FontSize="10.5"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>

                                    <!-- Large Recognized Text Banner -->
                                    <Border Background="#0F131A"
                                            BorderBrush="#334155"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="9,6"
                                            Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding OcrLiveRecognizedText}"
                                                       Foreground="#F8FAFC"
                                                       FontFamily="Consolas, Malgun Gothic"
                                                       FontSize="13.5"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="58" />
                                            <DockPanel Margin="0,4,0,0">
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding OcrLiveConfidenceBadge}"
                                                           Foreground="#94A3B8"
                                                           FontSize="9.5"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding OcrLivePolarityAndCharSummary}"
                                                           Foreground="#64748B"
                                                           FontSize="9.5"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <ProgressBar Minimum="0"
                                                         Maximum="100"
                                                         Value="{Binding OcrLiveConfidencePercent, Mode=OneWay}"
                                                         Height="4"
                                                         Margin="0,4,0,0"
                                                         Foreground="{Binding OcrLiveVerdictAccent}"
                                                         Background="#1E293B" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Side-by-Side Live Preprocessed Gray & Adaptive Binarized + Character Box Preview -->
                                    <Grid Visibility="{Binding HasOcrLivePreviewImages, Converter={StaticResource BoolVisibility}}"
                                          Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Background="#090D14"
                                                BorderBrush="#263042"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="4">
                                            <StackPanel>
                                                <TextBlock Text="① 전처리·선명화/도트연결 영상"
                                                           Foreground="#94A3B8"
                                                           FontSize="9.2"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,3" />
                                                <Border Height="68" Background="#05070B" CornerRadius="3" ClipToBounds="True">
                                                    <Image Source="{Binding OcrEnhancedPreviewImage}"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2"
                                                Background="#090D14"
                                                BorderBrush="#263042"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="4">
                                            <StackPanel>
