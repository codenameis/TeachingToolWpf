<UserControl x:Class="TeachingToolWpf.Fluent2.Views.FluentFewShotCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TeachingToolWpf.Controls;assembly=TeachingToolWpf.Presentation"
             Validation.Error="OnValidationError">
    <Grid DataContext="{Binding Studio.Inspections.FewShot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Bento Column: Sample Registration & 1920x1080 3-Column Mahalanobis Parameter Sliders -->
                <StackPanel Grid.Column="0" IsEnabled="{Binding IsIdle}">
                    <Border Style="{StaticResource Fluent2SurfaceCardStyle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Content="? 매뉴얼" Command="{Binding ToggleHelpManual}"
                                        Style="{StaticResource SecondaryButton}" Padding="8,2" Height="22" FontSize="10.5" FontWeight="Bold"
                                        ToolTip="소량 샘플 분류 및 마할라노비스 OOD 이상 탐지 알고리즘의 상세 수식·티칭 방법·파라미터 튜닝 매뉴얼을 펼치거나 닫습니다." />
                                <TextBlock Text="1 · 소량 ROI 클래스 샘플 등록" Style="{StaticResource CardHeaderTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Visibility="{Binding IsHelpManualOpen, Converter={StaticResource BoolVisibility}}"
                                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                    BorderThickness="3,1,1,1"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    Margin="0,2,0,6">
                                <StackPanel DataContext="{Binding ActiveHelpManual}">
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right" Content="닫기 ✕" Command="{Binding DataContext.Studio.Inspections.FewShot.ToggleHelpManual, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource SecondaryButton}" Padding="6,1" Height="20" FontSize="9.5" />
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <TextBlock Text="■ 핵심 원리 및 수식" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding PrincipleAndFormula}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="14.5" Margin="0,0,0,6" />
                                    <TextBlock Text="■ 단계별 티칭 및 사용 방법" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding StepByStepGuide}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="14.5" Margin="0,0,0,6" />
                                    <TextBlock Text="■ 주요 파라미터 튜닝 가이드" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding ParameterTuningGuide}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="14.5" Margin="0,0,0,6" />
                                    <TextBlock Text="■ 현장 트러블슈팅 팁" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding TroubleshootingTips}" FontSize="10" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" TextWrapping="Wrap" LineHeight="14.5" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="클래스당 5~20장의 소량 ROI 샘플로 K-Means++ 다중 프로토타입과 Ledoit-Wolf 수축 공분산을 학습합니다."
                                       TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />

                            <UniformGrid Columns="2" Margin="0,0,0,5">
                                <Button Content="선택 ROI → 정상(Good)" Command="{Binding RegisterGood}" Style="{StaticResource SecondaryButton}" Margin="0,0,3,0" />
                                <Button Content="선택 ROI → 불량(Bad)" Command="{Binding RegisterDefect}" Style="{StaticResource SecondaryButton}" Margin="3,0,0,0" />
                            </UniformGrid>
                            <UniformGrid Columns="2" Margin="0,0,0,6">
                                <Button Content="단일 보드 10개 자동 등록" Command="{Binding RegisterBoardPreset}" Style="{StaticResource SecondaryButton}" Margin="0,0,3,0" />
                                <Button Content="등록 샘플 초기화" Command="{Binding ClearSamples}" Style="{StaticResource SecondaryButton}" Margin="3,0,0,0" />
                            </UniformGrid>

                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,5">
                                <TextBlock Text="{Binding SampleSummary}" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Fluent2SurfaceCardStyle}">
                        <StackPanel>
                            <TextBlock Text="2 · GeM 풀링 · Ledoit-Wolf 공분산 · OOD 수식" Style="{StaticResource CardHeaderTitle}" Margin="0,0,0,6" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="134" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="GeM 지수 p (1~10)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="1" Maximum="10" TickFrequency="0.1" Value="{Binding GemExponentP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding GemExponentP, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="134" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="수축 계수 λ (.01~.99)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="0.01" Maximum="0.99" TickFrequency="0.01" Value="{Binding ShrinkageLambda, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding ShrinkageLambda, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="134" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="서브 프로토타입 K (1~16)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="1" Maximum="16" TickFrequency="1" Value="{Binding SubPrototypesPerClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding SubPrototypesPerClass, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="134" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="자동 OOD 배수 (1~20)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="1" Maximum="20" TickFrequency="0.1" Value="{Binding OodThresholdMultiplier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding OodThresholdMultiplier, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="134" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="수동 OOD 임계치 (0=자동)" Style="{StaticResource Fluent2ParameterLabelStyle}" ToolTip="수동 OOD 마할라노비스 임계치 (0 = 자동 보정 사용)" />
                                <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="0" Maximum="50" TickFrequency="0.5" Value="{Binding ManualOodThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding ManualOodThreshold, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                            </Grid>

                            <Button Content="소량 샘플 공분산 모델 학습" Command="{Binding Train}" Style="{StaticResource PrimaryButton}" Height="30" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Bento Column: Model Status & Live OOD Classification Results -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Fluent2SurfaceCardStyle}">
                        <StackPanel>
                            <TextBlock Text="3 · 모델 상태 · 실시간 추론 결과" Style="{StaticResource CardHeaderTitle}" Margin="0,0,0,5" />
                            <Border BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="2,0,0,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,5" Margin="0,0,0,6">
                                <TextBlock Text="{Binding ParameterPreviewSummary}" TextWrapping="Wrap" FontSize="10.5" />
                            </Border>

                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,5" Margin="0,0,0,6">
                                <TextBlock Text="{Binding ModelSummary}" TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource EmeraldAccent}" />
                            </Border>

                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="결과 위치로 맞춤" Command="{Binding Locate}" Style="{StaticResource SecondaryButton}" Height="25" Padding="8,0" FontSize="10.5" />
                                <CheckBox Content="분류 오버레이 표시 (초록/주황/빨강)" IsChecked="{Binding ShowOverlay}" VerticalAlignment="Center" />
                            </DockPanel>

                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="8,6" MinHeight="210">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding Results}" TextWrapping="Wrap" FontSize="11" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Pinned Bottom Execution Bar -->
        <Border Grid.Row="1" Style="{StaticResource Fluent2SurfaceCardStyle}" Margin="0,6,0,0" Padding="10,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Content="선택 ROI 분류" Command="{Binding ClassifySelected}" Style="{StaticResource PrimaryButton}" Width="104" Height="32" Margin="0,0,5,0" />
                    <Button Content="전체 ROI 분류" Command="{Binding ClassifyAll}" Style="{StaticResource PrimaryButton}" Width="104" Height="32" Margin="0,0,5,0" />
                    <Button Content="취소" Command="{Binding Cancel}" Style="{StaticResource SecondaryButton}" Width="60" Height="32" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="11.5" />
                    <TextBlock Text="{Binding OptionsError}" Foreground="{StaticResource RoseAccent}" TextWrapping="Wrap" FontSize="10" />
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,3,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
