<UserControl x:Class="TeachingToolWpf.Fluent2.Views.FluentFilterCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TeachingToolWpf.Controls;assembly=TeachingToolWpf.Presentation"
             xmlns:filterControls="clr-namespace:VisionCanvas.Filters.Wpf.Controls;assembly=VisionCanvas.Filters.Wpf"
             xmlns:geometry="clr-namespace:VisionCanvas.Core.Geometry;assembly=VisionCanvas.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Bento Column: ROI Filter Preview & Viewport Display Settings -->
            <StackPanel Grid.Column="0">
                <!-- Card 1: Real-Time ROI Filter Preview -->
                <Border Style="{StaticResource Fluent2SurfaceCardStyle}" DataContext="{Binding Studio.Filters}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <CheckBox DockPanel.Dock="Right" Content="실시간 미리보기" IsChecked="{Binding IsPreviewEnabled, Mode=TwoWay}" />
                            <TextBlock Text="1 · ROI 실시간 필터 미리보기" Style="{StaticResource CardHeaderTitle}" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock Text="필터 종류 (원본 보존 · 선택 ROI 화면만 갱신)" Style="{StaticResource Caption}" />
                        <ComboBox ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedValuePath="Kind" SelectedValue="{Binding SelectedFilter}" Margin="0,0,0,6" />

                        <StackPanel Visibility="{Binding IsIndustrial, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,6">
                            <TextBlock Text="연산 장치 (CpuGpu = CUDA 우선)" Style="{StaticResource Caption}" />
                            <ComboBox ItemsSource="{Binding ExecutionOptions}" SelectedItem="{Binding Execution}" />
                        </StackPanel>

                        <Grid Visibility="{Binding UsesRadius, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="커널 반경 (1~31 px)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                            <filterControls:ParameterSlider Grid.Column="1" Minimum="1" Maximum="31" SmallChange="1" LargeChange="2" Value="{Binding RadiusValue, Mode=TwoWay}"
                                                            BeginEditCommand="{Binding BeginParameterEdit}" EndEditCommand="{Binding EndParameterEdit}" CancelEditCommand="{Binding CancelParameterEdit}" Margin="6,0,8,0" VerticalAlignment="Center" />
                            <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding Radius, UpdateSourceTrigger=LostFocus}" />
                        </Grid>

                        <Grid Visibility="{Binding UsesSigma, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="가우시안 σ (.01~100)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                            <filterControls:ParameterSlider Grid.Column="1" Minimum="0.01" Maximum="100" SmallChange="0.1" LargeChange="1" Value="{Binding SigmaValue, Mode=TwoWay}"
                                                            BeginEditCommand="{Binding BeginParameterEdit}" EndEditCommand="{Binding EndParameterEdit}" CancelEditCommand="{Binding CancelParameterEdit}" Margin="6,0,8,0" VerticalAlignment="Center" />
                            <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding Sigma, UpdateSourceTrigger=LostFocus}" />
                        </Grid>

                        <Grid Visibility="{Binding UsesThreshold, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ThresholdCaption}" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                            <filterControls:ParameterSlider Grid.Column="1" Minimum="0" Maximum="{Binding ThresholdMaximum}" SmallChange="1" LargeChange="10" Value="{Binding ThresholdValue, Mode=TwoWay}"
                                                            BeginEditCommand="{Binding BeginParameterEdit}" EndEditCommand="{Binding EndParameterEdit}" CancelEditCommand="{Binding CancelParameterEdit}" Margin="6,0,8,0" VerticalAlignment="Center" />
                            <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding Threshold, UpdateSourceTrigger=LostFocus}" />
                        </Grid>

                        <StackPanel Visibility="{Binding IsEdge, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,5">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Edge 하한 (0~255)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                <filterControls:ParameterSlider Grid.Column="1" Minimum="0" Maximum="255" SmallChange="1" Value="{Binding EdgeLowValue, Mode=TwoWay}"
                                                                BeginEditCommand="{Binding BeginParameterEdit}" EndEditCommand="{Binding EndParameterEdit}" CancelEditCommand="{Binding CancelParameterEdit}" Margin="6,0,8,0" VerticalAlignment="Center" />
                                <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding EdgeLow, UpdateSourceTrigger=LostFocus}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Edge 상한 (0~255)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                <filterControls:ParameterSlider Grid.Column="1" Minimum="0" Maximum="255" SmallChange="1" Value="{Binding EdgeHighValue, Mode=TwoWay}"
                                                                BeginEditCommand="{Binding BeginParameterEdit}" EndEditCommand="{Binding EndParameterEdit}" CancelEditCommand="{Binding CancelParameterEdit}" Margin="6,0,8,0" VerticalAlignment="Center" />
                                <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}" Text="{Binding EdgeHigh, UpdateSourceTrigger=LostFocus}" />
                            </Grid>
                        </StackPanel>

                        <UniformGrid Columns="2" Margin="0,2,0,4">
                            <Button Content="필터 설정 적용" Command="{Binding Apply}" Style="{StaticResource PrimaryButton}" Margin="0,0,3,0" />
                            <Button Content="필터 등록 해제" Command="{Binding ClearRegistration}" Style="{StaticResource SecondaryButton}" Margin="3,0,0,0" />
                        </UniformGrid>

                        <TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource RoseAccent}" TextWrapping="Wrap" FontSize="10" />
                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,5" Margin="0,3,0,0">
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Card 2: Crosshair, Minimap & Pixel Sampling -->
                <Border Style="{StaticResource Fluent2SurfaceCardStyle}" DataContext="{Binding Studio}">
                    <StackPanel>
                        <TextBlock Text="2 · 뷰포트 미니맵 · 중심 십자선 · 보간" Style="{StaticResource CardHeaderTitle}" Margin="0,0,0,6" />

                        <UniformGrid Columns="2" Margin="0,0,0,6">
                            <CheckBox Content="미니맵 표시" IsChecked="{Binding ShowMinimap}" />
                            <CheckBox Content="픽셀 선명 보간 (Point)" IsChecked="{Binding PointSampling}" />
                        </UniformGrid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="116" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="미니맵 배치 위치" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                            <ComboBox Grid.Column="1" SelectedValue="{Binding MinimapPosition, Mode=TwoWay}" SelectedValuePath="Tag" IsEnabled="{Binding ShowMinimap}">
                                <ComboBoxItem Content="좌상단 (TopLeft)" Tag="{x:Static geometry:MinimapPosition.TopLeft}" />
                                <ComboBoxItem Content="상단 중앙 (TopCenter)" Tag="{x:Static geometry:MinimapPosition.TopCenter}" />
                                <ComboBoxItem Content="우상단 (TopRight)" Tag="{x:Static geometry:MinimapPosition.TopRight}" />
                                <ComboBoxItem Content="오른쪽 중앙 (MiddleRight)" Tag="{x:Static geometry:MinimapPosition.MiddleRight}" />
                                <ComboBoxItem Content="우하단 (BottomRight)" Tag="{x:Static geometry:MinimapPosition.BottomRight}" />
                                <ComboBoxItem Content="하단 중앙 (BottomCenter)" Tag="{x:Static geometry:MinimapPosition.BottomCenter}" />
                                <ComboBoxItem Content="좌하단 (BottomLeft)" Tag="{x:Static geometry:MinimapPosition.BottomLeft}" />
                                <ComboBoxItem Content="왼쪽 중앙 (MiddleLeft)" Tag="{x:Static geometry:MinimapPosition.MiddleLeft}" />
                            </ComboBox>
                        </Grid>

                        <StackPanel DataContext="{Binding GuideSettings}">
                            <CheckBox Content="이미지 중심 크로스헤어 표시" IsChecked="{Binding IsVisible}" Margin="0,0,0,5" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="124" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="십자선 색상 (#RGB)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                <TextBox Grid.Column="1" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" MaxLength="9" Height="24" MinHeight="24" Padding="6,2" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="124" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="십자선 두께 (0.5~8)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="0.5" Maximum="8" TickFrequency="0.5" Value="{Binding Thickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}}" />
                                <controls:ValueTextBox Grid.Column="2" Style="{StaticResource ValueTextBoxStyle}" Value="{Binding Thickness, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <UniformGrid Columns="2">
                                <Button Content="십자선 적용" Command="{Binding Apply}" Style="{StaticResource SecondaryButton}" Margin="0,0,3,0" />
                                <Button Content="기본값" Command="{Binding Reset}" Style="{StaticResource SecondaryButton}" Margin="3,0,0,0" />
                            </UniformGrid>
                            <TextBlock Text="{Binding Error}" Foreground="{StaticResource RoseAccent}" TextWrapping="Wrap" FontSize="10" Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right Bento Column: ROI Masking & Role Stroke Styles (Zero Expander) -->
            <StackPanel Grid.Column="2">
                <!-- Card 3: ROI Masking (Always Open, No Expander) -->
                <Border Style="{StaticResource Fluent2SurfaceCardStyle}" DataContext="{Binding Studio.Masks}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <CheckBox DockPanel.Dock="Right" Content="사선 음영 표시" IsChecked="{Binding ShowMasks}" IsEnabled="{Binding CanToggleVisibility}" />
                            <TextBlock Text="3 · ROI 제외 영역 마스킹" Style="{StaticResource CardHeaderTitle}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" FontSize="10.5" Margin="0,0,0,5" />

                        <Button Content="▦ 패턴 마스크 전용 편집기 열기" Command="{Binding OpenPatternMaskEditor}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,5" />

                        <UniformGrid Columns="2" Margin="0,0,0,5">
                            <Button Content="▧ 사각형 마스크 추가" Command="{Binding DrawRectangle}" Style="{StaticResource SecondaryButton}" Margin="0,0,3,0" />
                            <Button Content="◉ 타원 마스크 추가" Command="{Binding DrawEllipse}" Style="{StaticResource SecondaryButton}" Margin="3,0,0,0" />
                        </UniformGrid>

                        <Button Content="마스크 그리기 완료" Command="{Binding Finish}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,5" Visibility="{Binding IsDrawing, Converter={StaticResource BoolVisibility}}" />
                        <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,5" />

                        <ListBox ItemsSource="{Binding Rows}" SelectedIndex="{Binding SelectedIndex}" DisplayMemberPath="Name" MaxHeight="100" Margin="0,0,0,6" Visibility="{Binding HasMasks, Converter={StaticResource BoolVisibility}}" />

                        <!-- Mask Coordinates Directly Visible (No Expander) -->
                        <StackPanel Visibility="{Binding HasSelectedMask, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,6">
                            <TextBlock Text="선택 마스크 로컬 좌표 · 크기 (px)" Style="{StaticResource SectionBadgeText}" Margin="0,0,0,4" />
                            <UniformGrid Columns="2" Margin="0,0,0,5">
                                <StackPanel Margin="0,0,3,3">
                                    <TextBlock Text="X" Style="{StaticResource Caption}" />
                                    <controls:ValueTextBox Value="{Binding X, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ValueTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Margin="3,0,0,3">
                                    <TextBlock Text="Y" Style="{StaticResource Caption}" />
                                    <controls:ValueTextBox Value="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ValueTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,3,0">
                                    <TextBlock Text="너비" Style="{StaticResource Caption}" />
                                    <controls:ValueTextBox Value="{Binding Width, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ValueTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Margin="3,0,0,0">
                                    <TextBlock Text="높이" Style="{StaticResource Caption}" />
                                    <controls:ValueTextBox Value="{Binding Height, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ValueTextBoxStyle}" />
                                </StackPanel>
                            </UniformGrid>
                            <Button Content="선택 마스크 좌표 적용" Command="{Binding Apply}" Style="{StaticResource SecondaryButton}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource RoseAccent}" TextWrapping="Wrap" FontSize="10" Margin="0,0,0,4" />

                        <UniformGrid Columns="2" Visibility="{Binding HasMasks, Converter={StaticResource BoolVisibility}}">
                            <Button Content="선택 마스크 삭제" Command="{Binding Remove}" Style="{StaticResource DangerGlassButton}" Margin="0,0,3,0" />
                            <Button Content="마스크 전체 삭제" Command="{Binding Clear}" Style="{StaticResource SecondaryButton}" Margin="3,0,0,0" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Card 4: ROI Role Thickness & Handle Scale (Full-Width 3-Column Sliders) -->
                <Border Style="{StaticResource Fluent2SurfaceCardStyle}" DataContext="{Binding Studio.StyleSettings}">
                    <StackPanel>
                        <TextBlock Text="4 · ROI 역할별 선 두께 · 핸들 배율" Style="{StaticResource CardHeaderTitle}" Margin="0,0,0,6" />

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="124" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="편집 핸들 배율" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                            <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="0.5" Maximum="3.0" SmallChange="0.1" LargeChange="0.25" TickFrequency="0.25" Value="{Binding HandleScale, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" Text="{Binding HandleScale, StringFormat={}{0:P0}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="124" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="독립 ROI 두께 (DIP)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                            <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="0.5" Maximum="8" TickFrequency="0.5" Value="{Binding DefaultThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}}" />
                            <controls:ValueTextBox Grid.Column="2" Style="{StaticResource ValueTextBoxStyle}" Value="{Binding DefaultThickness, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="124" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="자식 ROI 두께 (DIP)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                            <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="0.5" Maximum="8" TickFrequency="0.5" Value="{Binding ChildThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}}" />
                            <controls:ValueTextBox Grid.Column="2" Style="{StaticResource ValueTextBoxStyle}" Value="{Binding ChildThickness, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="124" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="그룹 부모 두께 (DIP)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                            <Slider Grid.Column="1" Style="{StaticResource Fluent2SliderStyle}" Minimum="0.5" Maximum="8" TickFrequency="0.5" Value="{Binding ParentThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}}" />
                            <controls:ValueTextBox Grid.Column="2" Style="{StaticResource ValueTextBoxStyle}" Value="{Binding ParentThickness, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <UniformGrid Columns="2">
                            <Button Content="표시 두께 적용" Command="{Binding Apply}" Style="{StaticResource PrimaryButton}" Margin="0,0,3,0" />
                            <Button Content="기본값 복원" Command="{Binding Reset}" Style="{StaticResource SecondaryButton}" Margin="3,0,0,0" />
                        </UniformGrid>
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource RoseAccent}" TextWrapping="Wrap" FontSize="10" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
