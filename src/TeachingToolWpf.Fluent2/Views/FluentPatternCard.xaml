<UserControl x:Class="TeachingToolWpf.Fluent2.Views.FluentPatternCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TeachingToolWpf.Controls;assembly=TeachingToolWpf.Presentation"
             Validation.Error="OnNumericValidationError">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1-Click Pattern Matching Algorithm Pill Bar -->
        <Border Style="{StaticResource Fluent2SurfaceCardStyle}" Padding="8,6" Margin="0,0,0,6">
            <StackPanel>
                <DockPanel Margin="0,0,0,5">
                    <Button DockPanel.Dock="Right" Content="? 매뉴얼" Command="{Binding Studio.Matching.ToggleHelpManual}"
                            Style="{StaticResource SecondaryButton}" Padding="8,2" Height="22" FontSize="10.5" FontWeight="Bold" Margin="6,0,0,0"
                            ToolTip="현재 선택된 패턴 매칭 알고리즘의 상세 수식·티칭 방법·파라미터 튜닝 매뉴얼을 펼치거나 닫습니다." />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Studio.Matching.ModelSummary}" FontSize="10.5" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="패턴 매칭 엔진 1-Click 선택" Style="{StaticResource SectionBadgeText}" VerticalAlignment="Center" />
                </DockPanel>
                <UniformGrid Columns="5" IsEnabled="{Binding Studio.Matching.IsIdle}">
                    <Button Content="기하 Shape" Command="{Binding SelectShapeMethod}" Margin="0,0,3,0" ToolTip="심층 다중 피라미드 + Greediness + Point-to-Tangent 서브픽셀 정밀화">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsShapeMethodSelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="PatMax" Command="{Binding SelectPatMaxMethod}" Margin="2,0" ToolTip="에지 다이폴 · PatQuick 내적 탐색 · 2D 벡터 인력장 4-Step WLS">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPatMaxMethodSelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Line-2D" Command="{Binding SelectLine2DMethod}" Margin="2,0" ToolTip="희소 윤곽 방향 응답 맵 · CPU/CUDA">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLine2DMethodSelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Sub-NCC" Command="{Binding SelectSubNccMethod}" Margin="2,0" ToolTip="선택 픽셀 ZNCC 후보 + 전체 템플릿 명암 정밀화">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSubNccMethodSelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="OpenCV NCC" Command="{Binding SelectOpenCvMethod}" Margin="3,0,0,0" ToolTip="고속 평행이동 명암 상관계수 매칭">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOpenCvMethodSelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </UniformGrid>

                <!-- Interactive '?' Algorithm Help Manual Panel (Zero-Expander) -->
                <Border x:Name="HelpManualBorder"
                        Visibility="{Binding Studio.Matching.IsHelpManualOpen, Converter={StaticResource BoolVisibility}}"
                        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                        BorderThickness="3,1,1,1"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="6"
                        Padding="10,8"
                        Margin="0,6,0,2">
                    <StackPanel DataContext="{Binding Studio.Matching.ActiveHelpManual}">
                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="닫기 ✕" Command="{Binding DataContext.Studio.Matching.ToggleHelpManual, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Style="{StaticResource SecondaryButton}" Padding="6,1" Height="20" FontSize="9.5" />
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding Subtitle}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="■ 핵심 원리 및 수식" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding PrincipleAndFormula}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="14.5" Margin="0,0,0,6" />
                        <TextBlock Text="■ 단계별 티칭 및 사용 방법" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding StepByStepGuide}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="14.5" Margin="0,0,0,6" />
                        <TextBlock Text="■ 주요 파라미터 튜닝 가이드" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding ParameterTuningGuide}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="14.5" Margin="0,0,0,6" />
                        <TextBlock Text="■ 현장 트러블슈팅 팁" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding TroubleshootingTips}" FontSize="10" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" TextWrapping="Wrap" LineHeight="14.5" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Zero-Expander 1920x1080 Bento Deck (Deterministic 3-Column [Label | Slider | NumericBox] Rows) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" DataContext="{Binding Studio.Matching}">
            <Grid Margin="0,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.92*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="1.08*" />
                </Grid.ColumnDefinitions>

                <!-- Left Bento Column: Teaching, Common Thresholds, Budget & Compute, Live Results -->
                <StackPanel Grid.Column="0">
                    <!-- Card 1: Pattern Teaching, Registered Pattern Image List & Thresholds -->
                    <Border Style="{StaticResource Fluent2SurfaceCardStyle}" IsEnabled="{Binding IsIdle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,2" Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                    <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="미학습" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasModel}" Value="True">
                                                        <Setter Property="Text" Value="학습 완료" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsTrainingDirty}" Value="True">
                                                        <Setter Property="Text" Value="재학습 필요" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="1 · 기준 패턴 등록 &amp; 이미지 리스트 관리 (정상 / 불량)" Style="{StaticResource CardHeaderTitle}" />
                            </DockPanel>

                            <TextBlock Text="{Binding TeachingSelectionText}" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,5" />

                            <UniformGrid Columns="2" Margin="0,0,0,4">
                                <Button Content="＋ 정상(OK) 패턴 추가" Command="{Binding RegisterGoodPattern}" Style="{StaticResource PrimaryButton}" Margin="0,0,3,0" ToolTip="현재 선택된 ROI의 실제 크롭 이미지를 정상(OK) 패턴으로 리스트에 추가합니다." />
                                <Button Content="＋ 불량(NG) 패턴 추가" Command="{Binding RegisterDefectPattern}" Style="{StaticResource DangerGlassButton}" Margin="3,0,0,0" ToolTip="현재 선택된 ROI의 실제 크롭 이미지를 불량(NG) 패턴으로 리스트에 추가합니다." />
                            </UniformGrid>

                            <UniformGrid Columns="3" Margin="0,0,0,5">
                                <Button Content="선택 ROI 학습" Command="{Binding Train}" Style="{StaticResource SecondaryButton}" Margin="0,0,3,0" ToolTip="새 ROI 위치면 패턴을 추가하고, 기존 ROI 설정 변경이면 선택 패턴을 재학습합니다." />
                                <Button Content="▦ 마스크 편집" Command="{Binding OpenPatternMaskEditor}" Style="{StaticResource SecondaryButton}" Margin="2,0" />
                                <Button Content="전체 해제" Command="{Binding Clear}" Style="{StaticResource SecondaryButton}" Margin="3,0,0,0" />
                            </UniformGrid>

                            <!-- Registered Pattern Image List (Cropped Pattern Thumbnail + OK/NG Toggle + Delete) -->
                            <Border CornerRadius="6"
                                    Padding="7,6"
                                    Margin="0,0,0,6"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,3">
                                        <Button DockPanel.Dock="Right"
                                                Content="↻ 병렬 리로드"
                                                Command="{Binding ReloadPatternImages}"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="7,2"
                                                Height="22"
                                                FontSize="10"
                                                ToolTip="외부 파일(.pimg)에 보관된 모든 패턴 이미지를 병렬로 다시 읽어옵니다." />
                                        <TextBlock Text="등록된 패턴 이미지 목록 (이미지 확인 · 정상/불량 전환 · 삭제)"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>

                                    <TextBlock Text="{Binding RegisteredPatternListSummary}"
                                               TextWrapping="Wrap"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding PatternStorageSummaryText}"
                                               TextWrapping="Wrap"
                                               FontSize="9.5"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Margin="0,0,0,4" />

                                    <ListBox ItemsSource="{Binding ActiveMethodPatterns}"
                                             SelectedItem="{Binding SelectedRegisteredPattern, Mode=TwoWay}"
                                             MaxHeight="210"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             Visibility="{Binding HasRegisteredPatterns, Converter={StaticResource BoolVisibility}}">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="2" />
                                                <Setter Property="Margin" Value="0,0,0,3" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="5"
                                                        Padding="6,5"
                                                        Background="{DynamicResource LayerFillColorDefaultBrush}"
                                                        BorderBrush="{Binding RoleAccent}"
                                                        BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <CheckBox Grid.Column="0"
                                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,5,0"
                                                                  ToolTip="체크 시 다중 패턴 검사에 포함" />

                                                        <!-- 50x50 Registered Pattern Image Thumbnail -->
                                                        <Border Grid.Column="1"
                                                                Width="50"
                                                                Height="50"
                                                                CornerRadius="4"
                                                                Background="#FF141821"
                                                                BorderBrush="{Binding RoleAccent}"
                                                                BorderThickness="1.2"
                                                                Margin="0,0,7,0"
                                                                ClipToBounds="True"
                                                                ToolTip="{Binding StorageStatusText}">
                                                            <Grid>
                                                                <Image Source="{Binding ThumbnailImage}"
                                                                       Stretch="Uniform"
                                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                                <Border VerticalAlignment="Bottom"
                                                                        HorizontalAlignment="Right"
                                                                        Background="#CC0F172A"
                                                                        CornerRadius="2,0,0,0"
                                                                        Padding="3,0.5">
                                                                    <TextBlock Text="{Binding ImageDimensionsText}"
                                                                               FontSize="8.5"
                                                                               Foreground="#E2E8F0" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,5,0">
                                                            <TextBlock Text="{Binding DisplayTitle}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding SummaryText}"
                                                                       FontSize="9.5"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,1,0,0" />
                                                            <TextBlock Text="{Binding StorageStatusText}"
                                                                       FontSize="9"
                                                                       Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,1,0,0" />
                                                        </StackPanel>

                                                        <Button Grid.Column="3"
                                                                Content="{Binding RoleBadge}"
                                                                Command="{Binding ToggleRoleCommand}"
                                                                Style="{StaticResource SecondaryButton}"
                                                                Foreground="{Binding RoleAccent}"
                                                                BorderBrush="{Binding RoleAccent}"
                                                                FontWeight="Bold"
                                                                FontSize="10"
                                                                Padding="7,2"
                                                                Height="25"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,4,0"
                                                                ToolTip="클릭하여 정상(OK) ↔ 불량(NG) 판정 역할을 전환합니다." />

                                                        <Button Grid.Column="4"
                                                                Content="삭제"
                                                                Command="{Binding RemoveCommand}"
                                                                Style="{StaticResource DangerGlassButton}"
                                                                FontSize="10"
                                                                Padding="7,2"
                                                                Height="25"
                                                                VerticalAlignment="Center"
                                                                ToolTip="이 패턴과 외부 이미지 파일(.pimg)을 삭제합니다." />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- Selected Pattern Enlarged Preview Box (84x84 px) -->
                                    <Border CornerRadius="5"
                                            Padding="7,6"
                                            Margin="0,4,0,0"
                                            Background="{DynamicResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{Binding SelectedRegisteredPattern.RoleAccent}"
                                            BorderThickness="1"
                                            Visibility="{Binding HasSelectedRegisteredPattern, Converter={StaticResource BoolVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="84"
                                                    Height="84"
                                                    CornerRadius="5"
                                                    Background="#FF0F172A"
                                                    BorderBrush="{Binding SelectedRegisteredPattern.RoleAccent}"
                                                    BorderThickness="1.5"
                                                    ClipToBounds="True">
                                                <Image Source="{Binding SelectedRegisteredPattern.ThumbnailImage}"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right"
                                                            CornerRadius="3"
                                                            Padding="5,1"
                                                            BorderBrush="{Binding SelectedRegisteredPattern.RoleAccent}"
                                                            BorderThickness="1">
                                                        <TextBlock Text="{Binding SelectedRegisteredPattern.RoleBadge}"
                                                                   Foreground="{Binding SelectedRegisteredPattern.RoleAccent}"
                                                                   FontSize="9.5"
                                                                   FontWeight="Bold" />
                                                    </Border>
                                                    <TextBlock Text="선택 패턴 확대 프리뷰"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding SelectedRegisteredPattern.DisplayTitle}"
                                                           FontWeight="Bold"
                                                           FontSize="11.5"
                                                           Margin="0,2,0,1"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SelectedRegisteredPattern.SummaryText}"
                                                           FontSize="9.5"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding SelectedRegisteredPattern.StorageStatusText}"
                                                           FontSize="9.5"
                                                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                           Margin="0,2,0,4"
                                                           TextWrapping="Wrap" />
                                                <UniformGrid Columns="2">
                                                    <Button Content="정상↔불량 전환"
                                                            Command="{Binding ToggleSelectedPatternRole}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            FontSize="10"
                                                            Height="24"
                                                            Margin="0,0,3,0" />
                                                    <Button Content="선택 패턴 삭제"
                                                            Command="{Binding RemoveSelectedPattern}"
                                                            Style="{StaticResource DangerGlassButton}"
                                                            FontSize="10"
                                                            Height="24"
                                                            Margin="3,0,0,0" />
                                                </UniformGrid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding TrainedModelText}" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,0,3" Visibility="{Binding IsShapeMethod, Converter={StaticResource BoolVisibility}}" />
                            <TextBlock Text="{Binding SearchScopeText}" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="124" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="최소 점수 (0.05~0.99)" Style="{StaticResource Fluent2ParameterLabelStyle}" ToolTip="최소 점수 (0.05 ~ 0.99)" />
                                <Slider Grid.Column="1" Minimum="0.05" Maximum="0.99" SmallChange="0.01" LargeChange="0.05" TickFrequency="0.01"
                                        Value="{Binding MinimumScore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}"
                                         Text="{Binding MinimumScore, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="124" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="최대 결과 수 (1~256)" Style="{StaticResource Fluent2ParameterLabelStyle}" ToolTip="최대 검출 결과 수 (1 ~ 256)" />
                                <Slider Grid.Column="1" Minimum="1" Maximum="256" SmallChange="1" LargeChange="16" TickFrequency="1"
                                        Value="{Binding MaximumMatches, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}"
                                         Text="{Binding MaximumMatches, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <WrapPanel Margin="0,4,0,0">
                                <CheckBox Content="검사 위치 표시" IsChecked="{Binding ShowOverlay}" Margin="0,0,10,0" />
                                <CheckBox Content="특징점 시각화" IsChecked="{Binding ShowFeatures}" IsEnabled="{Binding SupportsFeaturePreview}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Compute Device, Budget & NMS (3-Column Parameter Rows) -->
                    <Border Style="{StaticResource Fluent2SurfaceCardStyle}" IsEnabled="{Binding IsIdle}" Visibility="{Binding IsNonPatMaxMethod, Converter={StaticResource BoolVisibility}}">
                        <StackPanel>
                            <TextBlock Text="2 · 실행 장치 · 후보 예산 · 중복 제어" Style="{StaticResource CardHeaderTitle}" Margin="0,0,0,6" />
                            <UniformGrid Columns="2" Margin="0,0,0,6">
                                <StackPanel Margin="0,0,3,0">
                                    <TextBlock Text="후보 예산 프리셋" Style="{StaticResource Caption}" />
                                    <ComboBox ItemsSource="{Binding SpeedProfiles}" DisplayMemberPath="Name" SelectedValuePath="Profile" SelectedValue="{Binding SpeedProfile}" />
                                </StackPanel>
                                <StackPanel Margin="3,0,0,0">
                                    <TextBlock Text="실행 장치 (CPU/CUDA)" Style="{StaticResource Caption}" />
                                    <ComboBox ItemsSource="{Binding ComputeModes}" DisplayMemberPath="Name" SelectedValuePath="Mode" SelectedValue="{Binding ComputeMode}" />
                                </StackPanel>
                            </UniformGrid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="124" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="최대 후보 (16~4096)" Style="{StaticResource Fluent2ParameterLabelStyle}" ToolTip="최대 후보 수 (16 ~ 4096)" />
