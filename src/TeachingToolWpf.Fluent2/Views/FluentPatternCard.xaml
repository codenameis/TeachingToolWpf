                                        <Slider Grid.Column="1" Minimum="16" Maximum="512" SmallChange="8" LargeChange="32" TickFrequency="8"
                                                Value="{Binding CpuCoarseFeatures, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}"
                                                 Text="{Binding CpuCoarseFeatures, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="134" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="원본 윤곽 특징 수 (16~512)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                        <Slider Grid.Column="1" Minimum="16" Maximum="512" SmallChange="8" LargeChange="32" TickFrequency="8"
                                                Value="{Binding CpuFineFeatures, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}"
                                                 Text="{Binding CpuFineFeatures, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Visibility="{Binding IsCpuSubNcc, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,6">
                                    <TextBlock Text="Sub-NCC 명암 ZNCC 표본 설정 (방식 전용)" Style="{StaticResource SectionBadgeText}" Margin="0,0,0,4" />
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="134" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="축소 명암 표본 수 (16~512)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                        <Slider Grid.Column="1" Minimum="16" Maximum="512" SmallChange="2" LargeChange="16" TickFrequency="2"
                                                Value="{Binding CpuNccCoarseSamples, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}"
                                                 Text="{Binding CpuNccCoarseSamples, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="134" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="학습 최소 명암차 (1~255)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                        <Slider Grid.Column="1" Minimum="1" Maximum="255" SmallChange="1" LargeChange="10" TickFrequency="1"
                                                Value="{Binding CpuNccMinimumContrast, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}"
                                                 Text="{Binding CpuNccMinimumContrast, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>

                                <TextBlock Text="회전 · 배율 · 피라미드 검색 (공통 포즈 탐색 범위)" Style="{StaticResource SectionBadgeText}" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="134" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="최소 탐색 각도 (°)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Minimum="-180" Maximum="0" SmallChange="1" LargeChange="15" TickFrequency="1"
                                            Value="{Binding CpuMinimumAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}"
                                             Text="{Binding CpuMinimumAngle, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="134" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="최대 탐색 각도 (°)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="180" SmallChange="1" LargeChange="15" TickFrequency="1"
                                            Value="{Binding CpuMaximumAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}"
                                             Text="{Binding CpuMaximumAngle, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="134" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="탐색 각도 간격 (°)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Minimum="0.5" Maximum="15" SmallChange="0.5" LargeChange="1" TickFrequency="0.5"
                                            Value="{Binding CpuAngleStep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}"
                                             Text="{Binding CpuAngleStep, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="134" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="최소 배율 (0.5~1.0)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Minimum="0.5" Maximum="1.0" SmallChange="0.01" LargeChange="0.05" TickFrequency="0.01"
                                            Value="{Binding CpuMinimumScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}"
                                             Text="{Binding CpuMinimumScale, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="134" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="최대 배율 (1.0~2.0)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Minimum="1.0" Maximum="2.0" SmallChange="0.01" LargeChange="0.05" TickFrequency="0.01"
                                            Value="{Binding CpuMaximumScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}"
                                             Text="{Binding CpuMaximumScale, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="134" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="배율 간격 (.01~.2)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Minimum="0.01" Maximum="0.2" SmallChange="0.01" LargeChange="0.02" TickFrequency="0.01"
                                            Value="{Binding CpuScaleStep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}"
                                             Text="{Binding CpuScaleStep, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="134" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="피라미드 단계 (1~5)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Minimum="1" Maximum="5" SmallChange="1" LargeChange="1" TickFrequency="1"
                                            Value="{Binding CpuPyramidLevels, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}"
                                             Text="{Binding CpuPyramidLevels, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="134" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="중복 억제 반경 (px)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Minimum="1" Maximum="128" SmallChange="1" LargeChange="8" TickFrequency="1"
                                            Value="{Binding CpuSuppressionRadius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}"
                                             Text="{Binding CpuSuppressionRadius, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </StackPanel>

                            <!-- (C) OpenCV Template Guidance -->
                            <StackPanel Visibility="{Binding IsTemplateMethod, Converter={StaticResource BoolVisibility}}">
                                <TextBlock Text="OpenCV 템플릿 매칭은 좌측 공통 설정(최소 점수, 최대 결과, 중복 허용 비율 슬라이더)을 사용하며, 학습된 각도와 배율을 고정해 평행이동만 고속 검색합니다."
                                           TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <!-- (D) PatMax / PatQuick Parameters (Full-Width 3-Column Rows) -->
                            <StackPanel Visibility="{Binding IsPatMaxMethod, Converter={StaticResource BoolVisibility}}">
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Content="ROI 자동 입도" Command="{Binding PatMaxAutoGranularityCommand}" Style="{StaticResource SecondaryButton}" Height="23" Padding="8,0" FontSize="10" />
                                    <TextBlock Text="실시간 다이폴 · 안정성 행렬 진단" Style="{StaticResource SectionBadgeText}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{Binding PatMaxDiagnosticsText}" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="전처리 필터" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding PatMaxFilterOptions}" DisplayMemberPath="Name" SelectedValuePath="Kind" SelectedValue="{Binding PatMaxPreprocessingFilter}" />
                                </Grid>
                                <CheckBox Content="ROI 실시간 필터 표시" IsChecked="{Binding PatMaxShowInspectionFilterPreview}" Margin="0,0,0,4" />

                                <Grid Visibility="{Binding PatMaxUsesFilterSigma, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="134" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="전처리 Sigma (0.1~8)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Minimum="0.1" Maximum="8.0" SmallChange="0.1" LargeChange="0.5" TickFrequency="0.1"
                                            Value="{Binding PatMaxFilterSigma, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}"
                                             Text="{Binding PatMaxFilterSigma, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <TextBlock Text="Granularity · 다이폴 · 인력장 (슬라이더 조절)" Style="{StaticResource SectionBadgeText}" Margin="0,2,0,4" />
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="134" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Coarse 입도 (1~16)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Minimum="1" Maximum="16" SmallChange="1" LargeChange="2" TickFrequency="1"
                                            Value="{Binding PatMaxCoarseGranularity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}"
                                             Text="{Binding PatMaxCoarseGranularity, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="134" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Fine 입도 (1~16)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Minimum="1" Maximum="16" SmallChange="1" LargeChange="2" TickFrequency="1"
                                            Value="{Binding PatMaxFineGranularity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}"
                                             Text="{Binding PatMaxFineGranularity, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="134" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="학습 에지 임계 (1~120)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Minimum="1" Maximum="120" SmallChange="1" LargeChange="5" TickFrequency="1"
                                            Value="{Binding PatMaxEdgeThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}"
                                             Text="{Binding PatMaxEdgeThreshold, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="134" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="인력장 탄성 반경 (px)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Minimum="0.25" Maximum="16.0" SmallChange="0.25" LargeChange="1.0" TickFrequency="0.25"
                                            Value="{Binding PatMaxElasticityPixels, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}"
                                             Text="{Binding PatMaxElasticityPixels, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <TextBlock Text="PatQuick 포즈 · 4-Step WLS 정합" Style="{StaticResource SectionBadgeText}" Margin="0,2,0,4" />
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="134" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="최소 각도 (-180~0°)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Minimum="-180" Maximum="0" SmallChange="1" LargeChange="15" TickFrequency="1"
                                            Value="{Binding PatMaxMinAngleDegrees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}"
                                             Text="{Binding PatMaxMinAngleDegrees, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="134" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="최대 각도 (0~180°)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="180" SmallChange="1" LargeChange="15" TickFrequency="1"
                                            Value="{Binding PatMaxMaxAngleDegrees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}"
                                             Text="{Binding PatMaxMaxAngleDegrees, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <CheckBox Content="배율 변화 허용 (Similarity 4-DOF)" IsChecked="{Binding PatMaxEnableScale}" Margin="0,0,0,3" />
                                <StackPanel IsEnabled="{Binding PatMaxEnableScale}">
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="134" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="최소 배율 (0.5~1.0)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                        <Slider Grid.Column="1" Minimum="0.5" Maximum="1.0" SmallChange="0.01" LargeChange="0.05" TickFrequency="0.01"
                                                Value="{Binding PatMaxScaleMin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}"
                                                 Text="{Binding PatMaxScaleMin, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="134" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="최대 배율 (1.0~2.0)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                        <Slider Grid.Column="1" Minimum="1.0" Maximum="2.0" SmallChange="0.01" LargeChange="0.05" TickFrequency="0.01"
                                                Value="{Binding PatMaxScaleMax, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}"
                                                 Text="{Binding PatMaxScaleMax, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>

                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="134" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="런타임 에지 (1~120)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Minimum="1" Maximum="120" SmallChange="1" LargeChange="5" TickFrequency="1"
                                            Value="{Binding PatMaxRuntimeEdgeThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}"
                                             Text="{Binding PatMaxRuntimeEdgeThreshold, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="134" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="최소 분리거리 (px)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Minimum="1" Maximum="128" SmallChange="1" LargeChange="8" TickFrequency="1"
                                            Value="{Binding PatMaxMinSeparationPixels, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}"
                                             Text="{Binding PatMaxMinSeparationPixels, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="134" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Coarse 후보 (1~128)" Style="{StaticResource Fluent2ParameterLabelStyle}" />
                                    <Slider Grid.Column="1" Minimum="1" Maximum="128" SmallChange="1" LargeChange="8" TickFrequency="1"
                                            Value="{Binding PatMaxMaxCandidates, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Fluent2CompactNumericBoxStyle}"
                                             Text="{Binding PatMaxMaxCandidates, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <CheckBox Content="명암 반전 허용 (Ignore Polarity)" IsChecked="{Binding PatMaxIgnorePolarity}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Pinned Bottom Execution & Verdict Bar -->
        <Border Grid.Row="2" Style="{StaticResource Fluent2SurfaceCardStyle}" Margin="0,6,0,0" Padding="10,6" DataContext="{Binding Studio.Matching}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Content="검사 실행" Command="{Binding Search}" Style="{StaticResource PrimaryButton}" Width="112" Height="32" Margin="0,0,6,0" />
                    <Button Content="취소" Command="{Binding Cancel}" Style="{StaticResource SecondaryButton}" Width="64" Height="32" />
                </StackPanel>
                <Border BorderBrush="{Binding VerdictColor}" BorderThickness="3,0,0,0" Padding="10,2">
                    <StackPanel>
                        <TextBlock Text="{Binding PanelTitle}" FontWeight="SemiBold" FontSize="11.5" />
                        <TextBlock Text="{Binding PanelHint}" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,1,0,0" />
                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,3,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
