<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:controls="clr-namespace:TeachingToolWpf.Controls;assembly=TeachingToolWpf.Presentation">

    <BooleanToVisibilityConverter x:Key="BoolVisibility" />

    <!-- =========================================================================
         1. FLUENT 2 DESIGN TOKENS (CornerRadius, Spacing, Stroke, Elevation)
         ========================================================================= -->
    <CornerRadius x:Key="Fluent2CornerNone">0</CornerRadius>
    <CornerRadius x:Key="Fluent2ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="Fluent2OverlayCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="Fluent2LayerCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="Fluent2PillCornerRadius">999</CornerRadius>

    <!-- Override WPF-UI base tokens for consistent Fluent 2 geometry -->
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="PopupCornerRadius">8</CornerRadius>

    <Thickness x:Key="Fluent2StrokeThin">1</Thickness>
    <Thickness x:Key="Fluent2FocusStrokeOuter">2</Thickness>
    <Thickness x:Key="Fluent2CardPadding">10,8,10,8</Thickness>
    <Thickness x:Key="Fluent2ControlPadding">8,4,8,4</Thickness>

    <!-- =========================================================================
         2. FLUENT 2 SEMANTIC & ACCENT PALETTE TOKENS
         ========================================================================= -->
    <Color x:Key="Fluent2AccentColor">#FF0078D4</Color>
    <Color x:Key="Fluent2AccentLightColor">#FF38BDF8</Color>
    <Color x:Key="Fluent2SuccessColor">#FF10B981</Color>
    <Color x:Key="Fluent2CautionColor">#FFF59E0B</Color>
    <Color x:Key="Fluent2CriticalColor">#FFF43F5E</Color>

    <SolidColorBrush x:Key="Fluent2AccentBrush" Color="{StaticResource Fluent2AccentColor}" />
    <SolidColorBrush x:Key="AccentCyan" Color="{StaticResource Fluent2AccentLightColor}" />
    <SolidColorBrush x:Key="EmeraldAccent" Color="{StaticResource Fluent2SuccessColor}" />
    <SolidColorBrush x:Key="AmberAccent" Color="{StaticResource Fluent2CautionColor}" />
    <SolidColorBrush x:Key="RoseAccent" Color="{StaticResource Fluent2CriticalColor}" />

    <SolidColorBrush x:Key="TextPrimary" Color="#FFF8FAFC" />
    <SolidColorBrush x:Key="TextSecondary" Color="#FF94A3B8" />
    <SolidColorBrush x:Key="TextMuted" Color="#FF64748B" />
    <SolidColorBrush x:Key="Surface" Color="#FF1E293B" />
    <SolidColorBrush x:Key="Shell" Color="#FF0F172A" />
    <SolidColorBrush x:Key="Stroke" Color="#FF334155" />
    <SolidColorBrush x:Key="Accent" Color="#FF38BDF8" />
    <SolidColorBrush x:Key="AccentSoft" Color="#2638BDF8" />

    <SolidColorBrush x:Key="LiquidInsetBrush" Color="#180078D4" />
    <SolidColorBrush x:Key="LiquidPrimaryBrush" Color="#FF0078D4" />
    <SolidColorBrush x:Key="LiquidSecondaryBrush" Color="#2264748B" />
    <SolidColorBrush x:Key="LiquidHoverBrush" Color="#3364748B" />
    <SolidColorBrush x:Key="LiquidBorderBrush" Color="#3394A3B8" />
    <SolidColorBrush x:Key="LiquidSpecularBrush" Color="#4494A3B8" />

    <DropShadowEffect x:Key="Fluent2CardElevationShadow"
                      BlurRadius="14"
                      ShadowDepth="3"
                      Direction="270"
                      Color="#FF000000"
                      Opacity="0.18" />

    <!-- =========================================================================
         3. FLUENT 2 SURFACE & LAYER CONTAINERS (Dynamic Light/Dark Theme Aware)
         ========================================================================= -->
    <Style x:Key="Fluent2LayerPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource Fluent2StrokeThin}" />
        <Setter Property="CornerRadius" Value="{StaticResource Fluent2OverlayCornerRadius}" />
        <Setter Property="Padding" Value="8" />
    </Style>

    <Style x:Key="LiquidPanel" TargetType="Border" BasedOn="{StaticResource Fluent2LayerPanelStyle}" />

    <Style x:Key="Fluent2SurfaceCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource Fluent2StrokeThin}" />
        <Setter Property="CornerRadius" Value="{StaticResource Fluent2OverlayCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource Fluent2CardPadding}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="LiquidCard" TargetType="Border" BasedOn="{StaticResource Fluent2SurfaceCardStyle}" />

    <!-- =========================================================================
         4. FLUENT 2 TYPOGRAPHY RAMP (Dynamic Theme Foreground)
         ========================================================================= -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="Fluent2TitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="CardHeaderTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SectionBadgeText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <Style x:Key="Fluent2ParameterLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Margin" Value="0,0,4,0" />
    </Style>

    <!-- =========================================================================
         5. FLUENT 2 CONTROLS (ui:Button, Button, ui:TextBox, TextBox, NavigationView)
         ========================================================================= -->
    <Style x:Key="Fluent2UiButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="CornerRadius" Value="{StaticResource Fluent2ControlCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource Fluent2ControlPadding}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>

    <Style x:Key="Fluent2UiTextBoxStyle" TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
        <Setter Property="Padding" Value="8,5,8,5" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="ClearButtonEnabled" Value="False" />
    </Style>

    <!-- Primary Accent Button (Fluent 2 CornerRadius=4) -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Fluent2ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary Standard Fluent 2 Button (CornerRadius=4) -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Fluent2ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}" />

    <!-- Danger Fluent 2 Button -->
    <Style x:Key="DangerGlassButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Background" Value="#24F43F5E" />
        <Setter Property="BorderBrush" Value="#66F43F5E" />
        <Setter Property="Foreground" Value="{StaticResource RoseAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Stage Tab Pill Button (Fluent 2 Segmented Navigation Button) -->
    <Style x:Key="StageTabButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Fluent 2 TextBox & ValueTextBox (CornerRadius=4, Bottom Accent Focus Indicator) -->
    <Style x:Key="Fluent2StandardTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
        <Setter Property="BorderThickness" Value="1,1,1,2" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Fluent2ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorInputActiveBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource RoseAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource Fluent2StandardTextBoxStyle}" />

    <Style x:Key="Fluent2CompactNumericBoxStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource Fluent2StandardTextBoxStyle}">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Fluent2SliderStyle"
           TargetType="Slider"
           BasedOn="{StaticResource {x:Type Slider}}">
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="6,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style TargetType="Slider" BasedOn="{StaticResource Fluent2SliderStyle}" />

    <!-- Compact 1080p CheckBox & ComboBox Overrides (Prevents WPF-UI 120px MinWidth & 36px Height Blowup) -->
    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="6,0,0,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="8,3,26,3" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ValueTextBoxStyle"
           TargetType="{x:Type controls:ValueTextBox}"
           BasedOn="{StaticResource Fluent2StandardTextBoxStyle}">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- =========================================================================
         6. FLUENT 2 ROI LISTBOX STYLE (CornerRadius=4 items, Dynamic Theme Aware)
         ========================================================================= -->
    <Style x:Key="Fluent2RoiListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemCard"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Fluent2ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="SelectionIndicator"
                                    Width="3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Margin="-6,2,0,2"
                                    CornerRadius="2"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    Visibility="Collapsed" />
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemCard" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemCard" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter TargetName="ItemCard" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Fluent2RoiListBoxStyle" TargetType="{x:Type controls:RoiListBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Fluent2RoiListBoxItemStyle}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel IsVirtualizing="True"
                                            VirtualizationMode="Recycling"
                                            ScrollUnit="Item" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:RoiListBox}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Padding="{TemplateBinding Padding}"
                                      Focusable="False"
                                      CanContentScroll="True"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LiquidRoiListBoxStyle"
           TargetType="{x:Type controls:RoiListBox}"
           BasedOn="{StaticResource Fluent2RoiListBoxStyle}" />

</ResourceDictionary>
