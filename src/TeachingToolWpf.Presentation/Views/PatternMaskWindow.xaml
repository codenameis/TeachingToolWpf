<Window x:Class="TeachingToolWpf.Views.PatternMaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TeachingToolWpf.Controls"
        Title="패턴 마스크 전용 편집기 · Vision Teaching Studio"
        Width="1060" Height="740" MinWidth="880" MinHeight="600"
        Background="{StaticResource Shell}" Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI Variable, Segoe UI, Malgun Gothic"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상단 타이틀 바 -->
        <Border Grid.Row="0" Background="{StaticResource Surface}" Padding="22,14" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="저장 상태로 되돌리기" Command="{Binding ResetToSavedCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Content="ROI에 마스크 적용" Command="{Binding CommitToRoiCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                            AutomationProperties.Name="ROI에 마스크 적용"/>
                    <Button Content="닫기" Click="OnCloseClick" Style="{StaticResource SecondaryButton}" Width="76"
                            AutomationProperties.Name="패턴 마스크 페이지 닫기"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding HeaderTitle}" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding FeatureSummary}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 전용 드로잉 툴바 -->
        <Border Grid.Row="1" Background="{StaticResource Surface}" Padding="20,10" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="마스크 영역 표시" IsChecked="{Binding ShowExcludedOverlay}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <CheckBox Content="에지 특징점 표시 (초록:유효 / 빨강:제외)" IsChecked="{Binding ShowEdgeFeatures}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="−" Command="{Binding ZoomOutCommand}" Style="{StaticResource SecondaryButton}" Width="28" Height="26" Padding="0"/>
                    <TextBlock Text="{Binding ZoomPercentText}" Width="48" TextAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                    <Button Content="＋" Command="{Binding ZoomInCommand}" Style="{StaticResource SecondaryButton}" Width="28" Height="26" Padding="0" Margin="0,0,6,0"/>
                    <Button Content="맞춤" Command="{Binding ZoomFitCommand}" Style="{StaticResource SecondaryButton}" Height="26" Padding="10,0"/>
                </StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <Button Content="↖ 선택/이동" Command="{Binding SelectToolCommand}" Margin="0,0,6,0" Padding="10,5">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelectTool}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                                        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="▧ 사각형 마스크" Command="{Binding RectangleToolCommand}" Margin="0,0,6,0" Padding="10,5">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRectangleTool}" Value="True">
                                        <Setter Property="Background" Value="#FFF0F4"/>
                                        <Setter Property="BorderBrush" Value="#E03360"/>
                                        <Setter Property="Foreground" Value="#C81E4C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="◉ 타원 마스크" Command="{Binding EllipseToolCommand}" Margin="0,0,6,0" Padding="10,5">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEllipseTool}" Value="True">
                                        <Setter Property="Background" Value="#FFF0F4"/>
                                        <Setter Property="BorderBrush" Value="#E03360"/>
                                        <Setter Property="Foreground" Value="#C81E4C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="⬠ 폴리곤 마스크" Command="{Binding PolygonToolCommand}" Margin="0,0,6,0" Padding="10,5">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPolygonTool}" Value="True">
                                        <Setter Property="Background" Value="#FFF0F4"/>
                                        <Setter Property="BorderBrush" Value="#E03360"/>
                                        <Setter Property="Foreground" Value="#C81E4C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="✎ 브러시 그리기" Command="{Binding BrushToolCommand}" Margin="0,0,6,0" Padding="10,5">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBrushTool}" Value="True">
                                        <Setter Property="Background" Value="#FFF0F4"/>
                                        <Setter Property="BorderBrush" Value="#E03360"/>
                                        <Setter Property="Foreground" Value="#C81E4C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="⌫ 마스크 지우개" Command="{Binding EraserToolCommand}" Margin="0,0,14,0" Padding="10,5">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEraserTool}" Value="True">
                                        <Setter Property="Background" Value="#FEF3C7"/>
                                        <Setter Property="BorderBrush" Value="#D97706"/>
                                        <Setter Property="Foreground" Value="#B45309"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="브러시 크기(px)" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Slider Minimum="3" Maximum="64" Width="88" Value="{Binding BrushSizePixels, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding BrushSizePixels, StringFormat={}{0:0}px}" FontSize="11" Width="32" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="에지 민감도" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Slider Minimum="5" Maximum="80" Width="88" Value="{Binding EdgeThreshold, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding EdgeThreshold, StringFormat={}{0:0}}" FontSize="11" Width="26" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- 중앙 전용 패턴 마스크 작업 공간 + 우측 마스크 목록/수치 제어 -->
        <Grid Grid.Row="2" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- 전용 2D 패턴 마스크 캔버스 (VisionCanvas DX12와 독립된 순수 패턴 정규화 공간) -->
            <Border Grid.Column="0" Background="#161920" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <Grid>
                    <ScrollViewer x:Name="CanvasScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="OnCanvasPreviewMouseWheel">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28">
                            <Border BorderBrush="#38BDF8" BorderThickness="1" SnapsToDevicePixels="True">
                                <Grid x:Name="PatternSurface"
                                      Width="{Binding CanvasDisplayWidth}"
                                      Height="{Binding CanvasDisplayHeight}"
                                      Background="#1E222B"
                                      ClipToBounds="True"
                                      MouseLeftButtonDown="OnSurfaceMouseLeftButtonDown"
                                      MouseRightButtonDown="OnSurfaceMouseRightButtonDown"
                                      MouseMove="OnSurfaceMouseMove"
                                      MouseLeftButtonUp="OnSurfaceMouseLeftButtonUp"
                                      MouseLeave="OnSurfaceMouseLeave">
                                    <Image Source="{Binding PreviewImage}"
                                           Stretch="Fill"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           IsHitTestVisible="False"/>
                                    <Image Source="{Binding BrushMaskImage}"
                                           Stretch="Fill"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           IsHitTestVisible="False"/>
                                    <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                            Background="#CC111827" CornerRadius="6" Padding="10,6" IsHitTestVisible="False">
                        <TextBlock Text="{Binding ToolGuideText}" Foreground="#E5E7EB" FontSize="11"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 우측 마스크 레이어 목록 및 정밀 수치 입력 패널 -->
            <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="8" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="패턴 마스크 목록" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="빨간 반투명 영역의 에지 특징점은 패턴 학습 및 검사에서 제외됩니다."
                                   Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,10"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Expander Header="선택 마스크 정밀 수치 (ROI px)" IsExpanded="True"
                                  IsEnabled="{Binding HasSelectedMask}">
                            <StackPanel Margin="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="좌측 X (px)" Style="{StaticResource Caption}"/>
                                        <controls:ValueTextBox Value="{Binding X, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ValueTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="상단 Y (px)" Style="{StaticResource Caption}"/>
                                        <controls:ValueTextBox Value="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ValueTextBoxStyle}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="너비 (px)" Style="{StaticResource Caption}"/>
                                        <controls:ValueTextBox Value="{Binding Width, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ValueTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="높이 (px)" Style="{StaticResource Caption}"/>
                                        <controls:ValueTextBox Value="{Binding Height, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ValueTextBoxStyle}"/>
                                    </StackPanel>
                                </Grid>
                                <Button Content="수치 위치·크기 반영" Command="{Binding ApplyNumericBoundsCommand}" Style="{StaticResource SecondaryButton}"/>
                            </StackPanel>
                        </Expander>

                        <TextBlock Text="{Binding Error}" Foreground="#B3261E" FontSize="11" TextWrapping="Wrap" Margin="0,6"/>

                        <UniformGrid Columns="2" Margin="0,6,0,0">
                            <Button Content="선택 마스크 삭제" Command="{Binding RemoveSelectedCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0"/>
                            <Button Content="모두 비우기" Command="{Binding ClearAllCommand}" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0"/>
                        </UniformGrid>

                        <Button Content="✓  ROI에 마스크 적용 및 반영" Command="{Binding CommitToRoiCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" Height="34"/>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Rows}"
                             SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                             DisplayMemberPath="Name"
                             AutomationProperties.Name="전용 패턴 마스크 목록"
                             BorderBrush="{StaticResource Stroke}" BorderThickness="1"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 하단 상태 표시줄 -->
        <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="20,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="Ctrl+마우스 휠: 확대/축소 · 적용 후 Ctrl+Z로 실행 취소 가능"
                           Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
