                                <Slider Grid.Column="0" Minimum="0.2" Maximum="20.0" TickFrequency="0.1"
                                        Value="{Binding GdtConcentricityLimitPx, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" Text="{Binding GdtConcentricityLimitPx, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                            </Grid>

                            <TextBlock Text="보어-데이텀 거리 공차 (0.2 ~ 30.0 px · 기본 4.0)" Style="{StaticResource Caption}"/>
                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="68"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="0.2" Maximum="30.0" TickFrequency="0.2"
                                        Value="{Binding GdtDistanceTolerancePx, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" Text="{Binding GdtDistanceTolerancePx, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                            </Grid>

                            <TextBlock Text="서브픽셀 에지 최소 대비 (2 ~ 120 · 기본 18)" Style="{StaticResource Caption}"/>
                            <Grid Margin="0,4,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="68"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="2" Maximum="120" TickFrequency="1"
                                        Value="{Binding GdtGradientThreshold, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" Text="{Binding GdtGradientThreshold, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                            </Grid>
                        </StackPanel>

                        <!-- 통합 OCR / OCV (PP-OCRv4 ONNX) 전용 설정 -->
                        <StackPanel Visibility="{Binding IsPpOcrOnnxSelected, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,10">
                            <Border Background="{StaticResource Shell}" CornerRadius="4" Padding="7,5" Margin="0,0,0,8">
                                <TextBlock Text="{Binding PpOcrStatusBadge}" FontSize="10" FontWeight="SemiBold" Foreground="#0369A1" TextWrapping="Wrap"/>
                            </Border>

                            <TextBlock Text="운전 프리셋 (양산 택타임 최적화)" Style="{StaticResource Caption}"/>
                            <ComboBox ItemsSource="{Binding PpOcrSpeedPresetOptions}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Preset"
                                      SelectedValue="{Binding PpOcrPreset}"
                                      Margin="0,4,0,8"/>

                            <TextBlock Text="인식 언어 모델" Style="{StaticResource Caption}"/>
                            <ComboBox ItemsSource="{Binding PpOcrLanguageOptions}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Language"
                                      SelectedValue="{Binding PpOcrLanguageMode}"
                                      Margin="0,4,0,8"/>

                            <TextBlock Text="명암 극성 처리" Style="{StaticResource Caption}"/>
                            <ComboBox ItemsSource="{Binding PpOcrPolarityOptions}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Polarity"
                                      SelectedValue="{Binding PpOcrPolarity}"
                                      Margin="0,4,0,8"/>

                            <TextBlock Text="검출·인식 파이프라인" Style="{StaticResource Caption}"/>
                            <ComboBox ItemsSource="{Binding PpOcrPipelineOptions}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Pipeline"
                                      SelectedValue="{Binding PpOcrPipeline}"
                                      Margin="0,4,0,8"/>

                            <TextBlock Text="PP-OCR 합격 신뢰도 (0.05 ~ 1.00)" Style="{StaticResource Caption}"/>
                            <Grid Margin="0,4,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="68"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="0.05" Maximum="1.00" TickFrequency="0.01"
                                        Value="{Binding PpOcrMinConfidence, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" Text="{Binding PpOcrMinConfidence, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                            </Grid>
                        </StackPanel>

                        <!-- 티칭 기반 OCV 인쇄 품질 검증 섹션 -->
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="6" Padding="9,8" Margin="0,4,0,10"
                                Visibility="{Binding IsAnyOcrSelected, Converter={StaticResource BoolVisibility}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <Border DockPanel.Dock="Right" Background="{Binding OcvLastVerdictAccent}" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding OcvLastVerdictBadge}" Foreground="White" FontSize="9.5" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="티칭 기반 OCV 인쇄 품질 검증" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Text="{Binding OcvFontStatusBadge}" FontSize="10" Foreground="#0369A1" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                <TextBlock Text="선택 ROI 기대 문자열 (단일 ROI 선택 · 포커스 이동 시 문서·Undo 보존)" Style="{StaticResource Caption}"/>
                                <TextBox Text="{Binding SelectedRoiOcvExpectedText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         IsEnabled="{Binding CanEditSelectedRoiOcvSettings}"
                                         FontFamily="Consolas, Malgun Gothic"
                                         Margin="0,3,0,4"/>
                                <Button Content="PP-OCR 판독값 → 기대 문자열 채우기"
                                        Command="{Binding ApplyPpOcrTextToOcvExpectedText}"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,0,6"
                                        FontSize="9.8"/>

                                <TextBlock Text="필드 형식 마스크 (선택 · 예: AAAADDDD 또는 LOT\-DDDD\-ADD)" Style="{StaticResource Caption}"/>
                                <TextBox Text="{Binding SelectedRoiOcvFormatMask, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         IsEnabled="{Binding CanEditSelectedRoiOcvSettings}"
                                         ToolTip="기호: D=숫자(0-9), A=영문대문자, a=영문소문자, X=영숫자, #=공백제외 임의문자, [0-9A-F]=문자범위, \문자=리터럴 (정규식 미지원)"
                                         FontFamily="Consolas, Malgun Gothic"
                                         Margin="0,3,0,6"/>

                                <TextBlock Text="ROI 전용 폰트 ID (기본: default · 공정별 다중 폰트 분리)" Style="{StaticResource Caption}"/>
                                <TextBox Text="{Binding SelectedRoiOcvFontId, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         IsEnabled="{Binding CanEditSelectedRoiOcvSettings}"
                                         FontFamily="Consolas, Malgun Gothic"
                                         Margin="0,3,0,6"/>

                                <TextBlock Text="OCV 전경 최소 대비 오프셋 (2 ~ 80 GV · 기본 14)" Style="{StaticResource Caption}"/>
                                <Grid Margin="0,3,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="68"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Minimum="2" Maximum="80" TickFrequency="1"
                                            Value="{Binding OcvForegroundContrast, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding OcvForegroundContrast, UpdateSourceTrigger=PropertyChanged, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                                </Grid>

                                <TextBlock Text="인쇄 명암 극성" Style="{StaticResource Caption}"/>
                                <ComboBox ItemsSource="{Binding OcvPolarityOptions}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Polarity"
                                          SelectedValue="{Binding SelectedOcvPolarity}"
                                          Margin="0,3,0,6"/>

                                <CheckBox Content="기존 골든 폰트에 문자 샘플 누적 추가" IsChecked="{Binding OcvAppendTeachMode}" Margin="0,0,0,6"/>

                                <UniformGrid Columns="3" Margin="0,0,0,4">
                                    <Button Content="폰트 티칭" Command="{Binding TeachSelectedRoiOcvFont}" Style="{StaticResource PrimaryButton}" Margin="0,0,3,0" FontSize="10"/>
                                    <Button Content="선택 OCV 검증" Command="{Binding VerifySelectedRoiOcv}" Style="{StaticResource PrimaryButton}" Margin="1,0,2,0" FontSize="10"/>
                                    <Button Content="전체 OCV 검증" Command="{Binding VerifyAllRoisOcv}" Style="{StaticResource SecondaryButton}" Margin="2,0,0,0" FontSize="10"/>
                                </UniformGrid>

                                <UniformGrid Columns="3" Margin="0,0,0,6">
                                    <Button Content="폰트 저장…" Command="{Binding SaveOcvFontModel}" Style="{StaticResource SecondaryButton}" Margin="0,0,3,0" FontSize="9.8"/>
                                    <Button Content="폰트 불러오기…" Command="{Binding LoadOcvFontModel}" Style="{StaticResource SecondaryButton}" Margin="1,0,2,0" FontSize="9.8"/>
                                    <Button Content="초기화" Command="{Binding ClearOcvFontModel}" Style="{StaticResource SecondaryButton}" Margin="2,0,0,0" FontSize="9.8"/>
                                </UniformGrid>

                                <ListBox ItemsSource="{Binding OcvVerificationItems}"
                                         SelectedItem="{Binding SelectedOcvVerificationItem}"
                                         Visibility="{Binding HasOcvVerificationItems, Converter={StaticResource BoolVisibility}}"
                                         MaxHeight="140"
                                         Margin="0,0,0,4">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right" Background="{Binding VerdictAccent}" CornerRadius="3" Padding="5,1" Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding VerdictBadge}" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding RoiName}" FontWeight="SemiBold" FontSize="10" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding DecodedText}" FontFamily="Consolas" FontSize="10" FontWeight="Bold"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding CauseSummary}" FontSize="9.2" Foreground="#B45309" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding RecommendedAction}" FontSize="9" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <ItemsControl ItemsSource="{Binding SelectedOcvCharacterItems}"
                                              Visibility="{Binding HasSelectedOcvCharacterItems, Converter={StaticResource BoolVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,1">
                                                <Border DockPanel.Dock="Left" Background="{Binding VerdictAccent}" CornerRadius="2" Padding="4,0" Margin="0,0,5,0">
                                                    <TextBlock Text="{Binding VerdictBadge}" Foreground="White" FontSize="8.5" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text="{Binding SummaryLine}" FontFamily="Consolas, Malgun Gothic" FontSize="9.2" TextWrapping="Wrap"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding AlgorithmDescription}"
                                   FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="검사 결과">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,8,4,10">
                        <CheckBox Content="캔버스 오버레이 표시 (청록:검출점 / 하늘점선:스캔가이드 / 빨강:결함)"
                                  IsChecked="{Binding ShowOverlay}" Margin="0,0,0,8"/>
                        <Button Content="검출 ROI 위치로 화면 맞춤" Command="{Binding Locate}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,10"/>
                        <Border Background="{StaticResource Shell}" CornerRadius="6" Padding="10,8">
                            <TextBlock Text="{Binding Results}" TextWrapping="Wrap" FontSize="11" LineHeight="16"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 하단 고정 실행 바: 화면 밖으로 밀리지 않고 항상 노출 -->
        <Border Grid.Row="2" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="0,8,0,8">
            <StackPanel>
                <CheckBox Content="실시간 프리뷰 (ROI 선택·이동·파라미터 변경 시 즉시 반영)"
                          IsChecked="{Binding AutoPreview}"
                          Margin="0,0,0,6"
                          ToolTip="켜면 캔버스에서 ROI를 회전·이동하거나 슬라이더를 조절할 때 즉시 스캔 보조선과 서브픽셀 계측 결과를 프리뷰합니다."/>
                <TextBlock Text="{Binding OptionsError}" Foreground="#9A3412" TextWrapping="Wrap" FontSize="10.5" Margin="0,0,0,4"/>
                <UniformGrid Columns="2" Margin="0,0,0,5">
                    <Button Content="선택 ROI 검사" Command="{Binding ExecuteSelected}" Style="{StaticResource PrimaryButton}" Margin="0,0,5,0"
                            ToolTip="캔버스에서 선택한 ROI(미선택 시 전체 ROI)에 대해 현재 알고리즘을 실행합니다."/>
                    <Button Content="전체 ROI 일괄 검사" Command="{Binding ExecuteAllRois}" Style="{StaticResource PrimaryButton}"
                            ToolTip="캔버스에 배치된 모든 리프 ROI에 대해 일괄 실행합니다."/>
                </UniformGrid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="8K(8192×8192) 7종 마스터 전수 검증" Command="{Binding RunMaster8kBenchmark}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,5,0" FontSize="10.5"
                            ToolTip="8K 합성 웨이퍼·기판 위에서 7대 알고리즘을 원클릭 전수 실행하고 서브픽셀 정밀도를 검증합니다."/>
                    <Button Grid.Column="1" Content="취소" Command="{Binding Cancel}" Style="{StaticResource SecondaryButton}" Padding="12,0"/>
                </Grid>
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,4" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
                <Border Background="{StaticResource Shell}" CornerRadius="5" Padding="8,5">
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="10.5" Foreground="#0F172A"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
