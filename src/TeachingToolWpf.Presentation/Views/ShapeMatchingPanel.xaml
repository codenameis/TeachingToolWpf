<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:TeachingToolWpf.Controls" x:Class="TeachingToolWpf.Views.ShapeMatchingPanel" Validation.Error="OnNumericValidationError">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="? 매뉴얼" Command="{Binding ToggleHelpManual}" Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="10.5" FontWeight="Bold"
                        ToolTip="현재 선택된 매칭 알고리즘의 상세 수식·티칭 단계·파라미터 튜닝 매뉴얼을 펼치거나 닫습니다." AutomationProperties.Name="패턴 매칭 알고리즘 매뉴얼 열기"/>
                <TextBlock Text="매칭 방식" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
            </DockPanel>
            <ComboBox ItemsSource="{Binding Methods}" DisplayMemberPath="Name" SelectedValuePath="Method" SelectedValue="{Binding Method}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="매칭 방식" Margin="0,4,0,6"/>
            <Border Visibility="{Binding IsHelpManualOpen, Converter={StaticResource BoolVisibility}}"
                    BorderBrush="#0284C7" BorderThickness="3,1,1,1" Background="#F0F9FF" CornerRadius="4" Padding="9,7" Margin="0,0,0,8">
                <StackPanel DataContext="{Binding ActiveHelpManual}">
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="닫기 ✕" Command="{Binding DataContext.ToggleHelpManual, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource SecondaryButton}" Padding="6,1" FontSize="9.5"/>
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="11" Foreground="#0369A1" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Subtitle}" FontSize="10" FontWeight="SemiBold" Foreground="#0284C7" TextWrapping="Wrap" Margin="0,0,0,5"/>
                    <TextBlock Text="■ 핵심 원리 및 수식" FontSize="10.5" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding PrincipleAndFormula}" FontSize="10" Foreground="#334155" TextWrapping="Wrap" LineHeight="14" Margin="0,0,0,5"/>
                    <TextBlock Text="■ 단계별 티칭 및 사용 방법" FontSize="10.5" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding StepByStepGuide}" FontSize="10" Foreground="#334155" TextWrapping="Wrap" LineHeight="14" Margin="0,0,0,5"/>
                    <TextBlock Text="■ 주요 파라미터 튜닝 가이드" FontSize="10.5" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding ParameterTuningGuide}" FontSize="10" Foreground="#334155" TextWrapping="Wrap" LineHeight="14" Margin="0,0,0,5"/>
                    <TextBlock Text="■ 현장 트러블슈팅 팁" FontSize="10.5" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding TroubleshootingTips}" FontSize="10" Foreground="#0369A1" TextWrapping="Wrap" LineHeight="14"/>
                </StackPanel>
            </Border>
        </StackPanel>
        <TabControl x:Name="MatchingTabs" Grid.Row="1" Style="{StaticResource InspectorTabs}" ItemContainerStyle="{StaticResource InspectorTab}" AutomationProperties.Name="패턴 검사 작업">
            <TabItem Header="파라미터 설정">
                <ScrollViewer x:Name="BasicScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,8,4,8" IsEnabled="{Binding IsIdle}">
                        <!-- [섹션 1] 등록 패턴 리스트 관리 (정상 / 불량) 및 공통 파라미터 -->
                        <Border BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Right" ToolTip="{Binding ModelSummary}" FontSize="11" Foreground="{StaticResource TextSecondary}" AutomationProperties.Name="학습 모델 상태">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="미학습"/><Style.Triggers>
                                            <DataTrigger Binding="{Binding HasModel}" Value="True"><Setter Property="Text" Value="학습됨"/></DataTrigger>
                                            <DataTrigger Binding="{Binding IsTrainingDirty}" Value="True"><Setter Property="Text" Value="재학습 필요"/></DataTrigger>
                                        </Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="1  패턴 등록 리스트 관리 (정상 / 불량)" FontWeight="SemiBold"/>
                                </DockPanel>
                                <TextBlock Text="{Binding TeachingSelectionText}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                <UniformGrid Columns="2" Margin="0,0,0,6">
                                    <Button Content="＋ 정상(OK) 패턴 추가" Command="{Binding RegisterGoodPattern}" Style="{StaticResource PrimaryButton}"
                                            ToolTip="현재 선택한 ROI를 합격 기준인 ‘정상(OK) 패턴’으로 리스트에 새로 추가합니다." Margin="0,0,4,0"/>
                                    <Button Content="＋ 불량(NG) 패턴 추가" Command="{Binding RegisterDefectPattern}" Style="{StaticResource SecondaryButton}"
                                            BorderBrush="#FCA5A5" Foreground="#DC2626" FontWeight="SemiBold"
                                            ToolTip="현재 선택한 ROI를 검출 시 불량으로 판정할 ‘불량(NG) 패턴’으로 리스트에 새로 추가합니다." Margin="4,0,0,0"/>
                                </UniformGrid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="TrainButton" Grid.Column="0" Content="선택 패턴 재학습" Command="{Binding Train}" Style="{StaticResource SecondaryButton}"
                                            ToolTip="리스트에서 선택된 패턴(없으면 기본 정상 패턴)을 현재 선택 ROI로 학습·갱신합니다."/>
                                    <Button Grid.Column="2" Content="▦ 패턴 마스크 편집" Command="{Binding OpenPatternMaskEditor}" Style="{StaticResource SecondaryButton}"
                                            ToolTip="전용 패턴 마스크 페이지에서 ROI 기준 영상과 에지 특징점을 보며 불필요한 영역을 마스킹합니다."
                                            AutomationProperties.Name="패턴 검사 마스크 전용 페이지 열기"/>
                                    <Button Grid.Column="4" Content="전체 해제" Command="{Binding Clear}" Style="{StaticResource SecondaryButton}" Padding="8,4"
                                            ToolTip="현재 매칭 방식에 등록된 모든 패턴 모델을 초기화합니다."/>
                                </Grid>
                                <Border Background="#F8FAFC" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,8">
                                    <StackPanel>
                                        <DockPanel Margin="2,0,2,4">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Content="정상↔불량 전환" Command="{Binding ToggleSelectedPatternRole}" Style="{StaticResource SecondaryButton}"
                                                        Padding="6,2" FontSize="10" Margin="0,0,4,0" ToolTip="선택한 등록 패턴의 판정 역할을 정상(OK) ↔ 불량(NG)으로 즉시 전환합니다."/>
                                                <Button Content="선택 삭제" Command="{Binding RemoveSelectedPattern}" Style="{StaticResource SecondaryButton}"
                                                        Padding="6,2" FontSize="10" ToolTip="리스트에서 선택한 패턴 항목을 삭제합니다."/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding RegisteredPatternListSummary}" FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding RegisteredPatternListSummary}"/>
                                        </DockPanel>
                                        <ListBox ItemsSource="{Binding ActiveMethodPatterns}" SelectedItem="{Binding SelectedRegisteredPattern, Mode=TwoWay}"
                                                 MaxHeight="190" BorderThickness="0" Background="Transparent"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 HorizontalContentAlignment="Stretch"
                                                 Visibility="{Binding HasRegisteredPatterns, Converter={StaticResource BoolVisibility}}"
                                                 AutomationProperties.Name="등록된 패턴 목록">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding RoleBackground}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="4" Padding="6,5" Margin="0,2">
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Content="삭제" Command="{Binding RemoveCommand}"
                                                                    Style="{StaticResource SecondaryButton}" Padding="6,1" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"
                                                                    ToolTip="이 패턴을 목록에서 삭제합니다."/>
                                                            <Button DockPanel.Dock="Right" Content="{Binding RoleBadge}" Command="{Binding ToggleRoleCommand}"
                                                                    Background="{Binding RoleAccent}" Foreground="White" BorderThickness="0" Padding="6,2" FontSize="10" FontWeight="Bold"
                                                                    Margin="4,0,0,0" VerticalAlignment="Center" Cursor="Hand"
                                                                    ToolTip="클릭하면 이 패턴의 역할을 정상(OK) ↔ 불량(NG)으로 전환합니다."/>
                                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                      ToolTip="검사 실행 시 이 패턴을 사용할지 여부"/>
                                                            <Border DockPanel.Dock="Left" Width="46" Height="46" Background="#0F172A"
                                                                    BorderBrush="{Binding RoleAccent}" BorderThickness="1.5" CornerRadius="4"
                                                                    Margin="0,0,8,0" ClipToBounds="True"
                                                                    ToolTip="{Binding StorageStatusText}">
                                                                <Image Source="{Binding ThumbnailImage}" Stretch="Uniform"
                                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                                       AutomationProperties.Name="등록 패턴 썸네일 이미지"/>
                                                            </Border>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayTitle}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayTitle}"/>
                                                                <TextBlock Text="{Binding SummaryText}" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SummaryText}"/>
                                                                <TextBlock Text="{Binding StorageStatusText}" FontSize="9" Foreground="#64748B" TextTrimming="CharacterEllipsis" ToolTip="{Binding StorageStatusText}"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <!-- 선택된 패턴 이미지 확대 미리보기 & 외부 병렬 파일 보관 상태 -->
                                        <Border Background="#FFFFFF" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="0,6,0,0"
                                                Visibility="{Binding HasSelectedRegisteredPattern, Converter={StaticResource BoolVisibility}}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Width="82" Height="82" Background="#0F172A"
                                                        BorderBrush="{Binding SelectedRegisteredPattern.RoleAccent}" BorderThickness="2" CornerRadius="5"
                                                        Margin="0,0,10,0" ClipToBounds="True"
                                                        ToolTip="선택된 등록 패턴의 기준 이미지 미리보기">
                                                    <Image Source="{Binding SelectedRegisteredPattern.ThumbnailImage}" Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           AutomationProperties.Name="선택된 패턴 기준 이미지 미리보기"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <DockPanel Margin="0,0,0,3">
                                                        <Border DockPanel.Dock="Right" Background="{Binding SelectedRegisteredPattern.RoleAccent}" CornerRadius="3" Padding="5,1" Margin="4,0,0,0">
                                                            <TextBlock Text="{Binding SelectedRegisteredPattern.RoleShortBadge}" Foreground="White" FontSize="9.5" FontWeight="Bold"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding SelectedRegisteredPattern.DisplayTitle}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding SelectedRegisteredPattern.SummaryText}" FontSize="10" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                                    <TextBlock Text="{Binding SelectedRegisteredPattern.StorageStatusText}" FontSize="9.5" Foreground="#475569" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedRegisteredPattern.ImageFilePath}" Margin="0,0,0,4"/>
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="병렬 파일 새로고침" Command="{Binding ReloadPatternImages}"
                                                                Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="9.5"
                                                                ToolTip="외부 파일(.pimg)로 분리 보관된 모든 패턴 이미지를 병렬 I/O(Parallel.ForEachAsync)로 다시 읽어 썸네일을 갱신합니다."/>
                                                        <TextBlock Text="{Binding PatternStorageSummaryText}" FontSize="9.5" Foreground="#0284C7" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding TrainedModelText}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" Visibility="{Binding IsShapeMethod, Converter={StaticResource BoolVisibility}}"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,6,4">
                                        <TextBlock Text="최소 점수 (0~1)" Style="{StaticResource Caption}"/>
                                        <TextBox Text="{Binding MinimumScore, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최소 최종 매칭 점수"/>
                                        <Slider Minimum="0.05" Maximum="0.99" SmallChange="0.01" LargeChange="0.05" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding MinimumScore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" AutomationProperties.Name="최소 점수 슬라이더"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,4">
                                        <TextBlock Text="최대 결과 (1~1000)" Style="{StaticResource Caption}"/>
                                        <TextBox Text="{Binding MaximumMatches, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최대 매칭 결과 수"/>
                                        <Slider Minimum="1" Maximum="128" SmallChange="1" LargeChange="8" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MaximumMatches, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" AutomationProperties.Name="최대 결과 수 슬라이더"/>
                                    </StackPanel>
                                </UniformGrid>
                                <WrapPanel Margin="0,4,0,0">
                                    <CheckBox Content="검사 위치 표시" IsChecked="{Binding ShowOverlay}" Margin="0,0,12,2"/>
                                    <CheckBox Content="특징점 시각화 (초록:일반 / 하늘:비대칭키 / 빨강:누락)" IsChecked="{Binding ShowFeatures}" IsEnabled="{Binding SupportsFeaturePreview}" Margin="0,0,0,2"
                                              ToolTip="학습 직후 추출된 특징점 및 검출 위치의 일치(초록)·비대칭 핵심키(하늘색)·누락(빨강) 특징점을 캔버스에 실시간 표시합니다."/>
                                </WrapPanel>
                                <Expander Header="공통 후보 예산 · 실행 장치 · 중복 제어" IsExpanded="False" Margin="0,6,0,0" Visibility="{Binding IsNonPatMaxMethod, Converter={StaticResource BoolVisibility}}">
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="후보 예산 프리셋" Style="{StaticResource Caption}"/>
                                        <ComboBox ItemsSource="{Binding SpeedProfiles}" DisplayMemberPath="Name" SelectedValuePath="Profile" SelectedValue="{Binding SpeedProfile}" AutomationProperties.Name="후보 예산 프리셋" Margin="0,4,0,8"/>
                                        <StackPanel Visibility="{Binding IsCpuMethod, Converter={StaticResource BoolVisibility}}">
                                            <TextBlock Text="실행 장치" Style="{StaticResource Caption}"/>
                                            <ComboBox ItemsSource="{Binding ComputeModes}" DisplayMemberPath="Name" SelectedValuePath="Mode" SelectedValue="{Binding ComputeMode}" AutomationProperties.Name="템플릿 검사 실행 장치" Margin="0,4,0,8"/>
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding IsShapeMethod, Converter={StaticResource BoolVisibility}}">
                                            <TextBlock Text="실행 장치" Style="{StaticResource Caption}"/>
                                            <ComboBox ItemsSource="{Binding ComputeModes}" DisplayMemberPath="Name" SelectedValuePath="Mode" SelectedValue="{Binding ComputeMode}" AutomationProperties.Name="검사 실행 장치" Margin="0,4,0,8"/>
                                            <TextBlock Text="CPU 최대 병렬도 (1~16)" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding MaximumParallelism, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="검사 CPU 병렬도" Margin="0,4,0,8"/>
                                        </StackPanel>
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,6,6">
                                                <TextBlock Text="최대 후보 수" Style="{StaticResource Caption}"/>
                                                <TextBox Text="{Binding MaximumCandidates, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최대 검색 후보 수"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,6" Visibility="{Binding SupportsOverlapRatio, Converter={StaticResource BoolVisibility}}">
                                                <TextBlock Text="중복 허용 (IoU 0~1)" Style="{StaticResource Caption}"/>
                                                <TextBox Text="{Binding MaximumOverlap, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최대 검출 중복 비율"/>
                                            </StackPanel>
                                        </UniformGrid>
                                        <TextBlock Text="검사 시간 한도 (초 · 0은 제한 없음)" Style="{StaticResource Caption}"/>
                                        <TextBox Text="{Binding SearchTimeoutSeconds, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="검사 시간 한도" Margin="0,4,0,4"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <!-- [섹션 2] 선택된 매칭 알고리즘 전용 파라미터 페이지 (알고리즘 변경 시 자동 전환) -->
                        <Border BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="2  선택 알고리즘 전용 설정" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding MethodDescription}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                <Border BorderBrush="#38BDF8" BorderThickness="2,0,0,0" Background="{StaticResource Shell}" Padding="8,5" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding ParameterPreviewSummary}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondary}" AutomationProperties.Name="실시간 파라미터 미리보기 요약"/>
                                </Border>
                                <TextBlock Text="{Binding ModelSummary}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>

                                <!-- (A) 하이브리드 초고속 기하 매칭 (StegerShape) 전용 페이지 -->
                                <StackPanel Visibility="{Binding IsShapeMethod, Converter={StaticResource BoolVisibility}}">
                                    <TextBlock Text="학습 기하 조건 (변경 후 다시 학습)" FontWeight="SemiBold" FontSize="11" Margin="0,2,0,4"/>
                                    <UniformGrid Columns="3" Margin="0,0,0,6" IsEnabled="{Binding CanEditSearchAngle}">
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="최소 각도 (°)" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding MinimumAngle, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최소 검색 각도"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="최대 각도 (°)" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding MaximumAngle, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최대 검색 각도"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="각도 간격 (°)" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding AngleStep, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="템플릿 각도 간격"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <CheckBox Content="균일 배율(Scale) 검색 · 크기 변화 대응" IsChecked="{Binding EnableScale}" Margin="0,2,0,4"/>
                                    <UniformGrid Columns="3" Margin="0,0,0,6" IsEnabled="{Binding EnableScale}">
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="최소 배율" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding MinimumScale, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최소 배율"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="최대 배율" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding MaximumScale, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최대 배율"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="배율 간격" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding ScaleStep, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="템플릿 배율 간격"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <CheckBox Content="명암 반전 허용 (Ignore Polarity)" IsChecked="{Binding IgnorePolarity}" Margin="0,0,0,8"/>

                                    <TextBlock Text="탐색 · 문맥 정밀도 · 정밀화 (재학습 불필요)" FontWeight="SemiBold" FontSize="11" Margin="0,4,0,4"/>
                                    <UniformGrid Columns="2" Margin="0,0,0,4">
                                        <StackPanel Margin="0,0,6,6">
                                            <TextBlock Text="Greediness (0~1)" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding Greediness, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Greediness 조기 가지치기 강도"
                                                     ToolTip="Halcon식 조기 가지치기 강도(0~1). 0은 무손실 상한, 0.7~0.9는 고속 가지치기입니다."/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="축소 후보 점수 (0~1)" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding CandidateThreshold, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최소 형상 후보 점수"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,6,6">
                                            <TextBlock Text="최소 방향 지지율 (0~1)" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding MinimumSupport, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최소 방향 지지율"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="추가 윤곽 감점 (0~1)" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding ClutterWeight, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="추가 윤곽 감점 비중"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,6,6">
                                            <TextBlock Text="가림 허용 비율 (0~0.5)" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding MaxOcclusionRatio, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="가림 허용 비율"
                                                     ToolTip="기본값 0은 타이트 엄격 모드입니다. 이물질 가림 구출이 필요할 때만 0.35~0.40으로 올리세요."/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="윤곽 허용 거리 (px)" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding ClutterTolerancePixels, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="윤곽 대응 허용 거리"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <CheckBox Content="비대칭 문맥·반전 에지 엄격 검증 (주변 배선/모서리 구분)" IsChecked="{Binding StrictContext}" Margin="0,0,0,4"
                                              ToolTip="주변 배선·비대칭 특징 결손 및 반대편 에지 침범을 엄격히 감점해 인접 중간 핀이나 뒤집힌 모서리 오검출을 차단합니다."/>
                                    <CheckBox Content="Point-to-Tangent 서브픽셀 정밀화 (PatMax식)" IsChecked="{Binding Refine}" Margin="0,0,0,6"
                                              ToolTip="가우스-뉴턴 접선 거리 최소화로 위치·각도·배율을 서브픽셀 단위로 정밀 보정합니다."/>

                                    <Expander Header="윤곽 추출 · 검증 후보 한도 · 회전 합격 고급" IsExpanded="False" Margin="0,2,0,0">
                                        <StackPanel Margin="0,8,0,0">
                                            <UniformGrid Columns="2">
                                                <StackPanel Margin="0,0,6,6">
                                                    <TextBlock Text="최대 특징 수 (12~512)" Style="{StaticResource Caption}"/>
                                                    <TextBox Text="{Binding MaximumFeatures, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최대 학습 특징 수"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,6">
                                                    <TextBlock Text="최소 명암 경사 (>0)" Style="{StaticResource Caption}"/>
                                                    <TextBox Text="{Binding MinimumGradient, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최소 학습 명암 경사"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,6,6">
                                                    <TextBlock Text="특징 최소 대비비 (0~1)" Style="{StaticResource Caption}"/>
                                                    <TextBox Text="{Binding MinimumFeatureContrastRatio, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="특징 최소 대비 비율"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,6">
                                                    <TextBlock Text="템플릿 한도 (1~16384)" Style="{StaticResource Caption}"/>
                                                    <TextBox Text="{Binding MaximumTemplates, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최대 학습 템플릿 수"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,6,6">
                                                    <TextBlock Text="원본 검증 후보 (1~4096)" Style="{StaticResource Caption}"/>
                                                    <TextBox Text="{Binding MaximumVerifiedCandidates, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최대 형상 검증 후보 수"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,6">
                                                    <TextBlock Text="축소 검증 후보 (1~4096)" Style="{StaticResource Caption}"/>
                                                    <TextBox Text="{Binding MaximumCoarseVerifiedCandidates, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최대 축소 형상 검증 후보 수"/>
                                                </StackPanel>
                                            </UniformGrid>
                                            <CheckBox Content="미세 획(OCR) 원본 픽셀 검증 (작은 고정 문자용)" IsChecked="{Binding UseFineDetailValidation}" Margin="0,2,0,6"/>
                                            <CheckBox Content="회전 불량 검사 · 변경 후 재학습" IsChecked="{Binding InspectRotation}" AutomationProperties.Name="회전 불량 검사" Margin="0,0,0,4"/>
                                            <UniformGrid Columns="2" IsEnabled="{Binding InspectRotation}">
                                                <StackPanel Margin="0,0,6,0">
                                                    <TextBlock Text="정상 최소 편차 (°)" Style="{StaticResource Caption}"/>
                                                    <TextBox Text="{Binding MinimumAcceptedAngle, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="정상 최소 회전 편차"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="정상 최대 편차 (°)" Style="{StaticResource Caption}"/>
                                                    <TextBox Text="{Binding MaximumAcceptedAngle, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="정상 최대 회전 편차"/>
                                                </StackPanel>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>

                                <!-- (B) Line2D 방향 응답 / Sub-NCC 전용 페이지 -->
                                <StackPanel Visibility="{Binding IsCpuMethod, Converter={StaticResource BoolVisibility}}">
                                    <TextBlock Text="회전 · 배율 · 피라미드 검색 (재학습 불필요)" FontWeight="SemiBold" FontSize="11" Margin="0,2,0,4"/>
                                    <UniformGrid Columns="3" Margin="0,0,0,6">
                                        <StackPanel Margin="0,0,6,6">
                                            <TextBlock Text="검색각 최소 (°)" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding CpuMinimumAngle, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최소 회전 편차 (학습 ROI 기준 °)"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,6,6">
                                            <TextBlock Text="검색각 최대 (°)" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding CpuMaximumAngle, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최대 회전 편차 (최대 폭 360°)"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="각도 간격 (0.25~30°)" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding CpuAngleStep, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="검색 각도 간격 (0.25~30°)"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,6,6">
                                            <TextBlock Text="최소 배율 (0.5~2)" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding CpuMinimumScale, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최소 배율 (0.5~2)"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,6,6">
                                            <TextBlock Text="최대 배율 (0.5~2)" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding CpuMaximumScale, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="최대 배율 (0.5~2)"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="배율 간격 (0.01~0.5)" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding CpuScaleStep, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="배율 간격 (0.01~0.5)"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <UniformGrid Columns="2" Margin="0,0,0,8">
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="피라미드 단계 (1~5)" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding CpuPyramidLevels, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="피라미드 단계 (1~5)"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="중복 억제 반경 (px)" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding CpuSuppressionRadius, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="중복 억제 반경 (원본 px · 1 이상)"/>
                                        </StackPanel>
                                    </UniformGrid>

                                    <TextBlock Text="학습 특징 · 표본 설정 (변경 후 다시 학습)" FontWeight="SemiBold" FontSize="11" Margin="0,2,0,4"/>
                                    <UniformGrid Columns="2" Visibility="{Binding IsCpuEdgeMethod, Converter={StaticResource BoolVisibility}}">
                                        <StackPanel Margin="0,0,6,4">
                                            <TextBlock Text="축소 특징 수 (16~512)" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding CpuCoarseFeatures, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="축소 특징 수"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,4">
                                            <TextBlock Text="원본 특징 수 (16~512)" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding CpuFineFeatures, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="원본 특징 수"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <UniformGrid Columns="2" Visibility="{Binding IsCpuSubNcc, Converter={StaticResource BoolVisibility}}">
                                        <StackPanel Margin="0,0,6,4">
                                            <TextBlock Text="축소 표본 수 (16~512 짝수)" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding CpuNccCoarseSamples, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Sub-NCC 축소 표본 수"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,4">
                                            <TextBlock Text="학습 최소 명암차 (1~255)" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding CpuNccMinimumContrast, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Sub-NCC 학습 최소 명암차"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>

                                <!-- (C) OpenCV 템플릿 매칭 전용 안내 -->
                                <StackPanel Visibility="{Binding IsTemplateMethod, Converter={StaticResource BoolVisibility}}">
                                    <TextBlock Text="OpenCV 템플릿 매칭은 상단 공통 파라미터(최소 점수, 최대 결과, 중복 허용 비율)만 사용하며, 학습된 각도와 배율을 고정해 평행이동만 고속 검색합니다." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>

                                <!-- (D) PatMax / PatQuick 전용 페이지 -->
                                <StackPanel Visibility="{Binding IsPatMaxMethod, Converter={StaticResource BoolVisibility}}">
                                    <Border BorderBrush="#10B981" BorderThickness="2,0,0,0" Background="{StaticResource Shell}" Padding="8,6" Margin="0,0,0,8">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock Text="실시간 다이폴 · 안정성 행렬(US 6,993,177) 진단" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                                <Button Content="ROI 기준 자동 입도" Command="{Binding PatMaxAutoGranularityCommand}" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right" Padding="8,2" FontSize="11" HorizontalAlignment="Right"
                                                        ToolTip="선택한 ROI 크기에 맞춰 Coarse / Fine Granularity를 자동으로 설정합니다."/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding PatMaxDiagnosticsText}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="실시간 검사 전처리 필터 (파라미터 연동 · 학습/런타임 검사 실제 적용)" FontWeight="SemiBold" FontSize="11" Margin="0,2,0,4"/>
                                    <ComboBox ItemsSource="{Binding PatMaxFilterOptions}" DisplayMemberPath="Name" SelectedValuePath="Kind" SelectedValue="{Binding PatMaxPreprocessingFilter}" AutomationProperties.Name="PatMax 검사 전처리 필터" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding PatMaxFilterDescription}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                    <UniformGrid Columns="2" Margin="0,0,0,8">
                                        <CheckBox Content="ROI 내부 실시간 필터 영상 표시" IsChecked="{Binding PatMaxShowInspectionFilterPreview}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                  ToolTip="파라미터 조정 시 실제 검사 파이프라인에서 사용되는 필터 처리 영상을 ROI 캔버스에 실시간으로 렌더링합니다."/>
                                        <StackPanel Visibility="{Binding PatMaxUsesFilterSigma, Converter={StaticResource BoolVisibility}}">
                                            <TextBlock Text="필터 강도 Sigma (0.1~16)" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding PatMaxFilterSigma, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="PatMax 필터 강도 Sigma"
                                                     ToolTip="Fine Granularity 변경 시 최적 스케일 Sigma가 자동 연동되며 수동 미세 조정도 가능합니다."/>
                                            <Slider Minimum="0.2" Maximum="8.0" SmallChange="0.1" LargeChange="0.5" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding PatMaxFilterSigma, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" AutomationProperties.Name="PatMax 필터 강도 Sigma 슬라이더"/>
                                        </StackPanel>
                                    </UniformGrid>

                                    <TextBlock Text="1단계 · Granularity 피라미드 · 에지 다이폴 · 2D 인력장 (US 6,408,109 / US 7,065,262)" FontWeight="SemiBold" FontSize="11" Margin="0,2,0,4"/>
                                    <UniformGrid Columns="2" Margin="0,0,0,8">
                                        <StackPanel Margin="0,0,6,6">
                                            <TextBlock Text="Coarse Granularity (1~16 · 하늘)" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding PatMaxCoarseGranularity, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="PatMax Coarse Granularity"
                                                     ToolTip="PatQuick 초기 후보 탐색용 거친 스케일 입도 (값이 클수록 프로브 간격이 넓어져 고속 탐색)"/>
                                            <Slider Minimum="1" Maximum="16" SmallChange="1" LargeChange="2" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding PatMaxCoarseGranularity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" AutomationProperties.Name="PatMax Coarse Granularity 슬라이더"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="Fine Granularity (1~16 · 초록)" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding PatMaxFineGranularity, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="PatMax Fine Granularity"
                                                     ToolTip="PatMax 4-Step WLS 서브픽셀 정합용 정밀 스케일 입도 (1 = 원본 서브픽셀 정밀도)"/>
                                            <Slider Minimum="1" Maximum="16" SmallChange="1" LargeChange="2" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding PatMaxFineGranularity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" AutomationProperties.Name="PatMax Fine Granularity 슬라이더"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,6,6">
                                            <TextBlock Text="학습 에지 임계값 (>0)" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding PatMaxEdgeThreshold, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="PatMax 에지 임계값"
                                                     ToolTip="학습 패턴에서 경계 다이폴로 추출할 최소 Sobel 그래디언트 크기"/>
                                            <Slider Minimum="1" Maximum="120" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding PatMaxEdgeThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" AutomationProperties.Name="PatMax 학습 에지 임계값 슬라이더"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="인력장 탄성 반경 Elasticity (px)" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding PatMaxElasticityPixels, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="PatMax 인력장 Elasticity"
                                                     ToolTip="2D 벡터 인력장(Attraction Field)에서 런타임 다이폴을 끌어당기는 허용 편차 반경 (주황 대역으로 즉시 표시)"/>
                                            <Slider Minimum="0.5" Maximum="16.0" SmallChange="0.5" LargeChange="1.0" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding PatMaxElasticityPixels, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" AutomationProperties.Name="PatMax 인력장 Elasticity 슬라이더"/>
                                        </StackPanel>
                                    </UniformGrid>

                                    <TextBlock Text="2단계 · PatQuick 포즈 탐색 · 4-Step WLS 정합 (US 7,016,539 · 재학습 불필요)" FontWeight="SemiBold" FontSize="11" Margin="0,2,0,4"/>
                                    <UniformGrid Columns="2" Margin="0,0,0,6">
                                        <StackPanel Margin="0,0,6,6">
                                            <TextBlock Text="최소 각도 (° · 학습 기준)" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding PatMaxMinAngleDegrees, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="PatMax 최소 각도"/>
                                            <Slider Minimum="-180" Maximum="0" SmallChange="1" LargeChange="15" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding PatMaxMinAngleDegrees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" AutomationProperties.Name="PatMax 최소 각도 슬라이더"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="최대 각도 (° · 학습 기준)" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding PatMaxMaxAngleDegrees, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="PatMax 최대 각도"/>
                                            <Slider Minimum="0" Maximum="180" SmallChange="1" LargeChange="15" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding PatMaxMaxAngleDegrees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" AutomationProperties.Name="PatMax 최대 각도 슬라이더"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <CheckBox Content="배율 변화 허용 (Similarity 4-DOF · 해제 시 1.0x 고정)" IsChecked="{Binding PatMaxEnableScale}" Margin="0,0,0,4"/>
                                    <UniformGrid Columns="2" Margin="0,0,0,6" IsEnabled="{Binding PatMaxEnableScale}">
                                        <StackPanel Margin="0,0,6,6">
                                            <TextBlock Text="최소 배율" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding PatMaxScaleMin, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="PatMax 최소 배율"/>
                                            <Slider Minimum="0.50" Maximum="1.00" SmallChange="0.01" LargeChange="0.05" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding PatMaxScaleMin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" AutomationProperties.Name="PatMax 최소 배율 슬라이더"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="최대 배율" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding PatMaxScaleMax, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="PatMax 최대 배율"/>
                                            <Slider Minimum="1.00" Maximum="2.00" SmallChange="0.01" LargeChange="0.05" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding PatMaxScaleMax, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" AutomationProperties.Name="PatMax 최대 배율 슬라이더"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <UniformGrid Columns="3" Margin="0,0,0,6">
                                        <StackPanel Margin="0,0,6,6">
                                            <TextBlock Text="런타임 에지 임계" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding PatMaxRuntimeEdgeThreshold, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="PatMax 런타임 에지 임계값"
                                                     ToolTip="검사 영상에서 추출할 최소 에지 그래디언트 크기"/>
                                            <Slider Minimum="1" Maximum="120" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding PatMaxRuntimeEdgeThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" AutomationProperties.Name="PatMax 런타임 에지 임계값 슬라이더"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,6,6">
                                            <TextBlock Text="최소 분리 거리 (px)" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding PatMaxMinSeparationPixels, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="PatMax 최소 분리 거리"
                                                     ToolTip="동일 위치 중복 검출 억제를 위한 중심 간 최소 픽셀 거리"/>
                                            <Slider Minimum="2" Maximum="256" SmallChange="2" LargeChange="16" TickFrequency="2" IsSnapToTickEnabled="True" Value="{Binding PatMaxMinSeparationPixels, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" AutomationProperties.Name="PatMax 최소 분리 거리 슬라이더"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="Coarse 후보 (1~64)" Style="{StaticResource Caption}"/>
                                            <TextBox Text="{Binding PatMaxMaxCandidates, Converter={controls:NumericTextConverter}, ValidatesOnExceptions=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="PatMax 최대 후보 수"
                                                     ToolTip="PatQuick에서 추출해 4-Step WLS 정밀 정합으로 넘길 최대 후보 수"/>
                                            <Slider Minimum="1" Maximum="64" SmallChange="1" LargeChange="8" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding PatMaxMaxCandidates, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" AutomationProperties.Name="PatMax 최대 후보 수 슬라이더"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <CheckBox Content="명암 반전 허용 (Ignore Polarity |d_m·d_r|)" IsChecked="{Binding PatMaxIgnorePolarity}" Margin="0,2,0,4"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="결과">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,10">
                            <CheckBox Content="검사 위치 표시" IsChecked="{Binding ShowOverlay}" Margin="0,0,12,8"/>
                            <CheckBox Content="특징점 시각화 (초록/하늘/빨강)" IsChecked="{Binding ShowFeatures}" IsEnabled="{Binding SupportsFeaturePreview}" Margin="0,0,0,8" ToolTip="학습된 윤곽 특징점을 검출된 위치·각도·배율로 변환해 표시합니다. 재검사 없이 켜고 끌 수 있습니다."/>
                        </WrapPanel>
                        <Button Content="검출 위치로 화면 맞춤" Command="{Binding Locate}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,10" ToolTip="검출된 모든 패턴이 보이도록 화면을 이동·확대합니다."/>
                        <TextBlock Text="점선: 검색 범위 / 실선: 검출된 패턴 / 점: 일반(초록)·비대칭키(하늘)·누락(빨강)" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"/>
                        <Expander Header="검사 요약·안내" IsExpanded="False" Margin="0,0,0,8">
                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" Margin="0,6,4,0"/>
                            </ScrollViewer>
                        </Expander>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding ResultRows}" Margin="0,8,0,0" Visibility="{Binding HasResultRows, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="검출 위치와 점수 목록" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" HorizontalContentAlignment="Stretch" Grid.Row="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
            <TabItem Header="로그">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Content="로그 JSON 저장" Click="OnSaveInspectionLog" Margin="0,8,0,8" VerticalAlignment="Top">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Style.Triggers>
                            <DataTrigger Binding="{Binding IsTemplateMethod}" Value="True"><Setter Property="IsEnabled" Value="False"/><Setter Property="ToolTip" Value="OpenCV 검사 시간은 결과 탭에서 확인하세요."/></DataTrigger>
                        </Style.Triggers></Style></Button.Style>
                    </Button>
                    <TextBox Text="{Binding InspectionLogText, Mode=OneWay}" IsReadOnly="True" Height="Auto" TextWrapping="Wrap" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" AutomationProperties.Name="검사 단계별 시간 로그" Grid.Row="1" Style="{x:Null}" VerticalContentAlignment="Top" Padding="8"/>
                </Grid>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="0,12,0,8" Margin="0,8,0,0">
            <StackPanel>
                <Border BorderBrush="{Binding VerdictColor}" BorderThickness="3,0,0,0" Background="{StaticResource Shell}" Padding="10,6">
                    <StackPanel>
                        <TextBlock x:Name="OutcomeTitle" Text="{Binding PanelTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="OutcomeHint" Text="{Binding PanelHint}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" MaxHeight="62" ToolTip="{Binding PanelHint}"/>
                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,6,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
                    </StackPanel>
                </Border>
                <UniformGrid Columns="2" Margin="0,10,0,0">
                    <Button x:Name="SearchButton" Content="검사 실행" Command="{Binding Search}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" ToolTip="학습한 모델로 현재 원본 이미지를 검사합니다. 라이브 영상은 정지하세요."/>
                    <Button Content="취소" Command="{Binding Cancel}" Style="{StaticResource SecondaryButton}"/>
                </UniformGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
