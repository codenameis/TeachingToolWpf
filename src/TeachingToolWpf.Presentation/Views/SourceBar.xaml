<UserControl x:Class="TeachingToolWpf.Views.SourceBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="White" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="14,8">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <Button Command="{Binding Undo}" Tag="{StaticResource UndoIcon}" Style="{StaticResource IconButton}" ToolTip="{Binding UndoHint}" AutomationProperties.Name="실행 취소"/>
                <Button Command="{Binding Redo}" Tag="{StaticResource RedoIcon}" Style="{StaticResource IconButton}" ToolTip="{Binding RedoHint}" AutomationProperties.Name="다시 실행"/>
                <Border Width="1" Background="{StaticResource Stroke}" Margin="10,6"/>
                <Button Content="ROI 추가" Tag="{StaticResource AddIcon}" Style="{StaticResource PrimaryButton}" Command="{Binding AddRoi}" ToolTip="기본 도형은 이미지 중앙에 추가하고, 폴리곤은 꼭짓점 클릭으로 그리기를 시작합니다." Padding="14,0"/>
            </StackPanel>
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="이미지 열기" Tag="{StaticResource OpenIcon}" Command="{Binding OpenImage}" Style="{StaticResource SecondaryButton}" ToolTip="이미지 열기 / 교체 · Ctrl+O" Margin="0,2,8,2"/>
                <Button Content="8K 샘플" Command="{Binding Sample8K}" ToolTip="8,192 × 8,192 검사 이미지" Margin="0,2,6,2"/>
                <Button Content="24K 샘플" Command="{Binding Sample24K}" ToolTip="24,576 × 32,768 대용량 이미지" Margin="0,2,6,2"/>
                <Button Content="패턴 샘플" Command="{Binding PatternSample}" ToolTip="패턴 매칭용 이미지 열기 · 왼쪽 도형 전체를 ROI로 학습하세요." Margin="0,2,6,2"/>
                <Button Content="도형 샘플" Command="{Binding PrimitiveSample}" IsEnabled="{Binding Inspections.IsIdle}" ToolTip="회전된 삼각형·사각형·십자가와 원을 엽니다. 오른쪽 도형 검출을 누르세요." Margin="0,2,6,2"/>
                <Button Content="소량 분류 샘플" Command="{Binding FewShotSample}" IsEnabled="{Binding Inspections.IsIdle}" ToolTip="단일 보드 이미지(1000×560)와 14개 부품 ROI를 엽니다." Margin="0,2,6,2"/>
                <Button Content="7종 검사 샘플" Command="{Binding SuiteSample}" IsEnabled="{Binding Inspections.IsIdle}" ToolTip="현재 선택된 7종 정밀 검사 스위트 알고리즘의 전용 합성 샘플 이미지(1200×800)와 ROI를 즉시 불러오고 실행합니다." Margin="0,2,8,2"/>
                <Border Width="1" Height="22" Background="{StaticResource Stroke}" Margin="4,4,10,4"/>
                <ComboBox ItemsSource="{Binding LiveFormats}" SelectedItem="{Binding LiveFormat}" Width="90" ToolTip="라이브 픽셀 형식" AutomationProperties.Name="라이브 픽셀 형식" Margin="0,2,6,2"/>
                <Button Content="라이브 시작" Tag="{StaticResource PlayIcon}" Command="{Binding StartLive}" ToolTip="7680 × 4320 합성 영상 시작" Margin="0,2,6,2">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsLiveRunning}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
                <Button Content="라이브 정지" Tag="{StaticResource StopIcon}" Command="{Binding StopLive}" Foreground="#14825D" Visibility="{Binding IsLiveRunning, Converter={StaticResource BoolVisibility}}" ToolTip="마지막 프레임을 유지하고 공급을 정지" Margin="0,2,6,2"/>
                <Button Content="읽기 취소" Command="{Binding CancelImport}" Visibility="{Binding Images.IsBusy, Converter={StaticResource BoolVisibility}}" Margin="0,2,6,2"/>
            </WrapPanel>
        </DockPanel>
    </Border>
</UserControl>
