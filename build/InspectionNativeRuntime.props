<Project>
  <PropertyGroup>
    <InspectionNativeRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</InspectionNativeRid>
    <InspectionNativeRid Condition="'$(InspectionNativeRid)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</InspectionNativeRid>
    <InspectionNativeRid Condition="'$(InspectionNativeRid)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</InspectionNativeRid>
  </PropertyGroup>
  <ItemGroup Condition="'$(InspectionNativeRid)' == 'win-x64'">
    <PackageReference Include="OpenCvSharp4.runtime.win.slim" Version="4.13.0.20260627" />
  </ItemGroup>
  <ItemGroup Condition="'$(InspectionNativeRid)' == 'linux-x64'">
    <PackageReference Include="OpenCvSharp4.official.runtime.linux-x64.slim" Version="4.13.0.20260627" />
  </ItemGroup>
  <Target Name="ValidateInspectionNativeRuntime" BeforeTargets="PrepareForBuild"
          Condition="'$(InspectionNativeRid)' != 'win-x64' and '$(InspectionNativeRid)' != 'linux-x64'">
    <Error Text="검사 native 배포 대상은 현재 win-x64 또는 linux-x64입니다. 명시적인 RuntimeIdentifier를 지정하세요." />
  </Target>
</Project>
